+package com.example.harbourferry.booking.domain;
+
+public class BookingExpiry {
+
+    private final BookingArchive bookingArchive;
+
+    public BookingExpiry(BookingArchive bookingArchive) {
+        this.bookingArchive = bookingArchive;
+    }
+
+    public void expireStaleBooking(Booking booking, long daysPassedSinceBookingCreated) {
+        if (daysPassedSinceBookingCreated > 30) {
+            bookingArchive.expire(booking);
+        }
+    }
+}
