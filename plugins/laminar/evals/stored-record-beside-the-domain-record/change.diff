+package com.example.berths.booking.storage;
+
+import com.example.berths.booking.BerthBooking;
+
+public class BerthBookingConverter {
+
+    public BerthBookingEntity toEntity(BerthBooking booking) {
+        return new BerthBookingEntity(booking.vesselName(), booking.berthNumber(), booking.arrivesOn(), booking.leavesOn(), booking.lengthMetres());
+    }
+
+    public BerthBooking toDomain(BerthBookingEntity entity) {
+        return new BerthBooking(entity.getVesselName(), entity.getBerthNumber(), entity.getArrivesOn(), entity.getLeavesOn(), entity.getLengthMetres());
+    }
+}
