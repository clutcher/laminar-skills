+package com.example.berths.booking;
+
+import java.time.LocalDate;
+
+public record BerthBooking(String vesselName, int berthNumber, LocalDate arrivesOn, LocalDate leavesOn, int lengthMetres) {
+
+    public boolean overlaps(BerthBooking other) {
+        return berthNumber == other.berthNumber && !leavesOn.isBefore(other.arrivesOn) && !other.leavesOn.isBefore(arrivesOn);
+    }
+}
