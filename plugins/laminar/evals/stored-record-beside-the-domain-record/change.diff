+package com.example.berths.booking.storage;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+
+import java.time.LocalDate;
+
+@Entity
+@Table(name = "berth_booking")
+public class BerthBookingEntity {
+
+    @Id
+    @GeneratedValue
+    private Long id;
+
+    @Column(name = "vessel_name")
+    private String vesselName;
+
+    @Column(name = "berth_number")
+    private int berthNumber;
+
+    @Column(name = "arrives_on")
+    private LocalDate arrivesOn;
+
+    @Column(name = "leaves_on")
+    private LocalDate leavesOn;
+
+    @Column(name = "length_metres")
+    private int lengthMetres;
+
+    protected BerthBookingEntity() {
+    }
+
+    public BerthBookingEntity(String vesselName, int berthNumber, LocalDate arrivesOn, LocalDate leavesOn, int lengthMetres) {
+        this.vesselName = vesselName;
+        this.berthNumber = berthNumber;
+        this.arrivesOn = arrivesOn;
+        this.leavesOn = leavesOn;
+        this.lengthMetres = lengthMetres;
+    }
+
+    public String getVesselName() { return vesselName; }
+    public int getBerthNumber() { return berthNumber; }
+    public LocalDate getArrivesOn() { return arrivesOn; }
+    public LocalDate getLeavesOn() { return leavesOn; }
+    public int getLengthMetres() { return lengthMetres; }
+}
