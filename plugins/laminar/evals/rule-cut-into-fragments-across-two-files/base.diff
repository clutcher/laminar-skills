@@ -0,0 +1,18 @@
+package com.example.library.loan;
+
+import java.time.LocalDate;
+
+public record Loan(String memberId, String copyBarcode, LocalDate lentOn, LocalDate dueOn, LocalDate returnedOn) {
+
+    public Loan extendedTo(LocalDate newDueOn) {
+        return new Loan(memberId, copyBarcode, lentOn, newDueOn, returnedOn);
+    }
+
+    public Loan returnedOn(LocalDate day) {
+        return new Loan(memberId, copyBarcode, lentOn, dueOn, day);
+    }
+
+    public boolean isLate() {
+        return returnedOn != null && returnedOn.isAfter(dueOn);
+    }
+}
diff --git a/library/src/main/java/com/example/library/loan/LoanDesk.java b/library/src/main/java/com/example/library/loan/LoanDesk.java
new file mode 100644
--- /dev/null
+++ b/library/src/main/java/com/example/library/loan/LoanDesk.java
@@ -0,0 +1,30 @@
+package com.example.library.loan;
+
+import java.time.Clock;
+import java.time.LocalDate;
+
+public class LoanDesk {
+
+    private final MemberDirectory memberDirectory;
+    private final LoanStore loanStore;
+    private final Clock clock;
+
+    public LoanDesk(MemberDirectory memberDirectory, LoanStore loanStore, Clock clock) {
+        this.memberDirectory = memberDirectory;
+        this.loanStore = loanStore;
+        this.clock = clock;
+    }
+
+    public Loan checkout(CirculationSession session, CheckoutRequest request) {
+        Member member = memberDirectory.findByCardNumber(request.getLibraryCardNumber());
+        LoanPeriod period = LoanPeriod.resolve(session, request);
+        LocalDate lentOn = LocalDate.now(clock);
+        return loanStore.save(new Loan(member.id(), request.getCopyBarcode(), lentOn, period.dueDateFrom(lentOn), null));
+    }
+
+    public Loan renew(CirculationSession session, RenewalRequest request) {
+        Loan loan = loanStore.findFirstByCopyBarcodeAndReturnedOnIsNull(request.getCopyBarcode());
+        LoanPeriod period = LoanPeriod.resolve(session, request);
+        return loanStore.save(loan.extendedTo(period.dueDateFrom(LocalDate.now(clock))));
+    }
+}
diff --git a/library/src/main/java/com/example/library/loan/LoanPeriod.java b/library/src/main/java/com/example/library/loan/LoanPeriod.java
new file mode 100644
--- /dev/null
+++ b/library/src/main/java/com/example/library/loan/LoanPeriod.java
@@ -0,0 +1,20 @@
+package com.example.library.loan;
+
+import java.time.LocalDate;
+
+public record LoanPeriod(int days) {
+
+    private static final int STANDARD_DAYS = 21;
+
+    public static LoanPeriod resolve(CirculationSession session, CheckoutRequest request) {
+        return new LoanPeriod(STANDARD_DAYS);
+    }
+
+    public static LoanPeriod resolve(CirculationSession session, RenewalRequest request) {
+        return new LoanPeriod(STANDARD_DAYS);
+    }
+
+    public LocalDate dueDateFrom(LocalDate lentOn) {
+        return lentOn.plusDays(days);
+    }
+}
