--- /dev/null
+++ b/library/src/main/java/com/example/library/loan/ReturnDesk.java
@@ -0,0 +1,24 @@
+package com.example.library.loan;
+
+import java.time.Clock;
+import java.time.LocalDate;
+
+public class ReturnDesk {
+
+    private final LoanStore loanStore;
+    private final LateReturnFines lateReturnFines;
+    private final Clock clock;
+
+    public ReturnDesk(LoanStore loanStore, LateReturnFines lateReturnFines, Clock clock) {
+        this.loanStore = loanStore;
+        this.lateReturnFines = lateReturnFines;
+        this.clock = clock;
+    }
+
+    public void checkIn(String copyBarcode) {
+        Loan loan = loanStore.findFirstByCopyBarcodeAndReturnedOnIsNull(copyBarcode);
+        Loan returned = loan.returnedOn(LocalDate.now(clock));
+        loanStore.save(returned);
+        lateReturnFines.chargeFor(returned);
+    }
+}
