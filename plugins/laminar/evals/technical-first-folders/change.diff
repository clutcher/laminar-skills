+package com.example.website.controllers;
+
+import com.example.website.model.Consignment;
+import com.example.website.services.SplitConsignmentService;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+public class ConsignmentController {
+
+    private final SplitConsignmentService splitConsignmentService;
+
+    public ConsignmentController(SplitConsignmentService splitConsignmentService) {
+        this.splitConsignmentService = splitConsignmentService;
+    }
+
+    @PostMapping("/orders/{orderId}/consignments")
+    public java.util.List<Consignment> splitOrder(@PathVariable Long orderId) {
+        return splitConsignmentService.splitIntoConsignments(orderId);
+    }
+}
