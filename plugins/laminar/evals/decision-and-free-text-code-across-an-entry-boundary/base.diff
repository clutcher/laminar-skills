@@ -0,0 +1,21 @@
+type Query {
+  bikesAtStation(stationId: ID!): [Bike!]!
+}
+
+type Bike {
+  id: ID!
+  serialNumber: String!
+  station: Station!
+}
+
+type Station {
+  id: ID!
+  displayName: String!
+  region: Region!
+}
+
+enum Region {
+  ALPINE
+  COASTAL
+  URBAN
+}
