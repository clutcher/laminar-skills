diff --git a/fleet-api/src/main/java/org/bikes/fleet/web/BikeQueries.java b/fleet-api/src/main/java/org/bikes/fleet/web/BikeQueries.java
new file mode 100644
--- /dev/null
+++ b/fleet-api/src/main/java/org/bikes/fleet/web/BikeQueries.java
@@ -0,0 +1,23 @@
+package org.bikes.fleet.web;
+
+import java.util.List;
+import org.bikes.fleet.bike.Bike;
+import org.bikes.fleet.bike.BikeRegistry;
+import org.springframework.graphql.data.method.annotation.Argument;
+import org.springframework.graphql.data.method.annotation.QueryMapping;
+import org.springframework.stereotype.Controller;
+
+@Controller
+public class BikeQueries {
+
+    private final BikeRegistry bikeRegistry;
+
+    public BikeQueries(BikeRegistry bikeRegistry) {
+        this.bikeRegistry = bikeRegistry;
+    }
+
+    @QueryMapping
+    public List<Bike> bikesAtStation(@Argument String stationId) {
+        return bikeRegistry.bikesAt(stationId);
+    }
+}
