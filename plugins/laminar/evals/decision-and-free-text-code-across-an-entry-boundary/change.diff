diff --git a/rider-web/src/bike/BikeCard.tsx b/rider-web/src/bike/BikeCard.tsx
--- a/rider-web/src/bike/BikeCard.tsx
+++ b/rider-web/src/bike/BikeCard.tsx
@@ -1,10 +1,20 @@
-import { BikeSummary } from "./BikeSummary";
+import { BikeSummary, Region } from "./BikeSummary";
+
+const ALPINE_REGION: Region = "ALPINE";
+const CARGO_FRAME = "C";
 
 export function BikeCard({ bike }: { bike: BikeSummary }) {
+  const shownAccessories = bike.station.region === ALPINE_REGION ? bike.accessories : [];
+  const isCargoBike = bike.frameClass === CARGO_FRAME;
   return (
     <article className="bike-card">
       <h3>{bike.serialNumber}</h3>
       <p>{bike.station.displayName}</p>
+      <p className="battery">{bike.batteryPercent}%</p>
+      {isCargoBike && <p className="cargo-note">Seats for 2 children</p>}
+      <ul className="accessories">
+        {shownAccessories.map(accessory => <li key={accessory.label}>{accessory.label}</li>)}
+      </ul>
     </article>
   );
 }
