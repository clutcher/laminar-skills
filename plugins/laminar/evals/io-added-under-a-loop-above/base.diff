@@ -0,0 +1,20 @@
+package org.riverside.library.notice;
+
+import org.riverside.library.loan.Loan;
+
+import java.time.LocalDate;
+
+public class OverdueNoticeComposer {
+
+    private final LoanLine loanLine;
+
+    public OverdueNoticeComposer(LoanLine loanLine) {
+        this.loanLine = loanLine;
+    }
+
+    public OverdueNotice compose(Loan loan, LocalDate day) {
+        String subject = "Your loan is overdue since " + loan.dueDate();
+        String body = "Please return " + loanLine.describe(loan) + " to any Riverside branch.";
+        return new OverdueNotice(loan.memberEmail(), subject, body);
+    }
+}
diff --git a/src/main/java/org/riverside/library/notice/OverdueNoticeRun.java b/src/main/java/org/riverside/library/notice/OverdueNoticeRun.java
new file mode 100644
index 0000000..de6186d
--- /dev/null
+++ b/src/main/java/org/riverside/library/notice/OverdueNoticeRun.java
@@ -0,0 +1,28 @@
+package org.riverside.library.notice;
+
+import org.riverside.library.loan.Loan;
+import org.riverside.library.loan.LoanRepository;
+
+import java.time.LocalDate;
+import java.util.List;
+
+public class OverdueNoticeRun {
+
+    private final LoanRepository loanRepository;
+    private final OverdueNoticeComposer noticeComposer;
+    private final NoticeMailer noticeMailer;
+
+    public OverdueNoticeRun(LoanRepository loanRepository, OverdueNoticeComposer noticeComposer, NoticeMailer noticeMailer) {
+        this.loanRepository = loanRepository;
+        this.noticeComposer = noticeComposer;
+        this.noticeMailer = noticeMailer;
+    }
+
+    public void runFor(LocalDate day) {
+        List<Loan> overdueLoans = loanRepository.findOverdueOn(day);
+        for (Loan loan : overdueLoans) {
+            OverdueNotice notice = noticeComposer.compose(loan, day);
+            noticeMailer.queue(notice);
+        }
+    }
+}
