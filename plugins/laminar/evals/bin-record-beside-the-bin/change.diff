@@ -0,0 +1,12 @@
+from dataclasses import dataclass
+
+
+@dataclass
+class Bin:
+    code: str
+    aisle: str
+    capacity: int
+    stored_units: int
+
+    def free_units(self) -> int:
+        return self.capacity - self.stored_units
