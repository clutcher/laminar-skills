diff --git a/warehouse/src/warehouse/inventory/stock.py b/warehouse/src/warehouse/inventory/stock.py
new file mode 100644
--- /dev/null
+++ b/warehouse/src/warehouse/inventory/stock.py
@@ -0,0 +1,13 @@
+from warehouse.inventory.bin_store import BinStore
+from warehouse.inventory.models import Bin
+
+
+class StockService:
+    def __init__(self, store: BinStore):
+        self._store = store
+
+    def add_bin(self, code: str, aisle: str, capacity: int, stored_units: int) -> None:
+        self._store.save(Bin(code=code, aisle=aisle, capacity=capacity, stored_units=stored_units))
+
+    def units_in_aisle(self, aisle: str) -> int:
+        return sum(record.stored_units for record in self._store.records_in_aisle(aisle))
