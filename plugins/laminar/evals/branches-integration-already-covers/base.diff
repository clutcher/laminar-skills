@@ -0,0 +1,34 @@
+package com.example.lockerpost.locker.adapter;
+
+import com.example.lockerpost.locker.domain.DestinationZone;
+import com.example.lockerpost.locker.domain.LockerBank;
+import com.example.lockerpost.locker.domain.LockerBankDirectory;
+import com.example.lockerpost.locker.domain.PostalPrefix;
+import org.springframework.stereotype.Component;
+
+import java.util.List;
+import java.util.Map;
+import java.util.function.Function;
+import java.util.stream.Collectors;
+
+@Component
+public class InMemoryLockerBankDirectory implements LockerBankDirectory {
+
+    private static final List<LockerBank> REGISTERED_BANKS = List.of(
+        new LockerBank("LB-CITY-014", new PostalPrefix("10"), DestinationZone.CITY),
+        new LockerBank("LB-CITY-031", new PostalPrefix("31"), DestinationZone.CITY),
+        new LockerBank("LB-CITY-052", new PostalPrefix("12"), DestinationZone.CITY),
+        new LockerBank("LB-CITY-078", new PostalPrefix("78"), DestinationZone.CITY),
+        new LockerBank("LB-SUB-220", new PostalPrefix("22"), DestinationZone.SUBURBAN),
+        new LockerBank("LB-SUB-238", new PostalPrefix("23"), DestinationZone.SUBURBAN),
+        new LockerBank("LB-RUR-470", new PostalPrefix("47"), DestinationZone.RURAL),
+        new LockerBank("LB-RUR-486", new PostalPrefix("48"), DestinationZone.RURAL));
+
+    private static final Map<String, LockerBank> BANKS_BY_ID = REGISTERED_BANKS.stream()
+        .collect(Collectors.toMap(LockerBank::bankId, Function.identity()));
+
+    @Override
+    public LockerBank findBank(String bankId) {
+        return BANKS_BY_ID.get(bankId);
+    }
+}
