@@ -0,0 +1,12 @@
+package com.example.lockerpost.locker.domain;
+
+public record PostalPrefix(String value) {
+
+    private static final String TWO_DIGITS = "\\d{2}";
+
+    public PostalPrefix {
+        if (value == null || !value.matches(TWO_DIGITS)) {
+            throw new IllegalArgumentException("a postal prefix is two digits, not " + value);
+        }
+    }
+}
