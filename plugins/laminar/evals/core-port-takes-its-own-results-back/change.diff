+package com.example.quote.app.services;
+
+import com.example.quote.app.api.QuoteResultMerging;
+import com.example.quote.app.domain.LinePremium;
+import com.example.quote.app.domain.QuoteResult;
+import com.example.quote.app.domain.UnderwritingNotice;
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.Objects;
+import org.springframework.stereotype.Service;
+
+@Service
+public class QuoteResultMergingService implements QuoteResultMerging {
+
+    private final UnderwritingNoticeRules underwritingNoticeRules;
+
+    public QuoteResultMergingService(UnderwritingNoticeRules underwritingNoticeRules) {
+        this.underwritingNoticeRules = underwritingNoticeRules;
+    }
+
+    @Override
+    public BigDecimal totalPremiumOf(List<QuoteResult> lineQuotes) {
+        return lineQuotes.stream()
+                .filter(Objects::nonNull)
+                .map(QuoteResult::totalPremium)
+                .reduce(BigDecimal.ZERO, BigDecimal::add);
+    }
+
+    @Override
+    public List<UnderwritingNotice> noticesOf(List<QuoteResult> lineQuotes) {
+        List<LinePremium> linePremiums = lineQuotes.stream()
+                .filter(Objects::nonNull)
+                .map(lineQuote -> lineQuote.linePremiums().get(0))
+                .toList();
+        return underwritingNoticeRules.noticesFor(linePremiums, totalPremiumOf(lineQuotes));
+    }
+}
