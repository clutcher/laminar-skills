+package com.example.harbour.dues;
+
+public class PortDuesCalculator {
+
+    private static final Money DUES_PER_STARTED_100_TONNES = Money.euros(42);
+    private static final int TONNES_PER_DUES_UNIT = 100;
+
+    // The harbour authority charges port dues per started 100 gross tonnes, as the
+    // Harbour Dues Order sets in its second schedule. So this method takes the gross
+    // tonnage of the vessel, divides it by 100, rounds the result up to a whole
+    // number and multiplies it by the dues for each 100 tonnes before it returns it.
+    public Money calculatePortDues(Vessel vessel) {
+        return DUES_PER_STARTED_100_TONNES.times(Math.ceilDiv(vessel.grossTonnage(), TONNES_PER_DUES_UNIT));
+    }
+}
