+package com.example.shop.payment;
+
+import com.example.shop.order.Order;
+import lombok.RequiredArgsConstructor;
+
+@RequiredArgsConstructor
+public class PaymentService {
+
+    private final CyberSourceClient cybersource;
+    private final PayPalClient paypal;
+
+    public void chargePayment(Order order) {
+        if (order.getPaymentProvider() == PaymentProvider.CYBERSOURCE) {
+            cybersource.createPayment(order.getNumber(), order.getTotal());
+        } else if (order.getPaymentProvider() == PaymentProvider.PAYPAL) {
+            paypal.captureOrder(order.getPaypalOrderId());
+        }
+    }
+}
