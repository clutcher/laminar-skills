@@ -0,0 +1,62 @@
+package org.riversidebikes.rental.in.web;
+
+import org.junit.jupiter.api.Test;
+import org.riversidebikes.rental.app.domain.model.Rental;
+import org.riversidebikes.rental.app.spi.RentalRepository;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.ResultActions;
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders;
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers;
+
+import java.time.LocalDateTime;
+
+@SpringBootTest
+@AutoConfigureMockMvc
+class RentalControllerTest {
+
+    @Autowired
+    private MockMvc mockMvc;
+
+    @Autowired
+    private RentalRepository rentalRepository;
+
+    @Test
+    void shouldMoveReturnTimeWhenExtensionIsWithinLimit() throws Exception {
+        // given
+        rentalRepository.save(new Rental("rental-7", "bike-12", LocalDateTime.of(2026, 6, 1, 14, 0)));
+        String extensionWithinLimitBody = """
+                {"hours": 2}
+                """;
+
+        // when
+        ResultActions response = mockMvc.perform(MockMvcRequestBuilders.post("/rentals/rental-7/extensions")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content(extensionWithinLimitBody));
+
+        // then
+        response.andExpect(MockMvcResultMatchers.status().isOk())
+                .andExpect(MockMvcResultMatchers.jsonPath("$.returnTime").value("2026-06-01T16:00:00"));
+    }
+
+    @Test
+    void shouldRefuseExtensionWhenExtensionIsLongerThanLimit() throws Exception {
+        // given
+        rentalRepository.save(new Rental("rental-8", "bike-3", LocalDateTime.of(2026, 6, 1, 14, 0)));
+        String extensionLongerThanLimitBody = """
+                {"hours": 5}
+                """;
+
+        // when
+        ResultActions response = mockMvc.perform(MockMvcRequestBuilders.post("/rentals/rental-8/extensions")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content(extensionLongerThanLimitBody));
+
+        // then
+        response.andExpect(MockMvcResultMatchers.status().isConflict())
+                .andExpect(MockMvcResultMatchers.content().string("EXTENSION_TOO_LONG"));
+    }
+}
