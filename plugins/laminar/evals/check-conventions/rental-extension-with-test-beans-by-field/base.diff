+package org.riversidebikes.rental.out.storage;
+
+import org.riversidebikes.rental.app.domain.model.Rental;
+import org.riversidebikes.rental.app.spi.RentalRepository;
+import org.springframework.lang.Nullable;
+import org.springframework.stereotype.Repository;
+
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+@Repository
+public class InMemoryRentalRepository implements RentalRepository {
+
+    private final Map<String, Rental> rentalByIdMap = new ConcurrentHashMap<>();
+
+    @Override
+    @Nullable
+    public Rental findById(String rentalId) {
+        return rentalByIdMap.get(rentalId);
+    }
+
+    @Override
+    public void save(Rental rental) {
+        rentalByIdMap.put(rental.rentalId(), rental);
+    }
+}
