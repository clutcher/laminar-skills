+package org.riversidebikes.rental.app.domain.model;
+
+import java.time.Duration;
+import java.time.LocalDateTime;
+
+public record Rental(String rentalId, String bikeId, LocalDateTime returnTime) {
+
+    public Rental extendBy(Duration extension) {
+        return new Rental(rentalId, bikeId, returnTime.plus(extension));
+    }
+}
