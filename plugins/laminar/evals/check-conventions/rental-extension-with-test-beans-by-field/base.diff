+package org.riversidebikes.rental.app.domain.services;
+
+import org.riversidebikes.rental.app.domain.model.Rental;
+import org.riversidebikes.rental.app.domain.model.RentalRefusedException;
+import org.riversidebikes.rental.app.spi.RentalRepository;
+import org.springframework.stereotype.Service;
+
+import java.time.Duration;
+
+@Service
+public class RentalService {
+
+    private final RentalRepository rentalRepository;
+
+    public RentalService(RentalRepository rentalRepository) {
+        this.rentalRepository = rentalRepository;
+    }
+
+    public Rental extendRental(String rentalId, Duration extension) {
+        Rental rental = rentalRepository.findById(rentalId);
+        if (rental == null) {
+            throw new RentalRefusedException(RentalRefusedException.ErrorType.NO_SUCH_RENTAL, rentalId);
+        }
+
+        Rental extendedRental = rental.extendBy(extension);
+        rentalRepository.save(extendedRental);
+        return extendedRental;
+    }
+}
