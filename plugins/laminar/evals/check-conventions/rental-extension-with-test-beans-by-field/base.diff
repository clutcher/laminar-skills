+package org.riversidebikes.rental.app.domain.model;
+
+public class RentalRefusedException extends RuntimeException {
+
+    private final ErrorType errorType;
+
+    public RentalRefusedException(ErrorType errorType, String rentalId) {
+        super(errorType + " for rental " + rentalId);
+        this.errorType = errorType;
+    }
+
+    public ErrorType errorType() {
+        return errorType;
+    }
+
+    public enum ErrorType {
+        NO_SUCH_RENTAL
+    }
+}
