@@ -0,0 +1,49 @@
+package org.citylibrary.lending.loan.app.domain.services;
+
+import org.citylibrary.lending.loan.app.domain.model.Loan;
+import org.citylibrary.lending.loan.app.domain.model.LoanRefusalKind;
+import org.citylibrary.lending.loan.app.domain.model.LoanRefusedException;
+import org.citylibrary.lending.loan.app.domain.model.RenewalReceipt;
+import org.citylibrary.lending.loan.app.spi.LoanRepository;
+import org.citylibrary.lending.loan.app.spi.MemberNotifier;
+import org.springframework.beans.factory.annotation.Qualifier;
+import org.springframework.stereotype.Service;
+
+import java.math.BigDecimal;
+import java.time.Duration;
+import java.time.LocalDate;
+
+@Service
+public class LoanRenewalService {
+
+    private static final Duration RENEWAL_PERIOD = Duration.ofDays(14);
+    private static final BigDecimal RENEWAL_FEE_EUROS = new BigDecimal("0.50");
+
+    private final LoanRepository loanRepository;
+    private final MemberNotifier memberNotifier;
+
+    public LoanRenewalService(LoanRepository loanRepository, @Qualifier("emailMemberNotifier") MemberNotifier memberNotifier) {
+        this.loanRepository = loanRepository;
+        this.memberNotifier = memberNotifier;
+    }
+
+    public RenewalReceipt renewLoan(String copyId) {
+        Loan loan = loanRepository.findActiveByCopyId(copyId)
+                .orElseThrow(() -> new LoanRefusedException(LoanRefusalKind.NO_ACTIVE_LOAN, copyId));
+        if (loan.renewalCount() >= 2) {
+            throw new LoanRefusedException(LoanRefusalKind.RENEWAL_LIMIT_REACHED, copyId);
+        }
+
+        LocalDate newDueDate = loan.dueDate().plusDays(RENEWAL_PERIOD.toDays());
+        Loan renewedLoan = new Loan(
+                loan.loanId(),
+                loan.copyId(),
+                loan.memberId(),
+                newDueDate,
+                loan.renewalCount() + 1);
+        loanRepository.save(renewedLoan);
+
+        memberNotifier.notifyDueDateMoved(loan.memberId(), newDueDate);
+        return new RenewalReceipt(loan.loanId(), newDueDate, RENEWAL_FEE_EUROS);
+    }
+}
