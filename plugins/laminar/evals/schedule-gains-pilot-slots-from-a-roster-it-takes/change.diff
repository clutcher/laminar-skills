+package com.example.marina.berths
+
+class BerthScheduleService(private val harbourMaster: HarbourMaster, private val pilotRoster: PilotRoster) {
+
+    fun schedule(request: BerthRequest): BerthSchedule =
+        addPilotSlots(harbourMaster.scheduleFor(request.harbour), pilotRoster)
+
+    private fun addPilotSlots(schedule: BerthSchedule, roster: PilotRoster): BerthSchedule =
+        schedule.copy(slots = schedule.slots + roster.slotsFor(schedule.harbour))
+}
