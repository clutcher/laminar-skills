 export function HutCard({ hut }: { hut: HutSummary }) {
+  const shownGear = hut.valley.region === ALPINE_REGION ? hut.avalancheGear : [];
   return (
     <article className="hut-card">
       <h3>{hut.name}</h3>
       <p>{hut.valley.displayName}</p>
+      <p className="free-beds">{hut.freeBeds} beds free tonight</p>
+      <ul className="avalanche-gear">
+        {shownGear.map(gearItem => <li key={gearItem.label}>{gearItem.label}</li>)}
+      </ul>
     </article>
   );
 }
