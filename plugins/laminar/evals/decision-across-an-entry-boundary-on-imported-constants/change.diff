diff --git a/hut-api/src/main/java/org/huts/lodge/web/HutFields.java b/hut-api/src/main/java/org/huts/lodge/web/HutFields.java
new file mode 100644
--- /dev/null
+++ b/hut-api/src/main/java/org/huts/lodge/web/HutFields.java
@@ -0,0 +1,32 @@
+package org.huts.lodge.web;
+
+import java.util.List;
+import org.huts.lodge.hut.GearItem;
+import org.huts.lodge.hut.GearStore;
+import org.huts.lodge.hut.Hut;
+import org.huts.lodge.hut.LodgeConstants;
+import org.springframework.graphql.data.method.annotation.SchemaMapping;
+import org.springframework.stereotype.Controller;
+
+@Controller
+public class HutFields {
+
+    private final GearStore gearStore;
+
+    public HutFields(GearStore gearStore) {
+        this.gearStore = gearStore;
+    }
+
+    @SchemaMapping(typeName = "Hut")
+    public List<GearItem> avalancheGear(Hut hut) {
+        if (hut.valley().region() != LodgeConstants.AVALANCHE_GEAR_REGION) {
+            return List.of();
+        }
+        return gearStore.getGearItemsForHut(hut.id());
+    }
+
+    @SchemaMapping(typeName = "Hut")
+    public int freeBeds(Hut hut) {
+        return hut.bedsLeftTonight();
+    }
+}
