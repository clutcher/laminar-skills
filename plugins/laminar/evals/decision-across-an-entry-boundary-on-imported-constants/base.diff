+++ b/hut-api/src/main/resources/graphql/lodge.graphqls
@@ -0,0 +1,21 @@
+type Query {
+  hutsInValley(valleyId: ID!): [Hut!]!
+}
+
+type Hut {
+  id: ID!
+  name: String!
+  valley: Valley!
+}
+
+type Valley {
+  id: ID!
+  displayName: String!
+  region: Region!
+}
+
+enum Region {
+  ALPINE
+  LAKELAND
+  FOREST
+}
