diff --git a/hotel-web/src/rooms/room-availability.service.ts b/hotel-web/src/rooms/room-availability.service.ts
new file mode 100644
--- /dev/null
+++ b/hotel-web/src/rooms/room-availability.service.ts
@@ -0,0 +1,27 @@
+import { Room, RoomInventory } from "./room-inventory";
+import { RoomSearchInput } from "./room-search-input";
+
+export class RoomAvailabilityService {
+  constructor(private readonly inventory: RoomInventory) {}
+
+  freeRooms(input: RoomSearchInput): Room[] {
+    return this.inventory.roomsFreeBetween(input.hotelId, input.arrivalDate, input.departureDate);
+  }
+
+  roomTypesOnOffer(input: RoomSearchInput): string[] {
+    const roomTypes = this.freeRooms(input).map(room => room.roomType);
+    return [...new Set(roomTypes)];
+  }
+
+  accessibleRooms(input: RoomSearchInput): Room[] {
+    return this.freeRooms(input).filter(room => room.stepFree);
+  }
+
+  nightlyPrices(input: RoomSearchInput): Map<string, number> {
+    const prices = new Map<string, number>();
+    for (const room of this.freeRooms(input)) {
+      prices.set(room.roomNumber, room.baseNightlyPrice);
+    }
+    return prices;
+  }
+}
