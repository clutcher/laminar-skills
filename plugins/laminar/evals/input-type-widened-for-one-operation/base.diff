+++ b/hotel-web/src/booking/stay-search.page.ts
@@ -0,0 +1,35 @@
+import { RoomAvailabilityService } from "../rooms/room-availability.service";
+import { Room } from "../rooms/room-inventory";
+import { RatePlanService } from "../rates/rate-plan.service";
+import { RatePlan } from "../rates/rate-table";
+
+export interface StaySearchForm {
+  hotelId: string;
+  arrivalDate: string;
+  departureDate: string;
+  guestCount: number;
+  loyaltyTier: string;
+}
+
+export interface StayOffer {
+  freeRooms: Room[];
+  nightlyPrices: Map<string, number>;
+  ratePlans: RatePlan[];
+}
+
+export class StaySearchPage {
+  constructor(
+    private readonly rooms: RoomAvailabilityService,
+    private readonly rates: RatePlanService,
+  ) {}
+
+  search(form: StaySearchForm): StayOffer {
+    const stayDates = { hotelId: form.hotelId, arrivalDate: form.arrivalDate, departureDate: form.departureDate };
+    const guests = { hotelId: form.hotelId, guestCount: form.guestCount, loyaltyTier: form.loyaltyTier };
+    return {
+      freeRooms: this.rooms.freeRooms(stayDates),
+      nightlyPrices: this.rooms.nightlyPrices(stayDates),
+      ratePlans: this.rates.ratePlans(guests),
+    };
+  }
+}
