--- /dev/null
+++ b/hotel-web/src/rates/rate-plan.service.ts
@@ -0,0 +1,12 @@
+import { RatePlanInput } from "./rate-plan-input";
+import { RatePlan, RateTable } from "./rate-table";
+
+export class RatePlanService {
+  constructor(private readonly rateTable: RateTable) {}
+
+  ratePlans(input: RatePlanInput): RatePlan[] {
+    return this.rateTable
+      .plansFor(input.hotelId, input.guestCount)
+      .filter(plan => plan.loyaltyTiers.includes(input.loyaltyTier));
+  }
+}
