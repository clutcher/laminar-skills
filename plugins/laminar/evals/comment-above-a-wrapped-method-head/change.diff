+package com.example.harbour.berth;
+
+import java.util.List;
+
+public class BerthFinder {
+
+    private final BerthRegister berthRegister;
+
+    public BerthFinder(BerthRegister berthRegister) {
+        this.berthRegister = berthRegister;
+    }
+
+    // Leaves out every berth that is not free on each day of the stay,
+    // and keeps only the berths long enough for the vessel.
+    public List<Berth> findBerths(
+        Vessel vessel, Stay stay
+    ) {
+        return berthRegister.berths().stream()
+            .filter(berth -> berth.isFreeThroughout(stay))
+            .filter(berth -> berth.fits(vessel))
+            .toList();
+    }
+}
