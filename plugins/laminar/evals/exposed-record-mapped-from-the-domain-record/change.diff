+package com.example.apiary.hives.in.modules;
+
+import com.example.apiary.hives.app.domain.model.HoneyHarvest;
+import com.example.apiary.hives.app.spi.HarvestStore;
+
+import java.util.List;
+
+public class HarvestLookup {
+
+    private final HarvestStore harvestStore;
+
+    public HarvestLookup(HarvestStore harvestStore) {
+        this.harvestStore = harvestStore;
+    }
+
+    public List<PublicHoneyHarvest> harvestsOfHive(String hiveCode) {
+        return harvestStore.harvestsOfHive(hiveCode).stream()
+                .map(this::toPublicHarvest)
+                .toList();
+    }
+
+    public void recordHarvest(PublicHoneyHarvest harvest) {
+        harvestStore.save(toHoneyHarvest(harvest));
+    }
+
+    private PublicHoneyHarvest toPublicHarvest(HoneyHarvest harvest) {
+        return new PublicHoneyHarvest(harvest.hiveCode(), harvest.harvestedOn(), harvest.jarCount(), harvest.flowerSource());
+    }
+
+    private HoneyHarvest toHoneyHarvest(PublicHoneyHarvest harvest) {
+        return new HoneyHarvest(harvest.hiveCode(), harvest.harvestedOn(), harvest.jarCount(), harvest.flowerSource());
+    }
+}
