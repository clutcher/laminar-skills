+package com.example.apiary.shop.out.modules;
+
+import com.example.apiary.hives.in.modules.HarvestLookup;
+import com.example.apiary.hives.in.modules.PublicHoneyHarvest;
+import com.example.apiary.shop.app.domain.model.JarBatch;
+import com.example.apiary.shop.app.spi.HarvestsForSale;
+
+import java.util.List;
+
+public class HarvestsForSaleUsingHivesModule implements HarvestsForSale {
+
+    private final HarvestLookup harvestLookup;
+
+    public HarvestsForSaleUsingHivesModule(HarvestLookup harvestLookup) {
+        this.harvestLookup = harvestLookup;
+    }
+
+    @Override
+    public List<JarBatch> batchesOfHive(String hiveCode) {
+        return harvestLookup.harvestsOfHive(hiveCode).stream()
+                .map(this::toJarBatch)
+                .toList();
+    }
+
+    private JarBatch toJarBatch(PublicHoneyHarvest harvest) {
+        return new JarBatch(harvest.hiveCode(), harvest.jarCount());
+    }
+}
