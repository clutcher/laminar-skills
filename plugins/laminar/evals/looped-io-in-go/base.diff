+package timetable
+
+import "sync"
+
+type FareTable struct {
+	mu            sync.RWMutex
+	pencePerRoute map[string]int
+}
+
+func NewFareTable(pencePerRoute map[string]int) *FareTable {
+	return &FareTable{pencePerRoute: pencePerRoute}
+}
+
+func (t *FareTable) Get(route string) (int, bool) {
+	t.mu.RLock()
+	defer t.mu.RUnlock()
+	pence, found := t.pencePerRoute[route]
+	return pence, found
+}
