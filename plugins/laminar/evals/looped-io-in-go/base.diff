@@ -0,0 +1,22 @@
+package timetable
+
+import (
+	"context"
+	"fmt"
+)
+
+type Timetable struct {
+	sailings  SailingStore
+	fareCache *FareTable
+}
+
+func NewTimetable(sailings SailingStore, fareCache *FareTable) *Timetable {
+	return &Timetable{sailings: sailings, fareCache: fareCache}
+}
+
+func (t *Timetable) PublishSailing(ctx context.Context, f Ferry) error {
+	if err := t.sailings.Open(ctx, f.ID, f.Route, f.Capacity); err != nil {
+		return fmt.Errorf("open sailing of ferry %s on route %s: %w", f.ID, f.Route, err)
+	}
+	return nil
+}
