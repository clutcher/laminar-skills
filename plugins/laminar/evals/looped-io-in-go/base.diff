@@ -0,0 +1,22 @@
+package timetable
+
+import (
+	"context"
+	"database/sql"
+)
+
+type SailingStore interface {
+	Open(ctx context.Context, ferryID string, route string, seats int) error
+}
+
+type sqlSailingStore struct {
+	db *sql.DB
+}
+
+func NewSailingStore(db *sql.DB) SailingStore {
+	return &sqlSailingStore{db: db}
+}
+
+func (s *sqlSailingStore) Open(ctx context.Context, ferryID string, route string, seats int) error {
+	return s.db.QueryRowContext(ctx, "UPDATE sailings SET open = true, seats_left = $3 WHERE ferry_id = $1 AND route = $2 RETURNING id", ferryID, route, seats).Err()
+}
