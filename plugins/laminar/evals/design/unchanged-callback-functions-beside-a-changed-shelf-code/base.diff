+++ b/src/shelf/shelfLabels.ts
@@ -0,0 +1,21 @@
+import type { Book, Shelf, ShelfParts, ShelfStatus } from './shelfTypes';
+
+export function toShelfParts(book: Book, labelOf: (status: ShelfStatus) => string | null): ShelfParts {
+  return { title: book.title, shelfCode: formatShelfCode(book.shelf), statusLabel: labelOf(book.status) };
+}
+
+export const toUniqueStatusShelfParts = (
+  books: Book[],
+  statusLabelOf: (status: ShelfStatus) => string | null,
+): ShelfParts[] => {
+  const shownLabels = new Set<string>();
+  return books.map((book) => {
+    const parts = toShelfParts(book, statusLabelOf);
+    if (parts.statusLabel === null) return parts;
+    if (shownLabels.has(parts.statusLabel)) return { ...parts, statusLabel: null };
+    shownLabels.add(parts.statusLabel);
+    return parts;
+  });
+};
+
+export const formatShelfCode = (shelf: Shelf): string => `${shelf.aisle}-${shelf.row}`;
