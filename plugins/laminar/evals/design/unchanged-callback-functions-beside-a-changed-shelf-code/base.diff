+export enum ShelfStatus {
+  OnShelf = 'ON_SHELF',
+  OnLoan = 'ON_LOAN',
+  InRepair = 'IN_REPAIR',
+}
+
+export interface Shelf {
+  aisle: string;
+  row: number;
+}
+
+export interface Book {
+  title: string;
+  shelf: Shelf;
+  status: ShelfStatus;
+}
+
+export interface ShelfParts {
+  title: string;
+  shelfCode: string;
+  statusLabel: string | null;
+}
