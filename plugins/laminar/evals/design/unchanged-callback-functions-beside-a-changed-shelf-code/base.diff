+import { describe, expect, it } from 'vitest';
+
+import { formatShelfCode, toUniqueStatusShelfParts } from './shelfLabels';
+import { ShelfStatus } from './shelfTypes';
+
+const labelOfLoanOnly = (status: ShelfStatus): string | null => (status === ShelfStatus.OnLoan ? 'On loan' : null);
+
+describe('shelfLabels', () => {
+  it('shouldShowEachStatusLabelOnceWhenTwoBooksShareTheStatus', () => {
+    // given
+    const books = [
+      { title: 'Tides', shelf: { aisle: 'B', row: 3 }, status: ShelfStatus.OnLoan },
+      { title: 'Harbours', shelf: { aisle: 'B', row: 4 }, status: ShelfStatus.OnLoan },
+    ];
+
+    // when
+    const parts = toUniqueStatusShelfParts(books, labelOfLoanOnly);
+
+    // then
+    expect(parts.map((part) => part.statusLabel)).toEqual(['On loan', null]);
+  });
+
+  it('shouldJoinTheAisleAndTheRowWhenTheShelfIsFormatted', () => {
+    // when
+    const shelfCode = formatShelfCode({ aisle: 'B', row: 3 });
+
+    // then
+    expect(shelfCode).toBe('B-3');
+  });
+});
diff --git a/src/shelf/shelfLabels.ts b/src/shelf/shelfLabels.ts
