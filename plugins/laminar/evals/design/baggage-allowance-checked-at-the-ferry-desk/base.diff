diff --git a/src/main/java/com/example/ferry/checkin/CheckInDesk.java b/src/main/java/com/example/ferry/checkin/CheckInDesk.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/com/example/ferry/checkin/CheckInDesk.java
@@ -0,0 +1,18 @@
+package com.example.ferry.checkin;
+
+import com.example.ferry.boarding.BoardingPass;
+
+public class CheckInDesk {
+
+    private final BookingRepository bookings;
+
+    public CheckInDesk(BookingRepository bookings) {
+        this.bookings = bookings;
+    }
+
+    public BoardingPass checkIn(String bookingId) {
+        Booking booking = bookings.findBooking(bookingId);
+
+        return new BoardingPass(booking.bookingId(), booking.passengerName(), booking.sailingId(), booking.fareClass());
+    }
+}
