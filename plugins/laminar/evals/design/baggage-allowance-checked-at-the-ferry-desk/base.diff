diff --git a/src/main/java/com/example/ferry/boarding/BoardingPass.java b/src/main/java/com/example/ferry/boarding/BoardingPass.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/com/example/ferry/boarding/BoardingPass.java
@@ -0,0 +1,13 @@
+package com.example.ferry.boarding;
+
+import com.example.ferry.fare.FareClass;
+import java.util.Map;
+
+public record BoardingPass(String bookingId, String passengerName, String sailingId, FareClass fareClass) {
+
+    private static final Map<FareClass, Integer> BAGGAGE_KILOS_BY_FARE_CLASS = Map.of(FareClass.ECONOMY, 23, FareClass.FLEX, 32);
+
+    public String describeAllowance() {
+        return "Baggage allowance: " + BAGGAGE_KILOS_BY_FARE_CLASS.get(fareClass) + " kg";
+    }
+}
