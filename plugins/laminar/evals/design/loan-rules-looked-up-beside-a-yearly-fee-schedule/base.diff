+package org.example.library.loan.app.domain;
+
+import org.example.library.loan.app.api.ApiForLending;
+import org.example.library.loan.app.api.ItemNotFoundException;
+import org.example.library.loan.app.domain.model.Item;
+import org.example.library.loan.app.domain.model.Loan;
+import org.example.library.loan.app.domain.model.LoanRule;
+import org.example.library.loan.app.spi.ItemRepository;
+import org.example.library.loan.app.spi.LoanRepository;
+
+import java.time.LocalDate;
+import java.util.UUID;
+
+public class LoanDesk implements ApiForLending {
+
+    private static final LoanRule STANDARD_RULE = new LoanRule("standard", 21, 2);
+
+    private final ItemRepository itemRepository;
+
+    private final LoanRepository loanRepository;
+
+    public LoanDesk(ItemRepository itemRepository, LoanRepository loanRepository) {
+        this.itemRepository = itemRepository;
+        this.loanRepository = loanRepository;
+    }
+
+    @Override
+    public Loan lend(String memberId, String itemId, LocalDate lentOn) {
+        Item item = itemRepository.findItem(itemId);
+        if (item == null) {
+            throw new ItemNotFoundException(itemId);
+        }
+
+        Loan loan = new Loan(UUID.randomUUID().toString(), memberId, item.itemId(), lentOn, lentOn.plusDays(STANDARD_RULE.loanDays()), 0);
+        loanRepository.save(loan);
+        return loan;
+    }
+}
