diff --git a/src/main/java/org/example/library/loan/out/memory/ItemRepositoryUsingMemory.java b/src/main/java/org/example/library/loan/out/memory/ItemRepositoryUsingMemory.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/org/example/library/loan/out/memory/ItemRepositoryUsingMemory.java
@@ -0,0 +1,23 @@
+package org.example.library.loan.out.memory;
+
+import org.example.library.loan.app.domain.model.Item;
+import org.example.library.loan.app.spi.ItemRepository;
+import org.springframework.stereotype.Repository;
+
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+@Repository
+public class ItemRepositoryUsingMemory implements ItemRepository {
+
+    private final Map<String, Item> itemByIdMap = new ConcurrentHashMap<>();
+
+    @Override
+    public Item findItem(String itemId) {
+        return itemByIdMap.get(itemId);
+    }
+
+    public void save(Item item) {
+        itemByIdMap.put(item.itemId(), item);
+    }
+}
