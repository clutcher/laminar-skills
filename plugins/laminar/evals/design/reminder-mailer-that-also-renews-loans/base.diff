diff --git a/vendor/postbox/src/main/java/org/example/postbox/ScheduledTask.java b/vendor/postbox/src/main/java/org/example/postbox/ScheduledTask.java
new file mode 100644
--- /dev/null
+++ b/vendor/postbox/src/main/java/org/example/postbox/ScheduledTask.java
@@ -0,0 +1,24 @@
+package org.example.postbox;
+
+public abstract class ScheduledTask {
+
+    private final String taskName;
+
+    private final String cronExpression;
+
+    protected ScheduledTask(String taskName, String cronExpression) {
+        this.taskName = taskName;
+        this.cronExpression = cronExpression;
+        TaskRegistry.register(taskName, this);
+    }
+
+    public String getTaskName() {
+        return taskName;
+    }
+
+    public String getCronExpression() {
+        return cronExpression;
+    }
+
+    public abstract void runOnce();
+}
diff --git a/vendor/postbox/src/main/java/org/example/postbox/TaskRegistry.java b/vendor/postbox/src/main/java/org/example/postbox/TaskRegistry.java
new file mode 100644
--- /dev/null
+++ b/vendor/postbox/src/main/java/org/example/postbox/TaskRegistry.java
@@ -0,0 +1,16 @@
+package org.example.postbox;
+
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+final class TaskRegistry {
+
+    private static final Map<String, ScheduledTask> TASK_BY_NAME_MAP = new ConcurrentHashMap<>();
+
+    private TaskRegistry() {
+    }
+
+    static void register(String taskName, ScheduledTask task) {
+        TASK_BY_NAME_MAP.put(taskName, task);
+    }
+}
