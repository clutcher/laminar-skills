@@ -0,0 +1,22 @@
+package org.example.library.loan;
+
+public class LoanDesk {
+
+    private static final int RENEWAL_DAYS = 14;
+
+    private final LoanRepository loans;
+
+    public LoanDesk(LoanRepository loans) {
+        this.loans = loans;
+    }
+
+    public Loan renew(Loan loan) {
+        if (loan.onHold()) {
+            throw new LoanOnHoldException(loan.loanId());
+        }
+
+        Loan renewed = loan.withDueDate(loan.dueDate().plusDays(RENEWAL_DAYS));
+        loans.save(renewed);
+        return renewed;
+    }
+}
