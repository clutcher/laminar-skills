--- /dev/null
+++ b/vendor/postbox/src/main/java/org/example/postbox/PostboxClient.java
@@ -0,0 +1,21 @@
+package org.example.postbox;
+
+import java.time.Instant;
+import java.util.List;
+
+public class PostboxClient {
+
+    private static final int MOST_RECIPIENTS_PER_CALL = 50;
+
+    public DeliveryReceipt send(List<String> recipients, String subject, String body) {
+        if (recipients.size() > MOST_RECIPIENTS_PER_CALL) {
+            throw new RecipientLimitExceeded(recipients.size(), MOST_RECIPIENTS_PER_CALL);
+        }
+
+        return new DeliveryReceipt(Instant.now().getEpochSecond());
+    }
+
+    public DeliveryReceipt sendWithAttachment(List<String> recipients, String subject, String body, byte[] attachment) {
+        throw new EditionFeatureMissing("sendWithAttachment");
+    }
+}
