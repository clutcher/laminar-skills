+package com.example.clinic.appointment;
+
+import java.math.BigDecimal;
+import java.util.Map;
+
+public class FeeSchedule {
+
+    private final Map<VisitType, BigDecimal> amountByVisitTypeMap;
+
+    public FeeSchedule(Map<VisitType, BigDecimal> amountByVisitTypeMap) {
+        this.amountByVisitTypeMap = Map.copyOf(amountByVisitTypeMap);
+    }
+
+    public VisitFee findFeeOf(VisitType visitType) {
+        return new VisitFee(visitType, amountByVisitTypeMap.get(visitType));
+    }
+}
