new file mode 100644
--- /dev/null
+++ b/src/main/java/com/example/clinic/billing/InvoiceService.java
@@ -0,0 +1,20 @@
+package com.example.clinic.billing;
+
+import com.example.clinic.appointment.Appointment;
+import java.math.BigDecimal;
+import java.util.List;
+
+public class InvoiceService {
+
+    private final FeeSchedule feeSchedule;
+
+    public InvoiceService(FeeSchedule feeSchedule) {
+        this.feeSchedule = feeSchedule;
+    }
+
+    public Invoice createInvoice(String invoiceId, String patientId, List<Appointment> visits) {
+        List<VisitFee> fees = visits.stream().map(visit -> feeSchedule.findFeeOf(visit.visitType())).toList();
+        BigDecimal total = fees.stream().map(VisitFee::amount).reduce(BigDecimal.ZERO, BigDecimal::add);
+        return new Invoice(invoiceId, patientId, fees, total);
+    }
+}
