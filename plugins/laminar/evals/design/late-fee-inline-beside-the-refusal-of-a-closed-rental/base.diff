+package org.example.bikerental.rental;
+
+import java.time.Instant;
+
+public class ReturnDesk {
+
+    private final RentalStore rentalStore;
+
+    public ReturnDesk(RentalStore rentalStore) {
+        this.rentalStore = rentalStore;
+    }
+
+    public ReturnReceipt closeRental(String rentalId, Instant returnedAt) {
+        Rental rental = rentalStore.findRental(rentalId);
+        if (rental == null) {
+            throw new RentalNotFoundException(rentalId);
+        }
+        if (rental.isClosed()) {
+            throw new RentalAlreadyClosedException(rentalId);
+        }
+
+        rentalStore.saveRental(rental.closeAt(returnedAt));
+        return new ReturnReceipt(rental.id(), rental.bikeId(), returnedAt);
+    }
+}
