+package org.example.bikerental.rental;
+
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+
+import java.time.Instant;
+
+class ReturnDeskTest {
+
+    private static final Instant DUE_AT = Instant.parse("2026-06-01T10:00:00Z");
+
+    private final InMemoryRentalStore rentalStore = new InMemoryRentalStore();
+    private final ReturnDesk returnDesk = new ReturnDesk(rentalStore);
+
+    @Test
+    void shouldCloseTheRentalWhenTheRentalIsOpen() {
+        rentalStore.saveRental(new Rental("rental-1", "bike-7", "rider-3", DUE_AT, null));
+
+        ReturnReceipt receipt = returnDesk.closeRental("rental-1", DUE_AT);
+
+        Assertions.assertEquals("bike-7", receipt.bikeId());
+        Assertions.assertTrue(rentalStore.findRental("rental-1").isClosed());
+    }
+
+    @Test
+    void shouldRefuseTheReturnWhenTheRentalIsAlreadyClosed() {
+        Instant closedAt = DUE_AT.minusSeconds(600);
+        rentalStore.saveRental(new Rental("rental-1", "bike-7", "rider-3", DUE_AT, closedAt));
+
+        Assertions.assertThrows(RentalAlreadyClosedException.class, () -> returnDesk.closeRental("rental-1", DUE_AT));
+    }
+
+    @Test
+    void shouldRefuseTheReturnWhenNoRentalHasTheId() {
+        Assertions.assertThrows(RentalNotFoundException.class, () -> returnDesk.closeRental("rental-9", DUE_AT));
+    }
+}
