@@ -0,0 +1,22 @@
+package org.example.bikerental.rental;
+
+import org.springframework.lang.Nullable;
+
+import java.util.HashMap;
+import java.util.Map;
+
+class InMemoryRentalStore implements RentalStore {
+
+    private final Map<String, Rental> rentalByIdMap = new HashMap<>();
+
+    @Nullable
+    @Override
+    public Rental findRental(String rentalId) {
+        return rentalByIdMap.get(rentalId);
+    }
+
+    @Override
+    public void saveRental(Rental rental) {
+        rentalByIdMap.put(rental.id(), rental);
+    }
+}
