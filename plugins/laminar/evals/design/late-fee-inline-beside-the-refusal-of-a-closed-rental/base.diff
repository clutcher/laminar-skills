+package org.example.bikerental.web;
+
+import org.example.bikerental.rental.RentalAlreadyClosedException;
+import org.example.bikerental.rental.RentalNotFoundException;
+import org.example.bikerental.rental.ReturnDesk;
+import org.example.bikerental.rental.ReturnReceipt;
+import org.example.bikerental.web.response.ErrorResponse;
+import org.example.bikerental.web.response.ReturnResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import java.time.Clock;
+
+@RestController
+public class ReturnDeskRestController {
+
+    private final ReturnDesk returnDesk;
+    private final Clock clock;
+
+    public ReturnDeskRestController(ReturnDesk returnDesk, Clock clock) {
+        this.returnDesk = returnDesk;
+        this.clock = clock;
+    }
+
+    @PostMapping("/rentals/{rentalId}/return")
+    public ReturnResponse closeRental(@PathVariable String rentalId) {
+        ReturnReceipt receipt = returnDesk.closeRental(rentalId, clock.instant());
+        return new ReturnResponse(receipt.rentalId(), receipt.bikeId(), receipt.returnedAt());
+    }
+
+    @ExceptionHandler(RentalNotFoundException.class)
+    @ResponseStatus(HttpStatus.NOT_FOUND)
+    public ErrorResponse answerUnknownRental(RentalNotFoundException exception) {
+        return new ErrorResponse(exception.getMessage());
+    }
+
+    @ExceptionHandler(RentalAlreadyClosedException.class)
+    @ResponseStatus(HttpStatus.CONFLICT)
+    public ErrorResponse answerClosedRental(RentalAlreadyClosedException exception) {
+        return new ErrorResponse(exception.getMessage());
+    }
+}
