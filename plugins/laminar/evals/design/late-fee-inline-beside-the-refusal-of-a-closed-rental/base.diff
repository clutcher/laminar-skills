+package org.example.bikerental.web;
+
+import org.example.bikerental.rental.RentalAlreadyClosedException;
+import org.example.bikerental.rental.ReturnDesk;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentMatchers;
+import org.mockito.Mockito;
+import org.springframework.boot.test.autoconfigure.web.servlet.WebMvcTest;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders;
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers;
+
+import java.time.Clock;
+import java.time.Instant;
+
+@WebMvcTest(ReturnDeskRestController.class)
+class ReturnDeskRestControllerTest {
+
+    private final MockMvc mockMvc;
+
+    @MockitoBean
+    private ReturnDesk returnDesk;
+
+    @MockitoBean
+    private Clock clock;
+
+    ReturnDeskRestControllerTest(MockMvc mockMvc) {
+        this.mockMvc = mockMvc;
+    }
+
+    @Test
+    void shouldAnswerConflictWhenTheRentalIsAlreadyClosed() throws Exception {
+        Instant now = Instant.parse("2026-06-01T10:30:00Z");
+        Mockito.when(clock.instant()).thenReturn(now);
+        Mockito.when(returnDesk.closeRental(ArgumentMatchers.eq("rental-1"), ArgumentMatchers.eq(now)))
+                .thenThrow(new RentalAlreadyClosedException("rental-1"));
+
+        mockMvc.perform(MockMvcRequestBuilders.post("/rentals/rental-1/return"))
+                .andExpect(MockMvcResultMatchers.status().isConflict())
+                .andExpect(MockMvcResultMatchers.jsonPath("$.message").value("The rental rental-1 is already closed"));
+    }
+}
