      "methods": [
        {
          "visibility": "public",
          "name": "placeHold",
          "parameters": [
            {
              "name": "memberId",
              "type": "string"
            },
            {
              "name": "isbn",
              "type": "string"
            }
          ],
          "returns": "Promise<CommandAnswer>",
          "uses": [
            "holdDesk",
            "isMissing",
            "answerFailure"
          ],
          "calls": [
            "CommandAnswer#refuseRequest",
            "HoldDesk#placeHold",
            "CommandAnswer#place"
          ],
          "body": "if (this.isMissing(memberId) || this.isMissing(isbn)) return CommandAnswer.refuseRequest(\"a member id and an isbn are required\");\n\ntry {\n  return CommandAnswer.place(await this.holdDesk.placeHold(memberId, isbn));\n} catch (failure) {\n  return this.answerFailure(failure);\n}"
        },
        {
          "visibility": "private",
          "name": "isMissing",
          "parameters": [
            {
              "name": "text",
              "type": "string"
            }
          ],
          "returns": "boolean"
        },
        {
          "visibility": "private",
          "name": "answerFailure",
          "parameters": [
            {
              "name": "failure",
              "type": "Error"
            }
          ],
          "returns": "CommandAnswer",
          "calls": [
            "CatalogueUnavailable",
            "CommandAnswer#reportUnavailable",
            "UnknownMember",
            "HoldLimitReached",
            "UnknownTitle",
            "CommandAnswer#refuseHold"
          ],
          "body": "if (failure instanceof CatalogueUnavailable) return CommandAnswer.reportUnavailable(failure);\nif (failure instanceof UnknownMember || failure instanceof HoldLimitReached || failure instanceof UnknownTitle) return CommandAnswer.refuseHold(failure);\n\nthrow failure;"
        }
      ]
