      "file": "src/catalogue/CachedCatalogue.js",
      "kindWord": "class",
      "name": "CachedCatalogue",
      "represents": "work",
      "does": "coordinates",
      "exposed": true,
      "fields": [
        {
          "name": "remoteCatalogue",
          "type": "RemoteCatalogue"
        },
        {
          "name": "titlesByIsbnMap",
          "type": "Map<Isbn, Title>"
        }
      ],
      "methods": [
        {
          "visibility": "public",
          "name": "findTitle",
          "parameters": [
            {
              "name": "isbn",
              "type": "Isbn"
            }
          ],
          "returns": "Promise<Title|null>",
          "uses": [
            "titlesByIsbnMap",
            "readAndRememberTitle"
          ],
          "body": "if (this.titlesByIsbnMap.has(isbn)) return this.titlesByIsbnMap.get(isbn);\n\nreturn this.readAndRememberTitle(isbn);"
        },
        {
          "visibility": "private",
          "name": "readAndRememberTitle",
          "parameters": [
            {
              "name": "isbn",
              "type": "Isbn"
            }
          ],
          "returns": "Promise<Title|null>",
          "uses": [
            "remoteCatalogue",
            "titlesByIsbnMap"
          ],
          "calls": [
            "RemoteCatalogue#findTitle"
          ],
          "body": "const title = await this.remoteCatalogue.findTitle(isbn);\n// I/O: findTitle reads the title from the remote catalogue; null for an isbn it does not hold, which is remembered as well\n// Failure: CatalogueUnavailable, handled by HoldCommand#answerFailure\nthis.titlesByIsbnMap.set(isbn, title);\nreturn title;"
        }
      ]
    },
    {
      "file": "src/holds/HoldDesk.js",
      "kindWord": "class",
      "name": "HoldDesk",
