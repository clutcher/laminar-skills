              "name": "isbn",
              "type": "Isbn"
            }
          ],
          "returns": "Promise<Hold>",
          "uses": [
            "memberDirectory",
            "catalogue",
            "memberCard"
          ],
          "calls": [
            "MemberDirectory#findMember",
            "UnknownMember",
            "Member#countHeldTitles",
            "MemberCard#getHoldLimit",
            "HoldLimitReached",
            "CachedCatalogue#findTitle",
            "UnknownTitle",
            "Hold"
          ],
          "body": "const member = this.memberDirectory.findMember(memberId);\nif (member === null) throw new UnknownMember(memberId);\nif (member.countHeldTitles() >= this.memberCard.getHoldLimit(member)) throw new HoldLimitReached(memberId, member.tier);\n\nconst title = await this.catalogue.findTitle(isbn);\nif (title === null) throw new UnknownTitle(isbn);\n\nreturn new Hold(memberId, isbn, title.name);"
        }
      ]
    },
