+export class CatalogueUnavailable extends Error {
+  constructor(status) {
+    super(`the catalogue answered ${status}`);
+    this.status = status;
+  }
+}
diff --git a/src/catalogue/RemoteCatalogue.js b/src/catalogue/RemoteCatalogue.js
new file mode 100644
--- /dev/null
+++ b/src/catalogue/RemoteCatalogue.js
@@ -0,0 +1,17 @@
+import { CatalogueUnavailable } from "./CatalogueUnavailable.js";
+
+const NOT_FOUND_STATUS = 404;
+
+export class RemoteCatalogue {
+  constructor(baseUrl) {
+    this.baseUrl = baseUrl;
+  }
+
+  async findTitle(isbn) {
+    const response = await fetch(`${this.baseUrl}/titles/${encodeURIComponent(isbn)}`);
+    if (response.status === NOT_FOUND_STATUS) return null;
+    if (!response.ok) throw new CatalogueUnavailable(response.status);
+
+    return response.json();
+  }
+}
