+export class Member {
+  constructor(memberId, tier, heldIsbns) {
+    this.memberId = memberId;
+    this.tier = tier;
+    this.heldIsbns = heldIsbns;
+  }
+
+  countHeldTitles() {
+    return this.heldIsbns.length;
+  }
+}
diff --git a/src/members/MemberCard.js b/src/members/MemberCard.js
new file mode 100644
--- /dev/null
+++ b/src/members/MemberCard.js
@@ -0,0 +1,9 @@
+import { MemberTier } from "./MemberTier.js";
+
+const HOLD_LIMIT_BY_TIER_MAP = Object.freeze({ [MemberTier.STANDARD]: 3, [MemberTier.GOLD]: 10 });
+
+export class MemberCard {
+  describeHoldLimit(member) {
+    return `${member.tier} members may hold ${HOLD_LIMIT_BY_TIER_MAP[member.tier]} titles at once`;
+  }
+}
