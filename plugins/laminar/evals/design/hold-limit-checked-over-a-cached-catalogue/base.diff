diff --git a/test/members/MemberCard.test.js b/test/members/MemberCard.test.js
new file mode 100644
--- /dev/null
+++ b/test/members/MemberCard.test.js
@@ -0,0 +1,16 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { Member } from "../../src/members/Member.js";
+import { MemberCard } from "../../src/members/MemberCard.js";
+import { MemberTier } from "../../src/members/MemberTier.js";
+
+test("should describe a hold limit of 10 titles when the member is gold", () => {
+  // given
+  const goldMember = new Member("m-1", MemberTier.GOLD, []);
+
+  // when
+  const description = new MemberCard().describeHoldLimit(goldMember);
+
+  // then
+  assert.equal(description, "gold members may hold 10 titles at once");
+});
