+
+import java.time.LocalDateTime;
+
+public class SlotTakenException extends RuntimeException {
+
+    public SlotTakenException(String clinicianId, LocalDateTime start) {
+        super("clinician " + clinicianId + " is booked at " + start);
+    }
+}
