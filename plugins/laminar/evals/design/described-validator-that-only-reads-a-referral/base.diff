diff --git a/src/main/java/com/example/clinic/appointment/AppointmentBook.java b/src/main/java/com/example/clinic/appointment/AppointmentBook.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/com/example/clinic/appointment/AppointmentBook.java
@@ -0,0 +1,24 @@
+package com.example.clinic.appointment;
+
+import java.util.List;
+
+public class AppointmentBook {
+
+    private final AppointmentRepository appointments;
+
+    public AppointmentBook(AppointmentRepository appointments) {
+        this.appointments = appointments;
+    }
+
+    public Appointment book(Appointment requested) {
+        List<Appointment> sameDay = appointments.findByClinicianOn(requested.clinicianId(), requested.start().toLocalDate());
+        for (Appointment booked : sameDay) {
+            if (booked.start().isBefore(requested.end()) && requested.start().isBefore(booked.end())) {
+                throw new SlotTakenException(requested.clinicianId(), requested.start());
+            }
+        }
+
+        appointments.save(requested);
+        return requested;
+    }
+}
