+package com.example.clinic.appointment.web;
+
+import com.example.clinic.appointment.Appointment;
+import com.example.clinic.appointment.AppointmentBook;
+import java.util.UUID;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+public class AppointmentController {
+
+    private final AppointmentBook appointmentBook;
+
+    public AppointmentController(AppointmentBook appointmentBook) {
+        this.appointmentBook = appointmentBook;
+    }
+
+    @PostMapping("/patients/{patientId}/appointments")
+    @ResponseStatus(HttpStatus.CREATED)
+    public AppointmentBody bookAppointment(@PathVariable String patientId, @RequestBody NewAppointmentBody newAppointment) {
+        Appointment requested = new Appointment(UUID.randomUUID().toString(), patientId, newAppointment.clinicianId(), newAppointment.start(), newAppointment.end());
+        Appointment booked = appointmentBook.book(requested);
+        return new AppointmentBody(booked.appointmentId(), booked.clinicianId(), booked.start(), booked.end());
+    }
+}
