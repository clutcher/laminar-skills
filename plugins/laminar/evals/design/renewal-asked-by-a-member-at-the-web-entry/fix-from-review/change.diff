+package org.example.library.loan.in.web;
+
+import org.example.library.loan.app.api.ApiForFineTotalSearch;
+import org.example.library.loan.app.api.ApiForLoanRenewal;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import java.math.BigDecimal;
+
+@RestController
+public class LoanRenewalRestController {
+
+    private final ApiForLoanRenewal apiForLoanRenewal;
+
+    private final ApiForFineTotalSearch apiForFineTotalSearch;
+
+    public LoanRenewalRestController(
+            ApiForLoanRenewal apiForLoanRenewal, ApiForFineTotalSearch apiForFineTotalSearch) {
+        this.apiForLoanRenewal = apiForLoanRenewal;
+        this.apiForFineTotalSearch = apiForFineTotalSearch;
+    }
+
+    @PostMapping("/members/{memberId}/loans/{loanId}/renewals")
+    public ApiForLoanRenewal.LoanRenewalResult renewLoan(@PathVariable String memberId, @PathVariable String loanId) {
+        BigDecimal owedFineTotal = apiForFineTotalSearch.searchOwedFineTotalOfMember(memberId);
+        if (owedFineTotal.compareTo(new BigDecimal("10.00")) >= 0) {
+            throw new ApiForLoanRenewal.RenewalRefusedException(
+                    "member " + memberId + " owes fines of " + owedFineTotal + ", and a renewal needs less than 10.00");
+        }
+
+        return apiForLoanRenewal.renewLoan(memberId, loanId);
+    }
+}
