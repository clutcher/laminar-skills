+++ b/src/test/java/org/example/library/loan/in/web/LoanRenewalRestControllerTest.java
@@ -0,0 +1,141 @@
+package org.example.library.loan.in.web;
+
+import org.example.library.loan.app.domain.model.Loan;
+import org.example.library.loan.app.domain.model.Member;
+import org.example.library.loan.app.spi.LoanRepository;
+import org.example.library.loan.app.spi.MemberRepository;
+import org.example.postbox.DeliveryReceipt;
+import org.example.postbox.PostboxClient;
+import org.example.postbox.PostboxUnavailable;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mockito;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.mock.mockito.MockBean;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.ResultActions;
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders;
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.util.List;
+
+@SpringBootTest
+@AutoConfigureMockMvc
+class LoanRenewalRestControllerTest {
+
+    private final MockMvc mockMvc;
+
+    private final LoanRepository loanRepository;
+
+    private final MemberRepository memberRepository;
+
+    @MockBean
+    private PostboxClient postboxClient;
+
+    LoanRenewalRestControllerTest(MockMvc mockMvc, LoanRepository loanRepository, MemberRepository memberRepository) {
+        this.mockMvc = mockMvc;
+        this.loanRepository = loanRepository;
+        this.memberRepository = memberRepository;
+    }
+
+    @Test
+    void shouldMoveTheDueDateByFourteenDaysWhenTheLoanMayBeRenewed() throws Exception {
+        // given
+        memberRepository.save(new Member("M-2001", "ada.byron@mail.example", new Member.FineStatement(List.of())));
+        loanRepository.save(new Loan("L-6001", "M-2001", "Dune", LocalDate.of(2026, 11, 30), false, 0));
+        Mockito.when(postboxClient.send(
+                        List.of("ada.byron@mail.example"), "Your loan is renewed", "Dune is now due on 2026-12-14."))
+                .thenReturn(new DeliveryReceipt(1795132800L));
+
+        // when
+        ResultActions answer = mockMvc.perform(MockMvcRequestBuilders.post("/members/M-2001/loans/L-6001/renewals"));
+
+        // then
+        answer.andExpect(MockMvcResultMatchers.status().isOk())
+                .andExpect(MockMvcResultMatchers.jsonPath("$.loanId").value("L-6001"))
+                .andExpect(MockMvcResultMatchers.jsonPath("$.newDueDate").value("2026-12-14"));
+    }
+
+    @Test
+    void shouldSendTheRenewalMailWhenTheLoanIsRenewed() throws Exception {
+        // given
+        memberRepository.save(new Member("M-2002", "grace.hopper@mail.example", new Member.FineStatement(List.of())));
+        loanRepository.save(new Loan("L-6002", "M-2002", "Middlemarch", LocalDate.of(2026, 12, 3), false, 1));
+
+        // when
+        mockMvc.perform(MockMvcRequestBuilders.post("/members/M-2002/loans/L-6002/renewals"));
+
+        // then
+        Mockito.verify(postboxClient).send(Mockito.any(), Mockito.any(), Mockito.any());
+    }
+
+    @Test
+    void shouldRenewTheLoanWhenPostboxIsUnavailable() throws Exception {
+        // given
+        memberRepository.save(new Member("M-2003", "alan.kay@mail.example", new Member.FineStatement(List.of())));
+        loanRepository.save(new Loan("L-6003", "M-2003", "Solaris", LocalDate.of(2026, 12, 1), false, 0));
+        Mockito.when(postboxClient.send(
+                        List.of("alan.kay@mail.example"), "Your loan is renewed", "Solaris is now due on 2026-12-15."))
+                .thenThrow(new PostboxUnavailable("service down"));
+
+        // when
+        ResultActions answer = mockMvc.perform(MockMvcRequestBuilders.post("/members/M-2003/loans/L-6003/renewals"));
+
+        // then
+        answer.andExpect(MockMvcResultMatchers.status().isOk())
+                .andExpect(MockMvcResultMatchers.jsonPath("$.newDueDate").value("2026-12-15"));
+    }
+
+    @Test
+    void shouldAnswerConflictWhenAnotherMemberHoldsTheTitle() throws Exception {
+        // given
+        memberRepository.save(new Member(
+                "M-2004", "edsger.dijkstra@mail.example", new Member.FineStatement(List.of())));
+        boolean onHoldForAnotherMember = true;
+        loanRepository.save(new Loan("L-6004", "M-2004", "Emma", LocalDate.of(2026, 12, 2), onHoldForAnotherMember, 0));
+
+        // when
+        ResultActions answer = mockMvc.perform(MockMvcRequestBuilders.post("/members/M-2004/loans/L-6004/renewals"));
+
+        // then
+        answer.andExpect(MockMvcResultMatchers.status().isConflict())
+                .andExpect(MockMvcResultMatchers.jsonPath("$.detail")
+                        .value("loan L-6004 is on hold for another member"));
+    }
+
+    @Test
+    void shouldAnswerUnprocessableWhenTheMemberOwesTenOrMore() throws Exception {
+        // given
+        Member.FineStatement.Fine lostItemFine = new Member.FineStatement.Fine(
+                "Ulysses", LocalDate.of(2026, 10, 1), new BigDecimal("12.50"));
+        memberRepository.save(new Member(
+                "M-2005", "barbara.liskov@mail.example", new Member.FineStatement(List.of(lostItemFine))));
+        loanRepository.save(new Loan("L-6005", "M-2005", "Beloved", LocalDate.of(2026, 12, 4), false, 0));
+
+        // when
+        ResultActions answer = mockMvc.perform(MockMvcRequestBuilders.post("/members/M-2005/loans/L-6005/renewals"));
+
+        // then
+        answer.andExpect(MockMvcResultMatchers.status().isUnprocessableEntity())
+                .andExpect(MockMvcResultMatchers.jsonPath("$.detail")
+                        .value("member M-2005 owes fines of 12.50, and a renewal needs less than 10.00"));
+    }
+
+    @Test
+    void shouldAnswerUnprocessableWhenTheLoanWasRenewedTwice() throws Exception {
+        // given
+        memberRepository.save(new Member("M-2006", "donald.knuth@mail.example", new Member.FineStatement(List.of())));
+        int renewedTwice = 2;
+        loanRepository.save(new Loan("L-6006", "M-2006", "Persuasion", LocalDate.of(2026, 12, 5), false, renewedTwice));
+
+        // when
+        ResultActions answer = mockMvc.perform(MockMvcRequestBuilders.post("/members/M-2006/loans/L-6006/renewals"));
+
+        // then
+        answer.andExpect(MockMvcResultMatchers.status().isUnprocessableEntity())
+                .andExpect(MockMvcResultMatchers.jsonPath("$.detail")
+                        .value("loan L-6006 was renewed 2 times, the most a loan allows"));
+    }
+}
