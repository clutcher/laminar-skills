@@ -0,0 +1,66 @@
+package org.example.library.loan.app.domain;
+
+import org.example.library.loan.app.api.ApiForLoanRenewal;
+import org.example.library.loan.app.domain.model.Loan;
+import org.example.library.loan.app.domain.model.Member;
+import org.example.library.loan.app.domain.model.RenewalCheck;
+import org.example.library.loan.app.spi.LoanRepository;
+import org.example.postbox.PostboxClient;
+import org.example.postbox.PostboxUnavailable;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.util.List;
+
+public class LoanDesk implements ApiForLoanRenewal {
+
+    private static final Logger LOG = LoggerFactory.getLogger(LoanDesk.class);
+
+    private static final int MOST_RENEWALS = 2;
+
+    private final LoanRepository loanRepository;
+
+    private final MemberService memberService;
+
+    private final PostboxClient postboxClient;
+
+    public LoanDesk(LoanRepository loanRepository, MemberService memberService, PostboxClient postboxClient) {
+        this.loanRepository = loanRepository;
+        this.memberService = memberService;
+        this.postboxClient = postboxClient;
+    }
+
+    @Override
+    public ApiForLoanRenewal.LoanRenewalResult renewLoan(String memberId, String loanId) {
+        Member member = memberService.getMember(memberId);
+
+        for (Loan loan : loanRepository.findLoansOfMember(memberId)) {
+            if (loan.id().equals(loanId)) {
+                RenewalCheck check = new RenewalCheck(loanId, member, loan.renewalCount());
+                if (check.renewalCount() < MOST_RENEWALS) {
+                    Loan renewed = loan.renew();
+                    loanRepository.save(renewed);
+                    try {
+                        sendRenewalMail(check, renewed);
+                    } catch (PostboxUnavailable unavailable) {
+                        LOG.warn("the renewal mail of loan {} was not sent", renewed.id(), unavailable);
+                    }
+                    return new ApiForLoanRenewal.LoanRenewalResult(renewed.id(), renewed.dueDate());
+                } else {
+                    throw new ApiForLoanRenewal.RenewalRefusedException(
+                            "loan " + loanId + " was renewed " + MOST_RENEWALS + " times, the most a loan allows");
+                }
+            }
+        }
+        throw new ApiForLoanRenewal.LoanNotFoundException(memberId, loanId);
+    }
+
+    private void sendRenewalMail(RenewalCheck check, Loan renewed) {
+        String body = writeRenewalMailBody(renewed);
+        postboxClient.send(List.of(check.member().email()), "Your loan is renewed", body);
+    }
+
+    private String writeRenewalMailBody(Loan renewed) {
+        return renewed.itemTitle() + " is now due on " + renewed.dueDate() + ".";
+    }
+}
