+    public RenewedLoan renewLoan(String memberId, String loanId) {
+        Member member = memberRepository.findMember(memberId);
+        if (member == null) {
+            throw new MemberNotFoundException(memberId);
+        }
+
+        for (Loan loan : loanRepository.findLoansOfMember(memberId)) {
+            if (loan.loanId().equals(loanId)) {
+                RenewalCheck check = new RenewalCheck(loanId, member, loan.renewalCount());
+                if (check.renewalCount() < MOST_RENEWALS) {
+                    Loan renewed = renew(loan);
+                    String mailStatus = "SENT";
+                    try {
+                        sendRenewalMail(check, renewed);
+                    } catch (PostboxUnavailable unavailable) {
+                        mailStatus = "NOT_SENT";
+                    }
+                    return new RenewedLoan(renewed.loanId(), renewed.dueDate(), mailStatus);
+                } else {
+                    throw new RenewalRefusedException("loan " + loanId + " was renewed " + MOST_RENEWALS + " times, the most a loan allows");
+                }
+            }
+        }
+        throw new LoanNotFoundException(memberId, loanId);
+    }
