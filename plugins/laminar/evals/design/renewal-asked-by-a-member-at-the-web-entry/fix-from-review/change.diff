+package org.example.library.loan.in.web;
+
+import org.example.library.loan.app.api.ApiForLoanRenewal;
+import org.example.library.loan.app.domain.model.LoanOnHoldException;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ProblemDetail;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.bind.annotation.RestControllerAdvice;
+
+@RestControllerAdvice
+public class LoanRenewalWebExceptionHandler {
+
+    @ExceptionHandler(ApiForLoanRenewal.LoanNotFoundException.class)
+    public ProblemDetail answerLoanNotFound(ApiForLoanRenewal.LoanNotFoundException exception) {
+        return ProblemDetail.forStatusAndDetail(HttpStatus.NOT_FOUND, exception.getMessage());
+    }
+
+    @ExceptionHandler(LoanOnHoldException.class)
+    public ProblemDetail answerLoanOnHold(LoanOnHoldException exception) {
+        return ProblemDetail.forStatusAndDetail(HttpStatus.CONFLICT, exception.getMessage());
+    }
+
+    @ExceptionHandler(ApiForLoanRenewal.RenewalRefusedException.class)
+    public ProblemDetail answerRenewalRefused(ApiForLoanRenewal.RenewalRefusedException exception) {
+        return ProblemDetail.forStatusAndDetail(HttpStatus.UNPROCESSABLE_ENTITY, exception.getMessage());
+    }
+}
