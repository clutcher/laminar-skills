             throw new LoanOnHoldException(loan.loanId());
         }
 
-        Loan renewed = loan.withDueDate(loan.dueDate().plusDays(RENEWAL_DAYS));
+        Loan renewed = loan.renew(loan.dueDate().plusDays(RENEWAL_DAYS));
         loanRepository.save(renewed);
         return renewed;
     }
+
+    private void sendRenewalMail(RenewalCheck check, Loan renewed) {
+        String body = writeRenewalMailBody(renewed);
+        postboxClient.send(List.of(check.member().email()), "Your loan is renewed", body);
+    }
+
+    private String writeRenewalMailBody(Loan renewed) {
+        return renewed.itemTitle() + " is now due on " + renewed.dueDate() + ".";
+    }
 }
