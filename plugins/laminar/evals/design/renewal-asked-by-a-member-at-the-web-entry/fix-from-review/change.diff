+package org.example.library.loan.in.web;
+
+import org.example.library.loan.app.api.ApiForMemberLoans;
+import org.example.library.loan.app.api.MemberLoans;
+import org.example.library.loan.app.api.RenewalRefusedException;
+import org.example.library.loan.app.api.RenewedLoan;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import java.math.BigDecimal;
+
+@RestController
+public class LoanRenewalController {
+
+    private final ApiForMemberLoans apiForMemberLoans;
+
+    public LoanRenewalController(ApiForMemberLoans apiForMemberLoans) {
+        this.apiForMemberLoans = apiForMemberLoans;
+    }
+
+    @PostMapping("/members/{memberId}/loans/{loanId}/renewals")
+    public RenewedLoan renewLoan(@PathVariable String memberId, @PathVariable String loanId) {
+        MemberLoans memberLoans = apiForMemberLoans.searchLoansOfMember(memberId);
+        if (memberLoans.owedFines().compareTo(new BigDecimal("10.00")) >= 0) {
+            throw new RenewalRefusedException("member " + memberId + " owes fines of " + memberLoans.owedFines() + ", and a renewal needs less than 10.00");
+        }
+
+        return apiForMemberLoans.renewLoan(memberId, loanId);
+    }
+}
