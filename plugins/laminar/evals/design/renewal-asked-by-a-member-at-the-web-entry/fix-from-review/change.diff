@@ -0,0 +1,23 @@
+package org.example.library.loan.app.domain;
+
+import org.example.library.loan.app.domain.model.Loan;
+
+import java.math.BigDecimal;
+
+public class ExtensionPolicy {
+
+    private static final int MOST_EXTENSIONS = 2;
+
+    private static final BigDecimal LEAST_BLOCKING_DEBT = new BigDecimal("10.00");
+
+    public boolean allowsExtension(Loan loan, BigDecimal owedFines) {
+        if (loan.onHold()) {
+            return false;
+        }
+        if (loan.renewalCount() >= MOST_EXTENSIONS) {
+            return false;
+        }
+
+        return owedFines.compareTo(LEAST_BLOCKING_DEBT) < 0;
+    }
+}
