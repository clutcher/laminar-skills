+package org.example.library.loan.app.domain.model;
+
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+
+import java.time.LocalDate;
+
+class LoanTest {
+
+    @Test
+    void shouldRefuseTheRenewalWhenTheLoanIsOnHold() {
+        // given
+        boolean onHoldForAnotherMember = true;
+        Loan loan = new Loan("L-5001", "M-1001", "Dune", LocalDate.of(2026, 11, 30), onHoldForAnotherMember);
+
+        // when
+        LoanOnHoldException refusal = Assertions.assertThrows(LoanOnHoldException.class, loan::renew);
+
+        // then
+        Assertions.assertEquals("loan L-5001 is on hold for another member", refusal.getMessage());
+    }
+
+    @Test
+    void shouldMoveTheDueDateByFourteenDaysWhenTheLoanIsNotOnHold() {
+        // given
+        boolean onHoldForAnotherMember = false;
+        Loan loan = new Loan("L-5002", "M-1001", "Middlemarch", LocalDate.of(2026, 11, 30), onHoldForAnotherMember);
+
+        // when
+        Loan renewed = loan.renew();
+
+        // then
+        Assertions.assertEquals(LocalDate.of(2026, 12, 14), renewed.dueDate());
+    }
+}
