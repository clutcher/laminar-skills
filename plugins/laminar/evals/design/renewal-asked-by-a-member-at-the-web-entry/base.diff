+package org.example.library.loan.out.memory;
+
+import org.example.library.loan.app.domain.model.Loan;
+import org.example.library.loan.app.spi.LoanRepository;
+import org.springframework.stereotype.Repository;
+
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+@Repository
+public class LoanRepositoryUsingMemory implements LoanRepository {
+
+    private final Map<String, Loan> loanByIdMap = new ConcurrentHashMap<>();
+
+    @Override
+    public List<Loan> findLoansOfMember(String memberId) {
+        return loanByIdMap.values().stream()
+                .filter(loan -> loan.memberId().equals(memberId))
+                .toList();
+    }
+
+    @Override
+    public void save(Loan loan) {
+        loanByIdMap.put(loan.loanId(), loan);
+    }
+}
