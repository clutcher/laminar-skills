+package org.example.library.loan.in.web.converter;
+
+import org.example.library.loan.app.domain.model.Loan;
+import org.example.library.loan.in.web.response.LoanOverviewResponse;
+import org.springframework.stereotype.Component;
+
+import java.math.BigDecimal;
+import java.util.List;
+
+@Component
+public class LoanOverviewResponseConverter {
+
+    public LoanOverviewResponse convert(String memberId, List<Loan> heldLoans, BigDecimal owedFineTotal) {
+        List<LoanOverviewResponse.HeldLoan> heldLoanResponses = heldLoans.stream().map(this::convertHeldLoan).toList();
+        return new LoanOverviewResponse(memberId, heldLoanResponses, owedFineTotal);
+    }
+
+    private LoanOverviewResponse.HeldLoan convertHeldLoan(Loan heldLoan) {
+        return new LoanOverviewResponse.HeldLoan(heldLoan.loanId(), heldLoan.itemTitle(), heldLoan.dueDate());
+    }
+}
