+package org.example.library.loan.app.domain.model;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.util.List;
+
+public record FineStatement(List<Fine> fines) {
+
+    public BigDecimal sumOwedAmount() {
+        BigDecimal owedAmount = BigDecimal.ZERO;
+        for (Fine fine : fines) {
+            owedAmount = owedAmount.add(fine.amount());
+        }
+        return owedAmount;
+    }
+
+    public record Fine(String itemTitle, LocalDate issuedOn, BigDecimal amount) {
+    }
+}
