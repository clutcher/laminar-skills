+package org.example.library.loan.app.domain;
+
+import org.example.library.loan.app.api.ApiForMemberLoans;
+import org.example.library.loan.app.api.MemberLoans;
+import org.example.library.loan.app.api.MemberNotFoundException;
+import org.example.library.loan.app.domain.model.Loan;
+import org.example.library.loan.app.domain.model.LoanOnHoldException;
+import org.example.library.loan.app.domain.model.Member;
+import org.example.library.loan.app.spi.LoanRepository;
+import org.example.library.loan.app.spi.MemberRepository;
+
+import java.util.List;
+
+public class LoanDesk implements ApiForMemberLoans {
+
+    private static final int RENEWAL_DAYS = 14;
+
+    private final LoanRepository loanRepository;
+
+    private final MemberRepository memberRepository;
+
+    public LoanDesk(LoanRepository loanRepository, MemberRepository memberRepository) {
+        this.loanRepository = loanRepository;
+        this.memberRepository = memberRepository;
+    }
+
+    @Override
+    public MemberLoans searchLoansOfMember(String memberId) {
+        Member member = memberRepository.findMember(memberId);
+        if (member == null) {
+            throw new MemberNotFoundException(memberId);
+        }
+
+        List<Loan> loans = loanRepository.findLoansOfMember(memberId);
+        return new MemberLoans(memberId, loans, member.fineStatement().sumOwedAmount());
+    }
+
+    public Loan renew(Loan loan) {
+        if (loan.onHold()) {
+            throw new LoanOnHoldException(loan.loanId());
+        }
+
+        Loan renewed = loan.withDueDate(loan.dueDate().plusDays(RENEWAL_DAYS));
+        loanRepository.save(renewed);
+        return renewed;
+    }
+}
