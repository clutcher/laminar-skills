+package org.example.library.loan.in.web;
+
+import org.example.library.loan.app.domain.model.Loan;
+import org.example.library.loan.app.domain.model.Member;
+import org.example.library.loan.app.spi.LoanRepository;
+import org.example.library.loan.app.spi.MemberRepository;
+import org.junit.jupiter.api.Test;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.ResultActions;
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders;
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.util.List;
+
+@SpringBootTest
+@AutoConfigureMockMvc
+class LoanOverviewRestControllerTest {
+
+    private final MockMvc mockMvc;
+
+    private final LoanRepository loanRepository;
+
+    private final MemberRepository memberRepository;
+
+    LoanOverviewRestControllerTest(MockMvc mockMvc, LoanRepository loanRepository, MemberRepository memberRepository) {
+        this.mockMvc = mockMvc;
+        this.loanRepository = loanRepository;
+        this.memberRepository = memberRepository;
+    }
+
+    @Test
+    void shouldAnswerTheLoansAndTheOwedFinesWhenTheMemberHoldsLoans() throws Exception {
+        // given
+        Member.FineStatement.Fine lateReturnFine = new Member.FineStatement.Fine(
+                "The Left Hand of Darkness", LocalDate.of(2026, 9, 2), new BigDecimal("2.50"));
+        Member.FineStatement.Fine damagedCoverFine = new Member.FineStatement.Fine(
+                "Middlemarch", LocalDate.of(2026, 10, 14), new BigDecimal("4.00"));
+        Member.FineStatement fineStatement = new Member.FineStatement(List.of(lateReturnFine, damagedCoverFine));
+        memberRepository.save(new Member("M-1001", "ada.byron@mail.example", fineStatement));
+        loanRepository.save(new Loan("L-5001", "M-1001", "Dune", LocalDate.of(2026, 11, 30), false));
+
+        // when
+        ResultActions answer = mockMvc.perform(MockMvcRequestBuilders.get("/members/M-1001/loans"));
+
+        // then
+        answer.andExpect(MockMvcResultMatchers.status().isOk())
+                .andExpect(MockMvcResultMatchers.jsonPath("$.memberId").value("M-1001"))
+                .andExpect(MockMvcResultMatchers.jsonPath("$.loans[0].loanId").value("L-5001"))
+                .andExpect(MockMvcResultMatchers.jsonPath("$.loans[0].itemTitle").value("Dune"))
+                .andExpect(MockMvcResultMatchers.jsonPath("$.loans[0].dueDate").value("2026-11-30"))
+                .andExpect(MockMvcResultMatchers.jsonPath("$.owedFineTotal").value(6.50));
+    }
+
+    @Test
+    void shouldAnswerNoLoansWhenTheMemberHoldsNone() throws Exception {
+        // given
+        memberRepository.save(new Member("M-1002", "grace.hopper@mail.example", new Member.FineStatement(List.of())));
+
+        // when
+        ResultActions answer = mockMvc.perform(MockMvcRequestBuilders.get("/members/M-1002/loans"));
+
+        // then
+        answer.andExpect(MockMvcResultMatchers.status().isOk())
+                .andExpect(MockMvcResultMatchers.jsonPath("$.loans").isEmpty())
+                .andExpect(MockMvcResultMatchers.jsonPath("$.owedFineTotal").value(0));
+    }
+
+    @Test
+    void shouldAnswerNotFoundWhenNoMemberHasTheId() throws Exception {
+        // given
+        String unknownMemberId = "M-9999";
+
+        // when
+        ResultActions answer = mockMvc.perform(MockMvcRequestBuilders.get("/members/" + unknownMemberId + "/loans"));
+
+        // then
+        answer.andExpect(MockMvcResultMatchers.status().isNotFound())
+                .andExpect(MockMvcResultMatchers.jsonPath("$.detail").value("no member has the id M-9999"));
+    }
+}
