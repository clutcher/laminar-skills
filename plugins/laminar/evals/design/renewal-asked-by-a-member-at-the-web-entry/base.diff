+package org.example.library.loan.app.domain.model;
+
+import java.time.LocalDate;
+
+public record Loan(String id, String memberId, String itemTitle, LocalDate dueDate, boolean onHold) {
+
+    private static final int RENEWAL_DAYS = 14;
+
+    public Loan renew() {
+        if (onHold) {
+            throw new LoanOnHoldException(id);
+        }
+
+        return new Loan(id, memberId, itemTitle, dueDate.plusDays(RENEWAL_DAYS), onHold);
+    }
+}
