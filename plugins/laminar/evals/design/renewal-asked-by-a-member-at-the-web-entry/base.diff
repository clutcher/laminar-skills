+package org.example.library.loan.in.web;
+
+import org.example.library.loan.app.api.MemberLoans;
+import org.example.library.loan.app.domain.model.Loan;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.util.List;
+
+public record MemberLoansResponse(String memberId, List<Item> loans, BigDecimal owedFines) {
+
+    public static MemberLoansResponse mapMemberLoans(MemberLoans memberLoans) {
+        List<Item> items = memberLoans.loans().stream().map(Item::mapLoan).toList();
+        return new MemberLoansResponse(memberLoans.memberId(), items, memberLoans.owedFines());
+    }
+
+    public record Item(String loanId, String itemTitle, LocalDate dueDate) {
+
+        static Item mapLoan(Loan loan) {
+            return new Item(loan.loanId(), loan.itemTitle(), loan.dueDate());
+        }
+    }
+}
