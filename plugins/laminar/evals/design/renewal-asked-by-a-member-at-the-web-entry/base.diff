+package org.example.library.loan.app.domain;
+
+import org.example.library.loan.app.api.ApiForLoanSearch;
+import org.example.library.loan.app.domain.model.Loan;
+import org.example.library.loan.app.domain.model.Member;
+import org.example.library.loan.app.spi.LoanRepository;
+
+import java.util.List;
+
+public class LoanSearchService implements ApiForLoanSearch {
+
+    private final LoanRepository loanRepository;
+
+    private final MemberService memberService;
+
+    public LoanSearchService(LoanRepository loanRepository, MemberService memberService) {
+        this.loanRepository = loanRepository;
+        this.memberService = memberService;
+    }
+
+    @Override
+    public List<Loan> searchLoansOfMember(String memberId) {
