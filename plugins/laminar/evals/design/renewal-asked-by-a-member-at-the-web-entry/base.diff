@@ -0,0 +1,21 @@
+package org.example.postbox;
+
+import java.time.Instant;
+import java.util.List;
+
+public class PostboxClient {
+
+    private final String senderAddress;
+
+    public PostboxClient(String senderAddress) {
+        this.senderAddress = senderAddress;
+    }
+
+    public DeliveryReceipt send(List<String> recipients, String subject, String body) {
+        if (recipients.isEmpty()) {
+            throw new PostboxUnavailable("a message from " + senderAddress + " needs at least 1 recipient");
+        }
+
+        return new DeliveryReceipt(Instant.now().getEpochSecond());
+    }
+}
