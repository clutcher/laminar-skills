@@ -0,0 +1,39 @@
+package org.example.library.loan.in.web;
+
+import org.example.library.loan.app.api.ApiForFineTotalSearch;
+import org.example.library.loan.app.api.ApiForLoanSearch;
+import org.example.library.loan.app.domain.model.Loan;
+import org.example.library.loan.in.web.converter.LoanOverviewResponseConverter;
+import org.example.library.loan.in.web.response.LoanOverviewResponse;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RestController;
+
+import java.math.BigDecimal;
+import java.util.List;
+
+@RestController
+public class LoanOverviewRestController {
+
+    private final ApiForLoanSearch apiForLoanSearch;
+
+    private final ApiForFineTotalSearch apiForFineTotalSearch;
+
+    private final LoanOverviewResponseConverter loanOverviewResponseConverter;
+
+    public LoanOverviewRestController(
+            ApiForLoanSearch apiForLoanSearch,
+            ApiForFineTotalSearch apiForFineTotalSearch,
+            LoanOverviewResponseConverter loanOverviewResponseConverter) {
+        this.apiForLoanSearch = apiForLoanSearch;
+        this.apiForFineTotalSearch = apiForFineTotalSearch;
+        this.loanOverviewResponseConverter = loanOverviewResponseConverter;
+    }
+
+    @GetMapping("/members/{memberId}/loans")
+    public LoanOverviewResponse searchLoanOverview(@PathVariable String memberId) {
+        List<Loan> loans = apiForLoanSearch.searchLoansOfMember(memberId);
+        BigDecimal owedFineTotal = apiForFineTotalSearch.searchOwedFineTotalOfMember(memberId);
+        return loanOverviewResponseConverter.convert(memberId, loans, owedFineTotal);
+    }
+}
