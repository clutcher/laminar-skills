+
+import java.math.BigDecimal;
+import java.util.List;
+
+@Component
+public class LoanOverviewResponseConverter {
+
+    public LoanOverviewResponse convert(String memberId, List<Loan> loans, BigDecimal owedFineTotal) {
+        List<LoanOverviewResponse.Loan> overviewLoans = loans.stream().map(this::convertLoan).toList();
+        return new LoanOverviewResponse(memberId, overviewLoans, owedFineTotal);
+    }
+
+    private LoanOverviewResponse.Loan convertLoan(Loan loan) {
+        return new LoanOverviewResponse.Loan(loan.id(), loan.itemTitle(), loan.dueDate());
+    }
+}
