@@ -0,0 +1,36 @@
+package org.example.library.loan.app.domain;
+
+import org.example.library.loan.app.api.ApiForLoanUpkeep;
+import org.example.library.loan.app.domain.model.Loan;
+import org.example.library.loan.app.spi.LoanRepository;
+import org.example.library.loan.app.spi.OverdueNotifier;
+
+import java.time.LocalDate;
+import java.util.List;
+
+public class LoanUpkeep implements ApiForLoanUpkeep {
+
+    private final LoanRepository loanRepository;
+
+    private final OverdueNotifier overdueNotifier;
+
+    public LoanUpkeep(LoanRepository loanRepository, OverdueNotifier overdueNotifier) {
+        this.loanRepository = loanRepository;
+        this.overdueNotifier = overdueNotifier;
+    }
+
+    @Override
+    public int sendOverdueNotices(LocalDate day) {
+        List<Loan> overdueLoans = loanRepository.findLoansDueBefore(day);
+        for (Loan loan : overdueLoans) {
+            overdueNotifier.notifyMember(loan.memberId(), loan.itemTitle(), loan.dueDate());
+        }
+
+        return overdueLoans.size();
+    }
+
+    @Override
+    public int closeDay(LocalDate day) {
+        return loanRepository.archiveLoansReturnedOn(day);
+    }
+}
