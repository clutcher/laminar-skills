+package org.example.library.loan.out.log;
+
+import org.example.library.loan.app.spi.OverdueNotifier;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.stereotype.Component;
+
+import java.time.LocalDate;
+
+@Component
+public class OverdueNotifierUsingLog implements OverdueNotifier {
+
+    private static final Logger LOG = LoggerFactory.getLogger(OverdueNotifierUsingLog.class);
+
+    @Override
+    public void notifyMember(String memberId, String itemTitle, LocalDate dueDate) {
+        LOG.info("Overdue notice to member {}: {} was due on {}", memberId, itemTitle, dueDate);
+    }
+}
diff --git a/src/main/java/org/example/library/loan/out/memory/LoanRepositoryUsingMemory.java b/src/main/java/org/example/library/loan/out/memory/LoanRepositoryUsingMemory.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/org/example/library/loan/out/memory/LoanRepositoryUsingMemory.java
@@ -0,0 +1,38 @@
+package org.example.library.loan.out.memory;
+
+import org.example.library.loan.app.domain.model.Loan;
+import org.example.library.loan.app.spi.LoanRepository;
+import org.springframework.stereotype.Repository;
+
+import java.time.LocalDate;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+@Repository
+public class LoanRepositoryUsingMemory implements LoanRepository {
+
+    private final Map<String, Loan> loanByIdMap = new ConcurrentHashMap<>();
+
+    private final Map<String, Loan> archivedLoanByIdMap = new ConcurrentHashMap<>();
+
+    @Override
+    public List<Loan> findLoansDueBefore(LocalDate day) {
+        return loanByIdMap.values().stream()
+                .filter(loan -> loan.returnedOn() == null && loan.dueDate().isBefore(day))
+                .toList();
+    }
+
+    @Override
+    public int archiveLoansReturnedOn(LocalDate day) {
+        List<Loan> returnedLoans = loanByIdMap.values().stream()
+                .filter(loan -> day.equals(loan.returnedOn()))
+                .toList();
+        for (Loan loan : returnedLoans) {
+            loanByIdMap.remove(loan.loanId());
+            archivedLoanByIdMap.put(loan.loanId(), loan);
+        }
+
+        return returnedLoans.size();
+    }
+}
