diff --git a/src/main/java/com/example/clinic/util/ClinicUtils.java b/src/main/java/com/example/clinic/util/ClinicUtils.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/com/example/clinic/util/ClinicUtils.java
@@ -0,0 +1,42 @@
+package com.example.clinic.util;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDateTime;
+import java.time.LocalTime;
+
+public final class ClinicUtils {
+
+    private static final int SLOT_MINUTES = 15;
+
+    private static final LocalTime SEND_TIME = LocalTime.of(18, 0);
+
+    private ClinicUtils() {
+    }
+
+    public static LocalDateTime getSlotStartAtOrAfter(LocalDateTime requested) {
+        int minutesPastSlot = requested.getMinute() % SLOT_MINUTES;
+        LocalDateTime truncated = requested.withSecond(0).withNano(0);
+        return minutesPastSlot == 0 ? truncated : truncated.plusMinutes(SLOT_MINUTES - minutesPastSlot);
+    }
+
+    public static boolean overlaps(LocalDateTime start, LocalDateTime end, LocalDateTime otherStart, LocalDateTime otherEnd) {
+        return start.isBefore(otherEnd) && otherStart.isBefore(end);
+    }
+
+    public static BigDecimal getPatientShare(BigDecimal fee, int insuredPercent) {
+        return fee.multiply(BigDecimal.valueOf(100 - insuredPercent)).divide(BigDecimal.valueOf(100));
+    }
+
+    public static BigDecimal roundToCents(BigDecimal amount) {
+        return amount.setScale(2, RoundingMode.HALF_UP);
+    }
+
+    public static LocalDateTime getEveningBefore(LocalDateTime start) {
+        return start.toLocalDate().minusDays(1).atTime(SEND_TIME);
+    }
+
+    public static String normalizePhone(String phone) {
+        return phone.replaceAll("[^0-9+]", "");
+    }
+}
