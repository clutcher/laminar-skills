+package com.example.clinic.reminder;
+
+import com.example.clinic.appointment.Appointment;
+import java.time.LocalDateTime;
+import java.time.LocalTime;
+
+public class ReminderPlanner {
+
+    private static final LocalTime SEND_TIME = LocalTime.of(18, 0);
+
+    public Reminder planReminder(Appointment appointment, Patient patient) {
+        return new Reminder(patient.patientId(), normalizePhone(patient.phone()), getEveningBefore(appointment.start()));
+    }
+
+    private LocalDateTime getEveningBefore(LocalDateTime start) {
+        return start.toLocalDate().minusDays(1).atTime(SEND_TIME);
+    }
+
+    private String normalizePhone(String phone) {
+        return phone.replaceAll("[^0-9+]", "");
+    }
+}
