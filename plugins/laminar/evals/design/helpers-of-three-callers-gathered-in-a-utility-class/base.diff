@@ -0,0 +1,38 @@
+package com.example.clinic.appointment;
+
+import java.time.LocalDateTime;
+import java.time.LocalTime;
+import java.util.List;
+
+public class AppointmentBook {
+
+    private static final int SLOT_MINUTES = 15;
+
+    private final AppointmentRepository appointments;
+
+    public AppointmentBook(AppointmentRepository appointments) {
+        this.appointments = appointments;
+    }
+
+    public Appointment book(Appointment requested) {
+        LocalDateTime start = getSlotStartAtOrAfter(requested.start());
+        Appointment aligned = new Appointment(requested.appointmentId(), requested.patientId(), requested.clinicianId(), requested.visitType(), start, start.plus(java.time.Duration.between(requested.start(), requested.end())));
+        List<Appointment> sameDay = appointments.findByClinicianOn(aligned.clinicianId(), aligned.start().toLocalDate());
+        for (Appointment booked : sameDay) {
+            if (overlaps(booked, aligned)) throw new SlotTakenException(aligned.clinicianId(), aligned.start());
+        }
+
+        appointments.save(aligned);
+        return aligned;
+    }
+
+    private LocalDateTime getSlotStartAtOrAfter(LocalDateTime requested) {
+        int minutesPastSlot = requested.getMinute() % SLOT_MINUTES;
+        LocalDateTime truncated = requested.withSecond(0).withNano(0);
+        return minutesPastSlot == 0 ? truncated : truncated.plusMinutes(SLOT_MINUTES - minutesPastSlot);
+    }
+
+    private boolean overlaps(Appointment one, Appointment other) {
+        return one.start().isBefore(other.end()) && other.start().isBefore(one.end());
+    }
+}
