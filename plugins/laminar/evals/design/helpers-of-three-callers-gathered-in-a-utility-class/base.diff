@@ -0,0 +1,20 @@
+package com.example.clinic.billing;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+
+public class InvoiceService {
+
+    public Invoice createInvoice(String invoiceId, String patientId, BigDecimal fee, int insuredPercent) {
+        BigDecimal patientShare = getPatientShare(fee, insuredPercent);
+        return new Invoice(invoiceId, patientId, roundToCents(fee), roundToCents(patientShare));
+    }
+
+    private BigDecimal getPatientShare(BigDecimal fee, int insuredPercent) {
+        return fee.multiply(BigDecimal.valueOf(100 - insuredPercent)).divide(BigDecimal.valueOf(100));
+    }
+
+    private BigDecimal roundToCents(BigDecimal amount) {
+        return amount.setScale(2, RoundingMode.HALF_UP);
+    }
+}
