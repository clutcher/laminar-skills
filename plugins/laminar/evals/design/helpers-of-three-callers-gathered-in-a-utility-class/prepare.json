       "8: public final class ClinicUtils {",
       "9: ",
       "10:     private static final int SLOT_MINUTES = 15;",
       "11: ",
       "12:     private static final LocalTime SEND_TIME = LocalTime.of(18, 0);",
       "13: ",
       "14:     private ClinicUtils() {",
       "15:     }",
       "16: ",
       "17:     public static LocalDateTime roundUpToSlotStart(LocalDateTime requested) {",
       "18:         int minutesPastSlot = requested.getMinute() % SLOT_MINUTES;",
       "19:         LocalDateTime truncated = requested.withSecond(0).withNano(0);",
       "20:         return minutesPastSlot == 0 ? truncated : truncated.plusMinutes(SLOT_MINUTES - minutesPastSlot);",
       "21:     }",
       "22: ",
       "23:     public static boolean overlaps(LocalDateTime start, LocalDateTime end, LocalDateTime otherStart, LocalDateTime otherEnd) {",
       "24:         return start.isBefore(otherEnd) && otherStart.isBefore(end);",
       "25:     }",
       "26: ",
       "27:     public static BigDecimal getPatientShare(BigDecimal fee, int insuredPercent) {",
       "28:         return fee.multiply(BigDecimal.valueOf(100 - insuredPercent)).divide(BigDecimal.valueOf(100));",
       "29:     }",
       "30: ",
       "31:     public static BigDecimal roundToCents(BigDecimal amount) {",
       "32:         return amount.setScale(2, RoundingMode.HALF_UP);",
       "33:     }",
       "34: ",
       "35:     public static LocalDateTime getPreviousEvening(LocalDateTime start) {",
       "36:         return start.toLocalDate().minusDays(1).atTime(SEND_TIME);",
       "37:     }",
       "38: ",
       "39:     public static String normalizePhone(String phone) {",
       "40:         return phone.replaceAll(\"[^0-9+]\", \"\");",
       "41:     }",
       "42: }"
      ]
     }
