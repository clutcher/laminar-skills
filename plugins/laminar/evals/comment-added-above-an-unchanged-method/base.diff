+package com.example.harbour.berth;
+
+import java.util.Comparator;
+import java.util.List;
+
+public class BerthPlanner {
+
+    public Berth pickBerth(List<Berth> berths, Stay stay) {
+        return berths.stream()
+            .filter(berth -> !berth.isUnderMaintenanceDuring(stay))
+            .min(Comparator.comparing(Berth::dailyRate))
+            .orElseThrow(NoBerthAvailable::new);
+    }
+}
