@@ -0,0 +1,24 @@
+package org.tidewatch.tides.report;
+
+import java.io.IOException;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+
+public class HarbourOfficeClient {
+    private final HttpClient httpClient;
+    private final URI readingsEndpoint;
+
+    public HarbourOfficeClient(HttpClient httpClient, URI readingsEndpoint) {
+        this.httpClient = httpClient;
+        this.readingsEndpoint = readingsEndpoint;
+    }
+
+    public void post(String body) throws IOException, InterruptedException {
+        HttpRequest request = HttpRequest.newBuilder(readingsEndpoint)
+                .POST(HttpRequest.BodyPublishers.ofString(body))
+                .build();
+        httpClient.send(request, HttpResponse.BodyHandlers.discarding());
+    }
+}
