@@ -0,0 +1,22 @@
+package org.tidewatch.tides.table;
+
+import java.time.Duration;
+import java.util.Optional;
+
+import com.github.benmanes.caffeine.cache.Cache;
+import com.github.benmanes.caffeine.cache.Caffeine;
+
+public class TideTables {
+    private final Cache<String, TideTable> tablesByPort = Caffeine.newBuilder()
+            .maximumSize(500)
+            .expireAfterWrite(Duration.ofHours(6))
+            .build();
+
+    public void keep(TideTable table) {
+        tablesByPort.put(table.portCode(), table);
+    }
+
+    public Optional<TideTable> tableOf(String portCode) {
+        return Optional.ofNullable(tablesByPort.getIfPresent(portCode));
+    }
+}
