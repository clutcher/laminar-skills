@@ -0,0 +1,15 @@
+package org.tidewatch.tides.report;
+
+import java.io.IOException;
+
+public class GaugeReporter {
+    private final HarbourOfficeClient harbourOffice;
+
+    public GaugeReporter(HarbourOfficeClient harbourOffice) {
+        this.harbourOffice = harbourOffice;
+    }
+
+    public void report(GaugeReading reading) throws IOException, InterruptedException {
+        harbourOffice.post(reading.gaugeId() + "=" + reading.heightMetres());
+    }
+}
