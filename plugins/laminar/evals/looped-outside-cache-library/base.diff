+package org.tidewatch.tides.table;
+
+public class PilotWindows {
+    private final TideTables tideTables;
+
+    public PilotWindows(TideTables tideTables) {
+        this.tideTables = tideTables;
+    }
+
+    public boolean knowsTidesAt(String portCode) {
+        return tideTables.tableOf(portCode).isPresent();
+    }
+}
