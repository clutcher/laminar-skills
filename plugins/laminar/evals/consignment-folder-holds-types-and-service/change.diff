+package com.example.courier.consignment;
+
+import java.util.List;
+
+public class Consignment {
+
+    private final String consignmentId;
+    private final List<ConsignmentLine> lines;
+    private ConsignmentStatus status;
+
+    public Consignment(String consignmentId, List<ConsignmentLine> lines) {
+        this.consignmentId = consignmentId;
+        this.lines = List.copyOf(lines);
+        this.status = ConsignmentStatus.BOOKED;
+    }
+
+    public String getConsignmentId() {
+        return consignmentId;
+    }
+
+    public int getTotalWeightInGrams() {
+        return lines.stream().mapToInt(ConsignmentLine::weightInGrams).sum();
+    }
+
+    public boolean isDispatched() {
+        return status == ConsignmentStatus.DISPATCHED;
+    }
+
+    public void dispatch() {
+        status = ConsignmentStatus.DISPATCHED;
+    }
+
+    public void markDelivered() {
+        status = ConsignmentStatus.DELIVERED;
+    }
+}
