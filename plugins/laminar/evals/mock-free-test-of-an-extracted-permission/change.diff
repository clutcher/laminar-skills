+package com.example.shop.notification;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.example.shop.user.NotificationPreferences;
+import com.example.shop.user.User;
+import org.junit.jupiter.api.Test;
+
+class EmailPermissionServiceTest {
+
+    private final EmailPermissionService emailPermissionService = new EmailPermissionService();
+
+    @Test
+    void shouldAllowSendingWhenEmailEnabledAndValid() {
+        // given
+        User user = new User("test@example.com", new NotificationPreferences(true));
+
+        // when
+        boolean result = emailPermissionService.canSend(user);
+
+        // then
+        assertThat(result).isTrue();
+    }
+}
