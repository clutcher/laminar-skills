@@ -0,0 +1,23 @@
+package com.example.shop.notification;
+
+import com.example.shop.user.NotificationPreferences;
+import com.example.shop.user.User;
+
+class EmailPermissionService {
+
+    boolean canSend(User user) {
+        if (user == null) {
+            return false;
+        }
+        NotificationPreferences notificationPreferences = user.getPreferences();
+        if (notificationPreferences == null
+                || !notificationPreferences.isEmailEnabled()) {
+            return false;
+        }
+        String emailAddress = user.getEmailAddress();
+        if (emailAddress == null || emailAddress.isBlank()) {
+            return false;
+        }
+        return true;
+    }
+}
