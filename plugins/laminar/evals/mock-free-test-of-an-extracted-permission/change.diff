+++ b/shop/src/main/java/com/example/shop/notification/NotificationService.java
@@ -0,0 +1,21 @@
+package com.example.shop.notification;
+
+import com.example.shop.mail.EmailService;
+import com.example.shop.user.User;
+import com.example.shop.user.UserRepository;
+import lombok.RequiredArgsConstructor;
+
+@RequiredArgsConstructor
+class NotificationService {
+    private final UserRepository userRepository;
+    private final EmailService emailService;
+    private final EmailPermissionService emailPermissionService;
+
+    public boolean notifyUser(long userId, String message) {
+        User user = userRepository.findById(userId);
+        if (!emailPermissionService.canSend(user)) {
+            return false;
+        }
+        return emailService.send(user.getEmailAddress(), message);
+    }
+}
