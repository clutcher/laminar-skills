+package com.example.apiary.swarming;
+
+import java.util.HashMap;
+import java.util.Map;
+
+public class SwarmWatch {
+
+    private final Map<String, Integer> data = new HashMap<>();
+
+    public void recordQueenCells(String hiveName, int queenCells) {
+        data.put(hiveName, queenCells);
+    }
+
+    public boolean isLikelyToSwarm(String hiveName) {
+        return data.getOrDefault(hiveName, 0) > 0;
+    }
+}
