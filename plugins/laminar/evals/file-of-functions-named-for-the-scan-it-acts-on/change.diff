+import { ScanRecord } from "./ScanRecord";
+
+export const readParcelScan = (barcodeText: string, scannedAt: Date): ScanRecord => {
+  const [parcelId, depotCode] = barcodeText.split("|");
+  return { parcelId, depotCode, scannedAt };
+};
+
+export const formatParcelScan = (scan: ScanRecord): string => `${scan.parcelId} scanned at ${scan.depotCode} on ${scan.scannedAt.toISOString()}`;
+
+export const isScannedAfterCutoff = (scan: ScanRecord, cutoffHour: number): boolean => scan.scannedAt.getHours() >= cutoffHour;
