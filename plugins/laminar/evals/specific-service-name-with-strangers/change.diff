+package com.example.shop.recommendation;
+
+import com.example.shop.catalog.Product;
+import com.example.shop.margin.MarginReport;
+import com.example.shop.search.SearchIndex;
+import com.example.shop.stock.RestockAlert;
+import com.example.shop.stock.StockAlertMailer;
+import java.util.List;
+import java.util.Map;
+import lombok.RequiredArgsConstructor;
+
+@RequiredArgsConstructor
+public class ProductRecommendationService {
+
+    private final PurchaseSimilarity purchaseSimilarity;
+    private final SearchIndex searchIndex;
+    private final StockAlertMailer stockAlertMailer;
+    private final MarginReport marginReport;
+
+    public List<Product> recommendForCustomer(Long customerId) {
+        return purchaseSimilarity.productsBoughtByCustomersLike(customerId);
+    }
+
+    public void indexProductForSearch(Product product) {
+        searchIndex.index(product);
+    }
+
+    public void sendRestockAlert(Long productId, int threshold) {
+        stockAlertMailer.send(new RestockAlert(productId, threshold));
+    }
+
+    public Map<String, Double> calculateCategoryMargins(String category) {
+        return marginReport.marginByProductNameIn(category);
+    }
+}
