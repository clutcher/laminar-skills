+package com.example.shop.notification;
+
+import com.example.shop.mail.EmailService;
+import com.example.shop.user.NotificationPreferences;
+import com.example.shop.user.User;
+import com.example.shop.user.UserRepository;
+import lombok.RequiredArgsConstructor;
+
+@RequiredArgsConstructor
+class NotificationService {
+    private final UserRepository userRepository;
+    private final EmailService emailService;
+
+    public boolean notifyUser(long userId, String message) {
+        User user = userRepository.findById(userId);
+        if (user == null) {
+            return false;
+        }
+
+        NotificationPreferences notificationPreferences = user.getPreferences();
+        if (notificationPreferences == null
+                || !notificationPreferences.isEmailEnabled()) {
+            return false;
+        }
+
+        String emailAddress = user.getEmailAddress();
+        if (emailAddress == null || emailAddress.isBlank()) {
+            return false;
+        }
+
+        return emailService.send(emailAddress, message);
+    }
+}
