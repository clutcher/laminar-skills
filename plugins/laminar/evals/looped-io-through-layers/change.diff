     public boolean accepts(Parcel parcel) {
         return parcel.weightGrams() <= weightLimits.get(parcel.size());
     }
+
+    public List<Parcel> overweightParcels(List<Parcel> parcels) {
+        List<Parcel> overweight = new ArrayList<>();
+        for (Parcel parcel : parcels) {
+            if (!accepts(parcel)) {
+                overweight.add(parcel);
+            }
+        }
+        return overweight;
+    }
