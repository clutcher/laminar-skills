@@ -0,0 +1,16 @@
+package org.lockerpost.lockers.slot;
+
+public class StoredSlotFinder implements SlotFinder {
+
+    private final LockerSlotRepository lockerSlots;
+
+    public StoredSlotFinder(LockerSlotRepository lockerSlots) {
+        this.lockerSlots = lockerSlots;
+    }
+
+    @Override
+    public LockerSlot freeSlotOf(SlotSize size) {
+        return lockerSlots.findFirstBySizeAndOccupiedFalse(size)
+                .orElseThrow(() -> new NoFreeSlotException(size));
+    }
+}
