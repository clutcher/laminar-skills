@@ -0,0 +1,26 @@
+package org.lockerpost.lockers.slot;
+
+import java.util.function.Predicate;
+
+public class SlotCriteria {
+
+    private Predicate<LockerSlot> condition = slot -> true;
+
+    public static SlotCriteria select() {
+        return new SlotCriteria();
+    }
+
+    public SlotCriteria whereSize(SlotSize size) {
+        condition = condition.and(slot -> slot.size() == size);
+        return this;
+    }
+
+    public SlotCriteria whereFree() {
+        condition = condition.and(slot -> !slot.occupied());
+        return this;
+    }
+
+    public Predicate<LockerSlot> build() {
+        return condition;
+    }
+}
