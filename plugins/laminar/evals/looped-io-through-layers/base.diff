+package org.lockerpost.lockers.intake;
+
+import org.lockerpost.lockers.assignment.Parcel;
+import org.lockerpost.lockers.slot.SlotWeightLimitCache;
+
+public class ParcelIntake {
+
+    private final SlotWeightLimitCache weightLimits;
+
+    public ParcelIntake(SlotWeightLimitCache weightLimits) {
+        this.weightLimits = weightLimits;
+    }
+
+    public boolean accepts(Parcel parcel) {
+        return parcel.weightGrams() <= weightLimits.get(parcel.size());
+    }
+}
