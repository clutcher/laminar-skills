@@ -0,0 +1,18 @@
+package org.lockerpost.lockers.slot;
+
+import org.lockerpost.lockers.assignment.Assignment;
+import org.lockerpost.lockers.assignment.Parcel;
+
+public class SlotReservation {
+
+    private final SlotFinder slotFinder;
+
+    public SlotReservation(SlotFinder slotFinder) {
+        this.slotFinder = slotFinder;
+    }
+
+    public Assignment reserveFor(Parcel parcel) {
+        LockerSlot slot = slotFinder.freeSlotOf(parcel.size());
+        return new Assignment(parcel.trackingCode(), slot.lockerCode(), slot.number());
+    }
+}
