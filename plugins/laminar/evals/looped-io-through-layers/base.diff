@@ -0,0 +1,19 @@
+package org.lockerpost.lockers.slot;
+
+import java.util.EnumMap;
+import java.util.Map;
+
+public class SlotWeightLimitCache {
+
+    private final Map<SlotSize, Integer> limitGrams = new EnumMap<>(SlotSize.class);
+
+    public SlotWeightLimitCache() {
+        limitGrams.put(SlotSize.SMALL, 5_000);
+        limitGrams.put(SlotSize.MEDIUM, 15_000);
+        limitGrams.put(SlotSize.LARGE, 30_000);
+    }
+
+    public int get(SlotSize size) {
+        return limitGrams.get(size);
+    }
+}
