+package org.lockerpost.lockers.slot;
+
+import java.util.List;
+
+public class SlotAvailability {
+
+    public long freeSlotsOf(SlotSize size, List<LockerSlot> slots) {
+        return slots.stream()
+                .filter(SlotCriteria.select().whereSize(size).whereFree().build())
+                .count();
+    }
+}
