--- /dev/null
+++ b/allotments/lease_store.py
@@ -0,0 +1,16 @@
+from datetime import date
+
+from sqlalchemy import update
+from sqlalchemy.orm import Session
+
+from allotments.plot_lease import PlotLease
+
+
+class LeaseStore:
+    def __init__(self, session: Session):
+        self._session = session
+
+    def move_end_date(self, plot_number: str, ends_on: date) -> None:
+        self._session.execute(
+            update(PlotLease).where(PlotLease.plot_number == plot_number).values(ends_on=ends_on)
+        )
