+package com.shop.order.payment;
+
+import java.math.BigDecimal;
+
+public class PaymentRetryService {
+
+    private final PaymentService paymentService;
+
+    public PaymentRetryService(PaymentService paymentService) {
+        this.paymentService = paymentService;
+    }
+
+    public String retryFailedPayment(String orderId, BigDecimal amount) {
+        return paymentService.chargeOrder(orderId, amount);
+    }
+}
diff --git a/scripts/backfill-order-totals.py b/scripts/backfill-order-totals.py
new file mode 100644
index 0000000..6c691f2
--- /dev/null
+++ b/scripts/backfill-order-totals.py
@@ -0,0 +1,17 @@
+import csv
+import sys
+
+
+def order_total(unit_price, quantity):
+    return unit_price * quantity
+
+
+def with_order_totals(rows):
+    return [{**row, "order_total": order_total(float(row["unit_price"]), int(row["quantity"]))} for row in rows]
+
+
+if __name__ == "__main__":
+    reader = csv.DictReader(sys.stdin)
+    writer = csv.DictWriter(sys.stdout, fieldnames=reader.fieldnames + ["order_total"])
+    writer.writeheader()
+    writer.writerows(with_order_totals(reader))
