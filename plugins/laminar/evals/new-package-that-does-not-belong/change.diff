+package com.shop.inventory;
+
+import java.util.HashMap;
+import java.util.Map;
+
+public class StockService {
+
+    private final Map<String, Integer> unitsInStockBySku = new HashMap<>();
+
+    public int unitsInStock(String sku) {
+        return unitsInStockBySku.getOrDefault(sku, 0);
+    }
+}
