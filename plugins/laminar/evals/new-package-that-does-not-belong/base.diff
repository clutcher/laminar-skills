diff --git a/scripts/export-orders.py b/scripts/export-orders.py
new file mode 100644
index 0000000..fcdab25
--- /dev/null
+++ b/scripts/export-orders.py
@@ -0,0 +1,9 @@
+import csv
+import sys
+
+
+def export_orders(orders):
+    writer = csv.writer(sys.stdout)
+    writer.writerow(["order_id", "customer_id", "order_total"])
+    for order in orders:
+        writer.writerow([order["order_id"], order["customer_id"], order["order_total"]])
