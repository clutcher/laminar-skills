@@ -0,0 +1,17 @@
+from decimal import Decimal
+
+from freight_rating.domain.models import Rating, SurchargeNote
+from freight_rating.domain.surcharge_rules import SurchargeRules
+from freight_rating.ports.booking_charges import BookingCharges
+
+
+class BookingChargesService(BookingCharges):
+    def __init__(self, surcharge_rules: SurchargeRules):
+        self._surcharge_rules = surcharge_rules
+
+    def total_charge(self, leg_ratings: list[Rating]) -> Decimal:
+        return sum((rating.total_charge for rating in leg_ratings if rating is not None), Decimal("0"))
+
+    def surcharge_notes(self, leg_ratings: list[Rating]) -> list[SurchargeNote]:
+        leg_charges = [rating.leg_charges[0] for rating in leg_ratings if rating is not None]
+        return self._surcharge_rules.notes_for(leg_charges, self.total_charge(leg_ratings))
