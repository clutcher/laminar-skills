diff --git a/warehouse/src/warehouse/shipping/picking.py b/warehouse/src/warehouse/shipping/picking.py
new file mode 100644
--- /dev/null
+++ b/warehouse/src/warehouse/shipping/picking.py
@@ -0,0 +1,13 @@
+from warehouse.inventory.summaries import BinSummary
+
+
+def units_to_pick(summaries: list[BinSummary], wanted_units: int) -> list[tuple[str, int]]:
+    picks = []
+    remaining_units = wanted_units
+    for summary in summaries:
+        if remaining_units == 0:
+            break
+        taken_units = min(summary.stored_units, remaining_units)
+        picks.append((summary.code, taken_units))
+        remaining_units -= taken_units
+    return picks
