diff --git a/warehouse/src/warehouse/inventory/api.py b/warehouse/src/warehouse/inventory/api.py
new file mode 100644
--- /dev/null
+++ b/warehouse/src/warehouse/inventory/api.py
@@ -0,0 +1,19 @@
+from warehouse.inventory.bin_store import BinStore
+from warehouse.inventory.models import Bin
+from warehouse.inventory.summaries import BinSummary
+
+
+def bins_in_aisle(store: BinStore, aisle: str) -> list[BinSummary]:
+    return [summary_of(bin_) for bin_ in store.bins_in_aisle(aisle)]
+
+
+def record_bin(store: BinStore, summary: BinSummary) -> None:
+    store.save(bin_of(summary))
+
+
+def summary_of(bin_: Bin) -> BinSummary:
+    return BinSummary(code=bin_.code, aisle=bin_.aisle, capacity=bin_.capacity, stored_units=bin_.stored_units)
+
+
+def bin_of(summary: BinSummary) -> Bin:
+    return Bin(code=summary.code, aisle=summary.aisle, capacity=summary.capacity, stored_units=summary.stored_units)
diff --git a/warehouse/src/warehouse/inventory/bin_store.py b/warehouse/src/warehouse/inventory/bin_store.py
new file mode 100644
--- /dev/null
+++ b/warehouse/src/warehouse/inventory/bin_store.py
@@ -0,0 +1,12 @@
+from warehouse.inventory.models import Bin
+
+
+class BinStore:
+    def __init__(self):
+        self._bins: dict[str, Bin] = {}
+
+    def save(self, bin_: Bin) -> None:
+        self._bins[bin_.code] = bin_
+
+    def bins_in_aisle(self, aisle: str) -> list[Bin]:
+        return [bin_ for bin_ in self._bins.values() if bin_.aisle == aisle]
diff --git a/warehouse/src/warehouse/inventory/models.py b/warehouse/src/warehouse/inventory/models.py
