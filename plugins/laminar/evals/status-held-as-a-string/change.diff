+package com.example.harbourferry.crossing;
+
+public class Crossing {
+
+    private final String route;
+    private final String status;
+
+    public Crossing(String route, String status) {
+        this.route = route;
+        this.status = status;
+    }
+
+    public String route() {
+        return route;
+    }
+
+    public boolean isOpenForBoarding() {
+        return status.equals("BOARDING");
+    }
+
+    public boolean hasLeftPort() {
+        return status.equals("DEPARTED") || status.equals("ARRIVED");
+    }
+}
