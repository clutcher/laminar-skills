@@ -0,0 +1,28 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Kennel\Boarding\Out\Db;
+
+use Kennel\Boarding\App\Domain\Model\Stay;
+use Kennel\Boarding\App\Spi\KennelRuns;
+use PDO;
+
+final class KennelRunsUsingPdo implements KennelRuns
+{
+    public function __construct(private readonly PDO $pdo)
+    {
+    }
+
+    public function freeRunOn(string $arrival, int $nights): int
+    {
+        $query = $this->pdo->prepare('select min(run_number) from free_run where day = ?');
+        $query->execute([$arrival]);
+        return (int) $query->fetchColumn();
+    }
+
+    public function reserve(Stay $stay): void
+    {
+        $this->pdo->prepare('insert into stay values (?, ?, ?, ?)')->execute([$stay->dogId, $stay->arrival, $stay->nights, $stay->runNumber]);
+    }
+}
