+<?php
+
+declare(strict_types=1);
+
+namespace Kennel\Boarding\In\Http;
+
+use Kennel\Boarding\App\Api\BookStay;
+
+final class StayController
+{
+    public function __construct(private readonly BookStay $bookStay)
+    {
+    }
+
+    public function book(array $request): array
+    {
+        $stay = $this->bookStay->book($request['dogId'], $request['arrival'], (int) $request['nights']);
+        return ['run' => $stay->runNumber];
+    }
+}
