@@ -0,0 +1,23 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Kennel\Boarding\App\Domain;
+
+use Kennel\Boarding\App\Api\BookStay;
+use Kennel\Boarding\App\Domain\Model\Stay;
+use Kennel\Boarding\App\Spi\KennelRuns;
+
+final class StayBookingService implements BookStay
+{
+    public function __construct(private readonly KennelRuns $kennelRuns)
+    {
+    }
+
+    public function book(string $dogId, string $arrival, int $nights): Stay
+    {
+        $stay = new Stay($dogId, $arrival, $nights, $this->kennelRuns->freeRunOn($arrival, $nights));
+        $this->kennelRuns->reserve($stay);
+        return $stay;
+    }
+}
