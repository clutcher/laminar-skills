index 0000000..c70d161
--- /dev/null
+++ b/kennel/src/Boarding/App/Domain/VaccinationRecordsInMemory.php
@@ -0,0 +1,22 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Kennel\Boarding\App\Domain;
+
+use Kennel\Boarding\App\Spi\VaccinationRecords;
+
+final class VaccinationRecordsInMemory implements VaccinationRecords
+{
+    private array $validUntilByDog = [];
+
+    public function record(string $dogId, string $validUntil): void
+    {
+        $this->validUntilByDog[$dogId] = $validUntil;
+    }
+
+    public function isVaccinatedOn(string $dogId, string $day): bool
+    {
+        return isset($this->validUntilByDog[$dogId]) && $this->validUntilByDog[$dogId] >= $day;
+    }
+}
