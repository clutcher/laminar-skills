new file mode 100644
--- /dev/null
+++ b/shop/src/main/java/com/example/shop/shipping/ShipmentService.java
@@ -0,0 +1,18 @@
+package com.example.shop.shipping;
+
+import lombok.RequiredArgsConstructor;
+
+@RequiredArgsConstructor
+public class ShipmentService {
+
+    private final RateCalculator rateCalculator;
+
+    public Shipment createShipment(String street, String city,
+            String postalCode, String country,
+            double weight, String carrier,
+            boolean isFragile) {
+        Address destination = new Address(street, city, postalCode, country);
+        ShippingRate rate = rateCalculator.calculate(destination, weight, carrier);
+        return new Shipment(destination, rate, isFragile);
+    }
+}
