+package com.example.shop.shipping;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class ShipmentServiceTest {
+
+    @Test
+    void shouldCreateAShipmentToTheAddressItIsGiven() {
+        // given
+        ShipmentService shipmentService = new ShipmentService(new FlatRateCalculator());
+
+        // when
+        Shipment shipment = shipmentService.createShipment("Main St", "Berlin", "10115", "DE", 2.5, "DHL", true);
+
+        // then
+        assertThat(shipment.getDestination()).isEqualTo(new Address("Main St", "Berlin", "10115", "DE"));
+    }
+}
