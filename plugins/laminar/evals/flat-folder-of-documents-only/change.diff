@@ -0,0 +1,18 @@
+import { Parcel } from "../parcels/Parcel";
+import { DriverManifest } from "./DriverManifest";
+import { DeliveryNote } from "./DeliveryNote";
+import { CustomsDeclaration } from "./CustomsDeclaration";
+
+export class PrintStep {
+  constructor(
+    private readonly driverManifest: DriverManifest,
+    private readonly deliveryNote: DeliveryNote,
+    private readonly customsDeclaration: CustomsDeclaration,
+  ) {}
+
+  printRouteDocuments(routeId: string, parcels: Parcel[]): string[] {
+    const notes = parcels.map(parcel => this.deliveryNote.print(parcel));
+    const declarations = parcels.filter(parcel => parcel.declaredValueEuros > 0).map(parcel => this.customsDeclaration.print(parcel));
+    return [this.driverManifest.print(routeId, parcels), ...notes, ...declarations];
+  }
+}
