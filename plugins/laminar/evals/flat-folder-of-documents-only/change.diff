+import { Parcel } from "../parcels/Parcel";
+
+export class CustomsDeclaration {
+  print(parcel: Parcel): string {
+    return [`Customs declaration for ${parcel.parcelId}`, `Declared value: ${parcel.declaredValueEuros.toFixed(2)} EUR`].join("\n");
+  }
+}
