+package com.example.loans.app.services;
+
+import com.example.loans.app.api.ReaderActivityAggregation;
+import com.example.loans.app.domain.ActivityEntry;
+import com.example.loans.app.domain.Loan;
+import com.example.loans.app.domain.Reservation;
+import com.example.loans.app.spi.LoanRecords;
+import com.example.loans.app.spi.ReservationRecords;
+import java.util.Comparator;
+import java.util.List;
+import java.util.stream.Stream;
+import org.springframework.stereotype.Service;
+
+@Service
+public class ReaderActivityAggregationService implements ReaderActivityAggregation {
+
+    private final LoanRecords loanRecords;
+    private final ReservationRecords reservationRecords;
+
+    public ReaderActivityAggregationService(LoanRecords loanRecords, ReservationRecords reservationRecords) {
+        this.loanRecords = loanRecords;
+        this.reservationRecords = reservationRecords;
+    }
+
+    @Override
+    public List<ActivityEntry> combinedActivityOf(String readerId) {
+        Stream<ActivityEntry> loans = loanRecords.openLoansOf(readerId).stream().map(this::dueBackEntryOf);
+        Stream<ActivityEntry> reservations = reservationRecords.activeReservationsOf(readerId).stream().map(this::reservedEntryOf);
+        return Stream.concat(loans, reservations)
+                .sorted(Comparator.comparing(ActivityEntry::happenedOn))
+                .toList();
+    }
+
+    private ActivityEntry dueBackEntryOf(Loan loan) {
+        return new ActivityEntry(loan.dueOn(), loan.title(), "Due back");
+    }
+
+    private ActivityEntry reservedEntryOf(Reservation reservation) {
+        return new ActivityEntry(reservation.reservedOn(), reservation.title(), "Reserved, place " + reservation.queuePosition() + " in the queue");
+    }
+}
