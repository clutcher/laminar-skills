+package com.example.loans.out;
+
+import com.example.loans.app.domain.Reservation;
+import com.example.loans.app.spi.ReservationRecords;
+import java.util.List;
+import org.springframework.jdbc.core.simple.JdbcClient;
+import org.springframework.stereotype.Repository;
+
+@Repository
+public class JdbcReservationRecords implements ReservationRecords {
+
+    private final JdbcClient jdbcClient;
+
+    public JdbcReservationRecords(JdbcClient jdbcClient) {
+        this.jdbcClient = jdbcClient;
+    }
+
+    @Override
+    public List<Reservation> activeReservationsOf(String readerId) {
+        return jdbcClient.sql("""
+                        select title, reserved_on, queue_position
+                        from reservation
+                        where reader_id = :readerId and collected_on is null
+                        """)
+                .param("readerId", readerId)
+                .query(Reservation.class)
+                .list();
+    }
+}
