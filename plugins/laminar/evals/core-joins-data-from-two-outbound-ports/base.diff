+++ b/loans-service/src/main/java/com/example/loans/app/services/LoanOverviewService.java
@@ -0,0 +1,25 @@
+package com.example.loans.app.services;
+
+import com.example.loans.app.api.LoanOverview;
+import com.example.loans.app.domain.Loan;
+import com.example.loans.app.spi.LoanRecords;
+import java.util.Comparator;
+import java.util.List;
+import org.springframework.stereotype.Service;
+
+@Service
+public class LoanOverviewService implements LoanOverview {
+
+    private final LoanRecords loanRecords;
+
+    public LoanOverviewService(LoanRecords loanRecords) {
+        this.loanRecords = loanRecords;
+    }
+
+    @Override
+    public List<Loan> openLoansOf(String readerId) {
+        return loanRecords.openLoansOf(readerId).stream()
+                .sorted(Comparator.comparing(Loan::dueOn))
+                .toList();
+    }
+}
