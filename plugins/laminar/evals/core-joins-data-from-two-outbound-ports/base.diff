+package com.example.loans.in;
+
+import com.example.loans.app.api.LoanOverview;
+import com.example.loans.app.domain.Loan;
+import java.util.List;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+public class ReaderController {
+
+    private final LoanOverview loanOverview;
+
+    public ReaderController(LoanOverview loanOverview) {
+        this.loanOverview = loanOverview;
+    }
+
+    @GetMapping("/readers/{readerId}/loans")
+    public List<Loan> openLoans(@PathVariable String readerId) {
+        return loanOverview.openLoansOf(readerId);
+    }
+}
