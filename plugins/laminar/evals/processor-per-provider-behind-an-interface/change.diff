+package com.example.shop.payment;
+
+import com.example.shop.order.Order;
+import lombok.RequiredArgsConstructor;
+
+@RequiredArgsConstructor
+class CyberSourcePaymentProcessor implements PaymentProcessor {
+
+    private final CyberSourceClient cybersource;
+
+    public boolean supports(PaymentProvider provider) {
+        return provider == PaymentProvider.CYBERSOURCE;
+    }
+
+    public void charge(Order order) {
+        cybersource.createPayment(order.getNumber(), order.getTotal());
+    }
+
+    public void refund(Order order, double amount) {
+        cybersource.refundPayment(order.getTransactionId(), amount);
+    }
+}
