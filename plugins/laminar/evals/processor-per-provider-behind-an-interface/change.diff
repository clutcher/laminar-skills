+package com.example.shop.payment;
+
+import com.example.shop.order.Order;
+import java.util.List;
+import lombok.RequiredArgsConstructor;
+
+@RequiredArgsConstructor
+public class PaymentService {
+
+    private final List<PaymentProcessor> processors;
+
+    public void chargePayment(Order order) {
+        findProcessor(order.getPaymentProvider()).charge(order);
+    }
+
+    public void refundPayment(Order order, double amount) {
+        findProcessor(order.getPaymentProvider()).refund(order, amount);
+    }
+
+    PaymentProcessor findProcessor(PaymentProvider provider) {
+        for (PaymentProcessor processor : processors) {
+            if (processor.supports(provider)) {
+                return processor;
+            }
+        }
+        throw new UnsupportedPaymentProviderException(provider);
+    }
+}
