@@ -0,0 +1,14 @@
+import { FineMember } from "../api/fine-member";
+import { OverdueLoans } from "../spi/overdue-loans";
+
+export class FineService implements FineMember {
+  constructor(private readonly overdueLoans: OverdueLoans) {}
+
+  async fineOf(memberId: string, today: Date): Promise<number> {
+    const loans = await this.overdueLoans.loansOfMember(memberId);
+    return loans
+      .map(loan => Math.floor((today.getTime() - loan.dueOn.getTime()) / 86400000))
+      .filter(daysOverdue => daysOverdue > 0)
+      .reduce((fine, daysOverdue) => fine + daysOverdue * 20, 0);
+  }
+}
