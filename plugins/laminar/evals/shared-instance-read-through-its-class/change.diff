--- /dev/null
+++ b/apiary/src/main/java/com/example/apiary/inspections/HiveSpaceAlert.java
@@ -0,0 +1,14 @@
+package com.example.apiary.inspections;
+
+public class HiveSpaceAlert {
+
+    private final int framesPerBox;
+
+    public HiveSpaceAlert(int framesPerBox) {
+        this.framesPerBox = framesPerBox;
+    }
+
+    public boolean needsAnotherBox(HiveInspection inspection) {
+        return OccupiedFrameCounter.INSTANCE.occupiedFramesOf(inspection) >= framesPerBox;
+    }
+}
