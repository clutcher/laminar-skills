+package com.example.shop.access;
+
+public class ResourceActions {
+
+    public void performAction(User user, String action, Resource resource) {
+        if (user != null) {
+            if (user.isActive()) {
+                if (user.hasPermission(action)) {
+                    if (resource.isAvailable()) {
+                        resource.perform(action);
+                    }
+                }
+            }
+        }
+    }
+}
