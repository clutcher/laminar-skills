@@ -0,0 +1,10 @@
+import { Router } from "express";
+import { RentBike } from "../../app/api/rent-bike";
+
+export function rentalRoutes(rentBike: RentBike): Router {
+  const router = Router();
+  router.post("/rentals", async (request, response) => {
+    response.json({ rentalId: await rentBike.rent(request.body.bikeId, request.body.riderId) });
+  });
+  return router;
+}
