+import { InvoiceRider } from "../api/invoice-rider";
+import { RiderRentals } from "../spi/rider-rentals";
+
+export class InvoiceService implements InvoiceRider {
+  constructor(private readonly riderRentals: RiderRentals) {}
+
+  async invoiceOf(riderId: string): Promise<number> {
+    const rentals = await this.riderRentals.rentalCountOf(riderId);
+    return rentals * 250;
+  }
+}
