@@ -0,0 +1,12 @@
+export class Rental {
+  constructor(
+    readonly rentalId: string,
+    readonly bikeId: string,
+    readonly riderId: string,
+    readonly startedAt: Date,
+  ) {}
+
+  minutesUntil(endedAt: Date): number {
+    return Math.ceil((endedAt.getTime() - this.startedAt.getTime()) / 60000);
+  }
+}
