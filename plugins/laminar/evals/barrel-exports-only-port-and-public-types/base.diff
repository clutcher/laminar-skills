@@ -0,0 +1,11 @@
+import { BikeStore } from "../../app/spi/bike-store";
+import { PublicRental } from "./public-rental";
+
+export class RentalLookup {
+  constructor(private readonly bikeStore: BikeStore) {}
+
+  async rentalsOfRider(riderId: string): Promise<PublicRental[]> {
+    const rentals = await this.bikeStore.rentalsOfRider(riderId);
+    return rentals.map(rental => ({ rentalId: rental.rentalId, bikeId: rental.bikeId, startedAt: rental.startedAt.toISOString() }));
+  }
+}
