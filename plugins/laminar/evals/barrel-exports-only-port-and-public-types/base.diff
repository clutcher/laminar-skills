@@ -0,0 +1,13 @@
+import { RentBike } from "../api/rent-bike";
+import { BikeStore } from "../spi/bike-store";
+import { Rental } from "./model/rental";
+
+export class RentalService implements RentBike {
+  constructor(private readonly bikeStore: BikeStore) {}
+
+  async rent(bikeId: string, riderId: string): Promise<string> {
+    const rental = new Rental(`${bikeId}-${Date.now()}`, bikeId, riderId, new Date());
+    await this.bikeStore.saveRental(rental);
+    return rental.rentalId;
+  }
+}
