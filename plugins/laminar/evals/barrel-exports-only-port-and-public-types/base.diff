index 0000000..1a3e22b
--- /dev/null
+++ b/bikes/src/rental/out/db/bike-store-using-sql.ts
@@ -0,0 +1,19 @@
+import { Rental } from "../../app/domain/model/rental";
+import { BikeStore } from "../../app/spi/bike-store";
+
+export interface SqlClient {
+  query(sql: string, values: unknown[]): Promise<Record<string, unknown>[]>;
+}
+
+export class BikeStoreUsingSql implements BikeStore {
+  constructor(private readonly sql: SqlClient) {}
+
+  async saveRental(rental: Rental): Promise<void> {
+    await this.sql.query("insert into rental values ($1, $2, $3, $4)", [rental.rentalId, rental.bikeId, rental.riderId, rental.startedAt]);
+  }
+
+  async rentalsOfRider(riderId: string): Promise<Rental[]> {
+    const rows = await this.sql.query("select * from rental where rider_id = $1", [riderId]);
+    return rows.map(row => new Rental(String(row.rental_id), String(row.bike_id), riderId, new Date(String(row.started_at))));
+  }
+}
