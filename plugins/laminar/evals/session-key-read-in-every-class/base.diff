+package com.example.shop.quote;
+
+import com.example.shop.b2b.B2BUnitModel;
+import com.example.shop.session.SessionService;
+import lombok.RequiredArgsConstructor;
+
+@RequiredArgsConstructor
+public class QuotePricing {
+
+    private static final String CURRENT_B2B_UNIT = "currentB2BUnit";
+
+    private final SessionService sessionService;
+
+    public double calculateQuoteDiscount(Quote quote) {
+        B2BUnitModel unit = (B2BUnitModel) sessionService.getAttribute(CURRENT_B2B_UNIT);
+        if (unit != null && unit.hasFrameworkContract()) {
+            return quote.getTotal() * 0.05;
+        }
+        return 0;
+    }
+}
