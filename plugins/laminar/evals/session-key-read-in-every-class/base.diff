+package com.example.shop.checkout;
+
+import com.example.shop.b2b.B2BUnitModel;
+import com.example.shop.b2b.GlobalConstants;
+import com.example.shop.session.SessionService;
+import lombok.RequiredArgsConstructor;
+
+@RequiredArgsConstructor
+public class DeliveryOptions {
+
+    private final SessionService sessionService;
+
+    public boolean offersNextDayDelivery() {
+        B2BUnitModel unit = (B2BUnitModel) sessionService.getAttribute(
+            GlobalConstants.CURRENT_B2B_UNIT_SESSION_ATTRIBUTE_KEY);
+        return unit != null && unit.hasNextDayContract();
+    }
+}
