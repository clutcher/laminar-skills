diff --git a/library/src/main/java/com/example/library/loan/RequestedLoanLength.java b/library/src/main/java/com/example/library/loan/RequestedLoanLength.java
new file mode 100644
--- /dev/null
+++ b/library/src/main/java/com/example/library/loan/RequestedLoanLength.java
@@ -0,0 +1,26 @@
+package com.example.library.loan;
+
+import java.util.Optional;
+
+final class RequestedLoanLength {
+
+    private static final int DAYS_PER_WEEK = 7;
+
+    private RequestedLoanLength() {
+    }
+
+    static Optional<LoanPeriod> from(CheckoutRequest request) {
+        return inWeeks(request.getRequestedWeeks());
+    }
+
+    static Optional<LoanPeriod> from(RenewalRequest request) {
+        return inWeeks(request.getRequestedWeeks());
+    }
+
+    private static Optional<LoanPeriod> inWeeks(Integer weeks) {
+        if (weeks == null) {
+            return Optional.empty();
+        }
+        return Optional.of(new LoanPeriod(weeks * DAYS_PER_WEEK));
+    }
+}
