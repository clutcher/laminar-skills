 package com.example.library.loan;
 
 import java.time.LocalDate;
+import java.util.Optional;
 
 public record LoanPeriod(int days) {
 
     private static final int STANDARD_DAYS = 21;
+    private static final String CHOSEN_PERIOD = "chosenLoanPeriod";
 
     public static LoanPeriod resolve(CirculationSession session, CheckoutRequest request) {
-        return new LoanPeriod(STANDARD_DAYS);
+        return from(session).or(() -> RequestedLoanLength.from(request)).orElseGet(LoanPeriod::standard);
