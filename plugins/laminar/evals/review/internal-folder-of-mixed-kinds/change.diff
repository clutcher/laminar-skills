+package com.example.website.consignment.internal;
+
+import java.util.List;
+import org.springframework.stereotype.Service;
+
+@Service
+public class SplitConsignmentService {
+
+    private final ConsignmentRepository consignmentRepository;
+    private final WarehouseRepository warehouseRepository;
+
+    public SplitConsignmentService(ConsignmentRepository consignmentRepository, WarehouseRepository warehouseRepository) {
+        this.consignmentRepository = consignmentRepository;
+        this.warehouseRepository = warehouseRepository;
+    }
+
+    public List<Consignment> splitIntoConsignments(Long orderId) {
+        return warehouseRepository.findAll().stream()
+                .map(warehouse -> consignmentRepository.save(new Consignment(orderId, warehouse.getId())))
+                .toList();
+    }
+}
