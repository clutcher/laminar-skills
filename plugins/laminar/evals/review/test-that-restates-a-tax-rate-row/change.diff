+package com.example.shop.tax;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class TaxRateTableTest {
+
+    private final TaxRateTable taxRateTable = new TaxRateTable();
+
+    @Test
+    void shouldReturnNineteenPercentWhenCountryIsGermany() {
+        // given
+        String germanCountryCode = "DE";
+
+        // when
+        double taxRate = taxRateTable.getTaxRate(germanCountryCode);
+
+        // then
+        assertThat(taxRate).isEqualTo(0.19);
+    }
+}
