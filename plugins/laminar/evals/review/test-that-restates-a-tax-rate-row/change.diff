+++ b/shop/src/main/java/com/example/shop/tax/TaxRateTable.java
@@ -0,0 +1,20 @@
+package com.example.shop.tax;
+
+import java.util.Map;
+
+public class TaxRateTable {
+
+    private static final Map<String, Double> TAX_RATE_BY_COUNTRY_CODE_MAP = Map.of(
+            "AT", 0.20,
+            "DE", 0.19,
+            "FR", 0.20,
+            "NL", 0.21);
+
+    public double getTaxRate(String countryCode) {
+        Double taxRate = TAX_RATE_BY_COUNTRY_CODE_MAP.get(countryCode);
+        if (taxRate == null) {
+            throw new UnknownCountryException(countryCode);
+        }
+        return taxRate;
+    }
+}
