@@ -0,0 +1,35 @@
+package com.example.bikerental.fleet;
+
+public class RentalDesk {
+
+    private final BikesByFrame fleet;
+    private final RentalBikes bikesOnRental;
+
+    public RentalDesk(BikesByFrame fleet, RentalBikes bikesOnRental) {
+        this.fleet = fleet;
+        this.bikesOnRental = bikesOnRental;
+    }
+
+    public Bike handOutBike(String frameNumber) {
+        Bike bike = findBike(frameNumber);
+        bikesOnRental.add(bike);
+        return bike;
+    }
+
+    public void takeBackBike(String frameNumber) {
+        Bike bike = findBike(frameNumber);
+        bikesOnRental.remove(bike);
+    }
+
+    public int countBikesOnRental() {
+        return bikesOnRental.size();
+    }
+
+    private Bike findBike(String frameNumber) {
+        if (!fleet.containsKey(frameNumber)) {
+            throw new UnknownBikeException(frameNumber);
+        }
+
+        return fleet.get(frameNumber);
+    }
+}
