+package com.example.lockerpost.shipment.web;
+
+import com.example.lockerpost.shipment.domain.Carrier;
+import com.example.lockerpost.shipment.domain.Handover;
+import com.example.lockerpost.shipment.domain.LockerSize;
+import com.example.lockerpost.shipment.domain.ServiceLevel;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.ResultActions;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+@SpringBootTest
+@AutoConfigureMockMvc
+class ShipmentBookingControllerTest {
+
+    private static final String CITY_BANK_WITHOUT_SURCHARGE = "LB-CITY-014";
+    private static final String CITY_BANK_WITH_SURCHARGE = "LB-CITY-031";
+    private static final String CITY_BANK_WITH_UNLISTED_PREFIX = "LB-CITY-078";
+    private static final String UNREGISTERED_BANK = "LB-CITY-999";
+
+    @Autowired
+    private MockMvc mockMvc;
+
+    @Test
+    void shouldBookALightParcelIntoASmallLockerOpenedByCode() throws Exception {
+        // given
+        String request = shipmentRequest(CITY_BANK_WITHOUT_SURCHARGE, 800, 2500, ServiceLevel.STANDARD);
+
+        // when
+        ResultActions booking = bookShipment(request);
+
+        // then
+        booking.andExpect(status().isOk())
+            .andExpect(content().json(bookingResponse(LockerSize.SMALL, Handover.CODE, 350, Carrier.CITY_VAN)));
+    }
+
+    @Test
+    void shouldBookAHeavyParcelIntoALargeLockerOpenedByCode() throws Exception {
+        // given
+        String request = shipmentRequest(CITY_BANK_WITHOUT_SURCHARGE, 5400, 2500, ServiceLevel.STANDARD);
+
+        // when
+        ResultActions booking = bookShipment(request);
+
+        // then
+        booking.andExpect(status().isOk())
+            .andExpect(content().json(bookingResponse(LockerSize.LARGE, Handover.CODE, 350, Carrier.CITY_VAN)));
+    }
+
+    @Test
+    void shouldBookAHighValueParcelIntoASmallLockerReleasedOnSignature() throws Exception {
+        // given
+        String request = shipmentRequest(CITY_BANK_WITHOUT_SURCHARGE, 900, 84000, ServiceLevel.STANDARD);
+
+        // when
+        ResultActions booking = bookShipment(request);
+
+        // then
+        booking.andExpect(status().isOk())
+            .andExpect(content().json(bookingResponse(LockerSize.SMALL, Handover.SIGNATURE, 350, Carrier.CITY_VAN)));
+    }
+
+    @Test
+    void shouldChargeTheListedSurchargeOfTheDestinationPostalPrefix() throws Exception {
+        // given
+        String request = shipmentRequest(CITY_BANK_WITH_SURCHARGE, 800, 2500, ServiceLevel.STANDARD);
+
+        // when
+        ResultActions booking = bookShipment(request);
+
+        // then
+        booking.andExpect(status().isOk())
+            .andExpect(content().json(bookingResponse(LockerSize.SMALL, Handover.CODE, 610, Carrier.CITY_VAN)));
+    }
+
+    @Test
+    void shouldChargeTheUnlistedSurchargeWhenTheTableHoldsNoRowForTheDestinationPostalPrefix() throws Exception {
+        // given
+        String request = shipmentRequest(CITY_BANK_WITH_UNLISTED_PREFIX, 800, 2500, ServiceLevel.STANDARD);
+
+        // when
+        ResultActions booking = bookShipment(request);
+
+        // then
+        booking.andExpect(status().isOk())
+            .andExpect(content().json(bookingResponse(LockerSize.SMALL, Handover.CODE, 830, Carrier.CITY_VAN)));
+    }
+
+    @Test
+    void shouldRejectTheShipmentWhenNoLockerBankIsRegisteredAsTheDestination() throws Exception {
+        // given
+        String request = shipmentRequest(UNREGISTERED_BANK, 800, 2500, ServiceLevel.STANDARD);
+
+        // when
+        ResultActions booking = bookShipment(request);
+
+        // then
+        booking.andExpect(status().isUnprocessableEntity())
+            .andExpect(result -> assertThat(result.getResolvedException())
+                .hasMessage("no locker bank is registered as " + UNREGISTERED_BANK));
+    }
+
+    private ResultActions bookShipment(String request) throws Exception {
+        return mockMvc.perform(post("/shipments")
+            .contentType(MediaType.APPLICATION_JSON)
+            .content(request));
+    }
+
+    private static String shipmentRequest(String destinationBankId, int weightGrams, int declaredValueCents, ServiceLevel serviceLevel) {
+        return """
+            {"destinationBankId": "%s", "weightGrams": %d, "declaredValueCents": %d, "serviceLevel": "%s"}
+            """.formatted(destinationBankId, weightGrams, declaredValueCents, serviceLevel);
+    }
+
+    private static String bookingResponse(LockerSize lockerSize, Handover handover, int totalCents, Carrier carrier) {
+        return """
+            {"lockerSize": "%s", "handover": "%s", "totalCents": %d, "carrier": "%s"}
+            """.formatted(lockerSize, handover, totalCents, carrier);
+    }
+}
