+package com.example.lockerpost.shipment.domain;
+
+import org.springframework.stereotype.Component;
+
+@Component
+public class LockerSizeAndHandoverRules {
+
+    public LockerSize lockerSizeFor(ShipmentShape shape) {
+        if (shape == ShipmentShape.HEAVY_PARCEL) {
+            return LockerSize.LARGE;
+        }
+        return LockerSize.SMALL;
+    }
+
+    public Handover handoverFor(ShipmentShape shape) {
+        if (shape == ShipmentShape.HIGH_VALUE_PARCEL) {
+            return Handover.SIGNATURE;
+        }
+        return Handover.CODE;
+    }
+}
