+package com.example.lockerpost.shipment.web;
+
+import com.example.lockerpost.shipment.domain.AdmittedShipment;
+import com.example.lockerpost.shipment.domain.DispatchPlan;
+import com.example.lockerpost.shipment.domain.LockerSizeAndHandoverRules;
+import com.example.lockerpost.shipment.domain.ShipmentAdmission;
+import com.example.lockerpost.shipment.domain.ShipmentBookingResponse;
+import com.example.lockerpost.shipment.domain.ShipmentDispatchPlanner;
+import com.example.lockerpost.shipment.domain.ShipmentPrice;
+import com.example.lockerpost.shipment.domain.ShipmentPricingCalculator;
+import com.example.lockerpost.shipment.domain.ShipmentRequest;
+import com.example.lockerpost.shipment.domain.ValidatedShipment;
+import lombok.RequiredArgsConstructor;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+@RequestMapping("/shipments")
+@RequiredArgsConstructor
+public class ShipmentBookingController {
+
+    private final ShipmentAdmission shipmentAdmission;
+    private final LockerSizeAndHandoverRules lockerSizeAndHandoverRules;
+    private final ShipmentPricingCalculator shipmentPricingCalculator;
+    private final ShipmentDispatchPlanner shipmentDispatchPlanner;
+
+    @PostMapping
+    public ShipmentBookingResponse book(@RequestBody ShipmentRequest request) {
+        AdmittedShipment admittedShipment = shipmentAdmission.admit(request);
+        ValidatedShipment shipment = new ValidatedShipment(
+            request,
+            admittedShipment.destinationBank(),
+            lockerSizeAndHandoverRules.lockerSizeFor(admittedShipment.shape()),
+            lockerSizeAndHandoverRules.handoverFor(admittedShipment.shape()));
+        ShipmentPrice price = shipmentPricingCalculator.priceOf(shipment);
+        DispatchPlan dispatchPlan = shipmentDispatchPlanner.planFor(shipment);
+        return new ShipmentBookingResponse(
+            shipment.lockerSize(),
+            shipment.handover(),
+            price.totalCents(),
+            dispatchPlan.carrier());
+    }
+}
diff --git a/parcel-locker/src/test/java/com/example/lockerpost/shipment/web/ShipmentBookingControllerTest.java b/parcel-locker/src/test/java/com/example/lockerpost/shipment/web/ShipmentBookingControllerTest.java
