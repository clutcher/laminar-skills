+package com.example.lockerpost.shipment.domain;
+
+import com.example.lockerpost.locker.domain.LockerBank;
+import com.example.lockerpost.locker.domain.LockerBankDirectory;
+import lombok.RequiredArgsConstructor;
+import org.springframework.stereotype.Component;
+
+import java.util.Optional;
+
+@Component
+@RequiredArgsConstructor
+public class ShipmentAdmission {
+
+    private static final int LIGHT_PARCEL_MAX_GRAMS = 2000;
+    private static final int HIGH_VALUE_MIN_CENTS = 50000;
+
+    private final LockerBankDirectory lockerBankDirectory;
+
+    public AdmittedShipment admit(ShipmentRequest request) {
+        return new AdmittedShipment(requireRegisteredBank(request.destinationBankId()), shapeOf(request));
+    }
+
+    private LockerBank requireRegisteredBank(String destinationBankId) {
+        return Optional.ofNullable(lockerBankDirectory.findBank(destinationBankId))
+            .orElseThrow(() -> new ShipmentRejected("no locker bank is registered as " + destinationBankId));
+    }
+
+    private ShipmentShape shapeOf(ShipmentRequest request) {
+        if (request.declaredValueCents() >= HIGH_VALUE_MIN_CENTS) {
+            return ShipmentShape.HIGH_VALUE_PARCEL;
+        }
+        if (request.weightGrams() > LIGHT_PARCEL_MAX_GRAMS) {
+            return ShipmentShape.HEAVY_PARCEL;
+        }
+        return ShipmentShape.LIGHT_PARCEL;
+    }
+}
