+package com.example.lockerpost.shipment.domain;
+
+import com.example.lockerpost.locker.domain.DestinationZone;
+import org.springframework.stereotype.Component;
+
+@Component
+public class ShipmentDispatchPlanner {
+
+    public DispatchPlan planFor(ValidatedShipment shipment) {
+        return new DispatchPlan(
+            shipment.destinationBank().bankId(),
+            carrierFor(shipment.zone()),
+            shipment.lockerSize());
+    }
+
+    private Carrier carrierFor(DestinationZone zone) {
+        if (zone == DestinationZone.SUBURBAN) {
+            return Carrier.REGIONAL_ROUTE;
+        }
+        if (zone == DestinationZone.RURAL) {
+            return Carrier.NATIONAL_PARTNER;
+        }
+        return Carrier.CITY_VAN;
+    }
+}
