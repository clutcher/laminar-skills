+package com.example.lockerpost.shipment.domain;
+
+import lombok.RequiredArgsConstructor;
+import org.springframework.stereotype.Component;
+
+@Component
+@RequiredArgsConstructor
+public class ShipmentPricingCalculator {
+
+    private static final int BASE_FEE_CENTS = 350;
+    private static final int STANDARD_SERVICE_FEE_CENTS = 0;
+    private static final int NEXT_DAY_SERVICE_FEE_CENTS = 450;
+    private static final int SAME_DAY_SERVICE_FEE_CENTS = 900;
+
+    private final PostalSurchargeTable postalSurchargeTable;
+
+    public ShipmentPrice priceOf(ValidatedShipment shipment) {
+        int surchargeCents = postalSurchargeTable.surchargeCentsFor(shipment.postalPrefix());
+        int serviceFeeCents = serviceFeeCentsFor(shipment.serviceLevel());
+        return new ShipmentPrice(BASE_FEE_CENTS + surchargeCents + serviceFeeCents, shipment.serviceLevel());
+    }
+
+    private int serviceFeeCentsFor(ServiceLevel serviceLevel) {
+        if (serviceLevel == ServiceLevel.NEXT_DAY) {
+            return NEXT_DAY_SERVICE_FEE_CENTS;
+        }
+        if (serviceLevel == ServiceLevel.SAME_DAY) {
+            return SAME_DAY_SERVICE_FEE_CENTS;
+        }
+        return STANDARD_SERVICE_FEE_CENTS;
+    }
+}
