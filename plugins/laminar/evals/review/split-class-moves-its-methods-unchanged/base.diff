diff --git a/lending/src/main/java/com/example/lending/desk/LoanDesk.java b/lending/src/main/java/com/example/lending/desk/LoanDesk.java
new file mode 100644
index 0000000..c82f318
--- /dev/null
+++ b/lending/src/main/java/com/example/lending/desk/LoanDesk.java
@@ -0,0 +1,76 @@
+package com.example.lending.desk;
+
+import com.example.lending.catalogue.Copy;
+import com.example.lending.loans.Loan;
+import com.example.lending.members.Member;
+import com.example.lending.money.Money;
+
+import java.time.LocalDate;
+import java.time.temporal.ChronoUnit;
+import java.util.ArrayList;
+import java.util.List;
+
+public class LoanDesk {
+
+    public static final int LOAN_DAYS = 21;
+
+    private static final long LATE_FEE_CENTS_PER_DAY = 25;
+
+    private final List<Loan> openLoans = new ArrayList<>();
+
+    public Loan lendCopy(Member member, Copy copy, LocalDate lentOn) {
+        if (!member.canBorrow()) {
+            throw new IllegalStateException("member " + member.cardNumber() + " cannot borrow");
+        }
+
+        Loan loan = new Loan(member, copy, lentOn);
+        openLoans.add(loan);
+        return loan;
+    }
+
+    public void returnCopy(Loan loan) {
+        openLoans.remove(loan);
+    }
+
+    public Loan renewLoan(Loan loan, LocalDate renewedOn) {
+        openLoans.remove(loan);
+        Loan renewed = new Loan(loan.member(), loan.copy(), renewedOn);
+        openLoans.add(renewed);
+        return renewed;
+    }
+
+    public long countOpenLoansOf(Member member) {
+        return openLoans.stream()
+                .filter(loan -> loan.member().equals(member))
+                .count();
+    }
+
+    public LocalDate readDueDate(Loan loan) {
+        return loan.lentOn().plusDays(LoanDesk.LOAN_DAYS);
+    }
+
+    public List<Loan> listOverdueLoans(LocalDate today) {
+        return openLoans.stream()
+                .filter(loan -> readDueDate(loan).isBefore(today))
+                .toList();
+    }
+
+    public Money calculateLateFee(LocalDate dueDate, LocalDate returnedOn) {
+        long daysLate = ChronoUnit.DAYS.between(dueDate, returnedOn);
+        if (daysLate <= 0) {
+            return Money.zero();
+        }
+
+        return Money.ofCents(daysLate * LATE_FEE_CENTS_PER_DAY);
+    }
+
+    public static final class LostCopyCharges {
+
+        private static final long PROCESSING_FEE_CENTS = 500;
+
+        public Money calculateLostCopyCharge(Copy copy) {
+            Money replacementPrice = copy.replacementPrice();
+            return replacementPrice.plus(Money.ofCents(PROCESSING_FEE_CENTS));
+        }
+    }
+}
