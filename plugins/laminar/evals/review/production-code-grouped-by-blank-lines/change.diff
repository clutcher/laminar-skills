+import { Greenhouse } from "./greenhouse";
+import { VentOpening } from "./vent-opening";
+import { VentSchedule } from "./vent-schedule";
+
+export class GreenhouseVentilation {
+  constructor(private readonly ventSchedule: VentSchedule) {}
+
+  openVentsFor(greenhouse: Greenhouse, readingAt: Date): VentOpening {
+    const insideTemperature = greenhouse.readTemperatureAt(readingAt);
+    const targetTemperature = this.ventSchedule.readTargetTemperatureAt(readingAt);
+
+    const degreesTooWarm = insideTemperature - targetTemperature;
+
+    return VentOpening.createForDegreesTooWarm(degreesTooWarm);
+  }
+}
