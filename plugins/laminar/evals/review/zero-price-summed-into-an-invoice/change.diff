+package com.example.bakery.invoicing;
+
+import com.example.bakery.pricing.PriceService;
+import com.example.bakery.pricing.PriceServiceException;
+
+import java.math.BigDecimal;
+import java.util.List;
+
+public class InvoiceBuilder {
+
+    private final PriceService priceService;
+
+    public InvoiceBuilder(PriceService priceService) {
+        this.priceService = priceService;
+    }
+
+    public Invoice createInvoice(String customerId, List<OrderLine> orderLines) {
+        List<Invoice.Line> lines = orderLines.stream()
+                .map(this::createLine)
+                .toList();
+        BigDecimal total = lines.stream()
+                .map(Invoice.Line::amount)
+                .reduce(BigDecimal.ZERO, BigDecimal::add);
+        return new Invoice(customerId, lines, total);
+    }
+
+    private Invoice.Line createLine(OrderLine orderLine) {
+        BigDecimal unitPrice = findUnitPrice(orderLine.productCode());
+        BigDecimal amount = unitPrice.multiply(BigDecimal.valueOf(orderLine.quantity()));
+        return new Invoice.Line(orderLine.productCode(), orderLine.quantity(), unitPrice, amount);
+    }
+
+    private BigDecimal findUnitPrice(String productCode) {
+        try {
+            return priceService.fetchUnitPrice(productCode);
+        } catch (PriceServiceException exception) {
+            return BigDecimal.ZERO;
+        }
+    }
+}
