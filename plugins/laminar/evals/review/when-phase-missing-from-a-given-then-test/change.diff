+package com.example.workshop.repair;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+import org.junit.jupiter.api.Test;
+
+class RepairQuoteTest {
+
+    private final RepairQuote repairQuote = new RepairQuote();
+
+    @Test
+    void shouldAddTheExpressSurchargeWhenTheRiderWantsTheBikeBackTheNextDay() {
+        // given
+        RepairJob innerTubeReplacement = RepairJob.of("Inner tube replacement", Money.euros("18.00"));
+        LocalDate droppedOffOn = LocalDate.of(2026, 5, 12);
+        LocalDate wantedBackOn = LocalDate.of(2026, 5, 13);
+
+        // then
+        assertThat(repairQuote.priceFor(innerTubeReplacement, droppedOffOn, wantedBackOn)).isEqualTo(Money.euros("27.00"));
+    }
+}
