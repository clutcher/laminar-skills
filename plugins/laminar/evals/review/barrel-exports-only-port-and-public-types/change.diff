@@ -0,0 +1,10 @@
+import { PublicRentalReceipt, RentalLookup } from "../../../rental";
+
+export class ChargesUsingRentalModule {
+  constructor(private readonly rentalLookup: RentalLookup) {}
+
+  async chargedCentsOf(riderId: string): Promise<number> {
+    const receipts: PublicRentalReceipt[] = await this.rentalLookup.receiptsOfRider(riderId, new Date());
+    return receipts.reduce((sum, receipt) => sum + receipt.chargedCents, 0);
+  }
+}
