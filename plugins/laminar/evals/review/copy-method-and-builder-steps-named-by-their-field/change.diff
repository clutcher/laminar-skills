@@ -0,0 +1,18 @@
+package com.example.orchard.picking;
+
+import java.time.LocalTime;
+import java.util.List;
+
+public class PickingRoundPlanner {
+
+    private static final LocalTime MORNING_ROUND_START_TIME = LocalTime.of(6, 30);
+
+    public PickingRound planMorningRound(String orchardRow, String picker, List<HarvestCrate> emptyCrates) {
+        return PickingRound.builder()
+            .orchardRow(orchardRow)
+            .picker(picker)
+            .startTime(MORNING_ROUND_START_TIME)
+            .crates(emptyCrates)
+            .build();
+    }
+}
