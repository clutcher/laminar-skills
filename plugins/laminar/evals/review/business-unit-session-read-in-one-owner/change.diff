+package com.example.shop.b2b;
+
+import com.example.shop.session.SessionService;
+import lombok.RequiredArgsConstructor;
+
+@RequiredArgsConstructor
+public class B2BUnitService {
+
+    private static final String CURRENT_B2B_UNIT_SESSION_KEY = "currentB2BUnit";
+
+    private final SessionService sessionService;
+
+    public B2BUnitModel getCurrentB2BUnit() {
+        Object b2bUnitSessionValue = sessionService.getAttribute(
+                CURRENT_B2B_UNIT_SESSION_KEY);
+        if (b2bUnitSessionValue instanceof B2BUnitModel) {
+            return (B2BUnitModel) b2bUnitSessionValue;
+        }
+        return null;
+    }
+
+    public void setCurrentB2BUnit(B2BUnitModel unit) {
+        if (unit != null) {
+            sessionService.setAttribute(CURRENT_B2B_UNIT_SESSION_KEY, unit);
+        }
+    }
+
+    public void clearCurrentB2BUnit() {
+        sessionService.setAttribute(CURRENT_B2B_UNIT_SESSION_KEY, null);
+    }
+}
