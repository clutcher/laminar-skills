@@ -0,0 +1,21 @@
+package org.harbour.ticketoffice.notice;
+
+import java.util.ArrayList;
+import java.util.List;
+
+public class BookingNotices {
+
+    private static final int FEW_SEATS_LEFT = 10;
+
+    public List<PassengerNotice> afterBooking(int seatsLeftOnCrossing) {
+        List<PassengerNotice> notices = new ArrayList<>();
+        if (seatsLeftOnCrossing < FEW_SEATS_LEFT) {
+            notices.add(new PassengerNotice(PassengerNoticeSeverity.INFO, "Few seats are left on this crossing"));
+        }
+        return notices;
+    }
+
+    public List<PassengerNotice> whenRefused(String reason) {
+        return List.of(new PassengerNotice(PassengerNoticeSeverity.ERROR, reason));
+    }
+}
