+package org.harbour.crossingschedule.notice;
+
+import java.util.List;
+
+public class CrossingNotices {
+
+    public List<PassengerNotice> forDelay(int minutesLate) {
+        if (minutesLate <= 0) {
+            return List.of();
+        }
+        return List.of(new PassengerNotice(PassengerNoticeSeverity.WARN, "The crossing leaves " + minutesLate + " minutes late"));
+    }
+
+    public List<PassengerNotice> forCancellation() {
+        return List.of(new PassengerNotice(PassengerNoticeSeverity.ERROR, "The crossing is cancelled"));
+    }
+}
