+++ b/greenhouse/src/main/java/com/example/greenhouse/irrigation/out/weather/WeatherSourceUsingMeteoPartner.java
@@ -0,0 +1,40 @@
+package com.example.greenhouse.irrigation.out.weather;
+
+import com.example.greenhouse.irrigation.app.domain.model.DayOutlook;
+import com.example.greenhouse.irrigation.app.spi.WeatherSource;
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+import java.io.IOException;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.time.LocalDate;
+
+public class WeatherSourceUsingMeteoPartner implements WeatherSource {
+
+    private final HttpClient httpClient;
+    private final ObjectMapper objectMapper;
+    private final String partnerBaseUrl;
+
+    public WeatherSourceUsingMeteoPartner(HttpClient httpClient, ObjectMapper objectMapper, String partnerBaseUrl) {
+        this.httpClient = httpClient;
+        this.objectMapper = objectMapper;
+        this.partnerBaseUrl = partnerBaseUrl;
+    }
+
+    @Override
+    public DayOutlook outlookFor(String stationCode, LocalDate day) {
+        HttpRequest request = HttpRequest.newBuilder(URI.create(partnerBaseUrl + "/v2/forecast?station=" + stationCode + "&date=" + day)).GET().build();
+        try {
+            String body = httpClient.send(request, HttpResponse.BodyHandlers.ofString()).body();
+            return mapIntoOutlook(objectMapper.readValue(body, ForecastReply.class));
+        } catch (IOException | InterruptedException e) {
+            throw new IllegalStateException("The weather partner gave no forecast for station " + stationCode, e);
+        }
+    }
+
+    private DayOutlook mapIntoOutlook(ForecastReply reply) {
+        return new DayOutlook(reply.precipMm(), reply.precipProbabilityPct(), reply.tempMaxC());
+    }
+}
