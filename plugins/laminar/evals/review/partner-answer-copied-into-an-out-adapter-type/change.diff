@@ -0,0 +1,33 @@
+package com.example.greenhouse.irrigation.app.domain;
+
+import com.example.greenhouse.irrigation.app.api.WateringPlan;
+import com.example.greenhouse.irrigation.app.domain.model.DayOutlook;
+import com.example.greenhouse.irrigation.app.domain.model.Plot;
+import com.example.greenhouse.irrigation.app.spi.PlotStore;
+import com.example.greenhouse.irrigation.app.spi.WeatherSource;
+
+import java.time.LocalDate;
+
+public class IrrigationPlanner implements WateringPlan {
+
+    private final PlotStore plotStore;
+    private final WeatherSource weatherSource;
+
+    public IrrigationPlanner(PlotStore plotStore, WeatherSource weatherSource) {
+        this.plotStore = plotStore;
+        this.weatherSource = weatherSource;
+    }
+
+    @Override
+    public int wateringMinutesFor(String plotCode, LocalDate day) {
+        Plot plot = plotStore.plotOf(plotCode);
+        DayOutlook outlook = weatherSource.outlookFor(plot.stationCode(), day);
+        if (outlook.rainChancePercent() >= 70 && outlook.rainMillimeters() >= 5.0) {
+            return 0;
+        }
+        if (outlook.highestTemperature() >= 30.0) {
+            return plot.baseMinutes() * 2;
+        }
+        return plot.baseMinutes();
+    }
+}
