+package com.example.bakery.order.util.shipping;
+
+import java.util.ArrayList;
+import java.util.List;
+
+public class ShippingService {
+
+    private final List<String> dispatchedOrderIds = new ArrayList<>();
+
+    public void dispatchOrder(String orderId) {
+        dispatchedOrderIds.add(orderId);
+    }
+
+    public boolean isDispatched(String orderId) {
+        return dispatchedOrderIds.contains(orderId);
+    }
+}
