@@ -0,0 +1,23 @@
+import { Loan } from "../../app/domain/model/loan";
+import { LoanStore } from "../../app/spi/loan-store";
+import { PublicLoan } from "./public-loan";
+
+export class LoanLookup {
+  constructor(private readonly loanStore: LoanStore) {}
+
+  async loansOfMember(memberId: string): Promise<PublicLoan[]> {
+    return (await this.loanStore.loansOfMember(memberId)).map(toPublicLoan);
+  }
+
+  async recordLoan(loan: PublicLoan): Promise<void> {
+    await this.loanStore.saveLoan(toLoan(loan));
+  }
+}
+
+function toPublicLoan(loan: Loan): PublicLoan {
+  return new PublicLoan(loan.loanId, loan.memberId, loan.bookTitle, loan.dueOn);
+}
+
+function toLoan(loan: PublicLoan): Loan {
+  return new Loan(loan.loanId, loan.memberId, loan.bookTitle, loan.dueOn);
+}
