+import { LoanLookup, PublicLoan } from "../../../loans";
+import { OverdueLoan } from "../../app/domain/model/overdue-loan";
+import { OverdueLoans } from "../../app/spi/overdue-loans";
+
+export class OverdueLoansUsingLoansModule implements OverdueLoans {
+  constructor(private readonly loanLookup: LoanLookup) {}
+
+  async loansOfMember(memberId: string): Promise<OverdueLoan[]> {
+    return (await this.loanLookup.loansOfMember(memberId)).map(toOverdueLoan);
+  }
+}
+
+function toOverdueLoan(loan: PublicLoan): OverdueLoan {
+  return new OverdueLoan(loan.memberId, loan.dueOn);
+}
diff --git a/library/src/loans/app/domain/model/loan.ts b/library/src/loans/app/domain/model/loan.ts
new file mode 100644
--- /dev/null
+++ b/library/src/loans/app/domain/model/loan.ts
@@ -0,0 +1,17 @@
+export class Loan {
+  readonly loanId: string;
+  readonly memberId: string;
+  readonly bookTitle: string;
+  readonly dueOn: Date;
+
+  constructor(loanId: string, memberId: string, bookTitle: string, dueOn: Date) {
+    this.loanId = loanId;
+    this.memberId = memberId;
+    this.bookTitle = bookTitle;
+    this.dueOn = dueOn;
+  }
+
+  renewedFor(days: number): Loan {
+    return new Loan(this.loanId, this.memberId, this.bookTitle, new Date(this.dueOn.getTime() + days * 86400000));
+  }
+}
