+import { ScanRecord } from "./ScanRecord";
+
+export const formatScanLine = (scan: ScanRecord): string => `${scan.parcelId} scanned at ${scan.depotCode} on ${scan.scannedAt.toISOString()}`;
+
+export const formatScanLines = (scans: ScanRecord[]): string => scans.map(formatScanLine).join("\n");
