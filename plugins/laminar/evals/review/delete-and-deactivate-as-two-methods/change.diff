--- /dev/null
+++ b/shop/src/main/java/com/example/shop/account/CustomerOffboarding.java
@@ -0,0 +1,18 @@
+package com.example.shop.account;
+
+import com.example.shop.customer.Customer;
+import lombok.RequiredArgsConstructor;
+
+@RequiredArgsConstructor
+public class CustomerOffboarding {
+
+    private final AccountService accountService;
+
+    public void eraseOnRequest(Customer customer) {
+        accountService.deleteAccount(customer);
+    }
+
+    public void deactivateCustomerAccount(Customer customer) {
+        accountService.deactivateAccount(customer);
+    }
+}
