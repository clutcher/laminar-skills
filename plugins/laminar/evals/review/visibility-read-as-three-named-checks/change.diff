+package com.example.shop.catalog;
+
+import com.example.shop.customer.Customer;
+
+public class ProductVisibility {
+
+    public boolean isProductVisibleToCustomer(Product product, Customer customer) {
+        if (!isApprovedForStorefront(product)) {
+            return false;
+        }
+        if (!isInCustomerCatalog(product, customer)) {
+            return false;
+        }
+        return isInAllowedCategory(product, customer);
+    }
+
+    private boolean isApprovedForStorefront(Product product) {
+        return product.getApprovalStatus() == ApprovalStatus.APPROVED
+                && product.isEnabledForStorefront();
+    }
+
+    private boolean isInCustomerCatalog(Product product, Customer customer) {
+        return customer.getAssignedCatalogs().contains(product.getCatalog());
+    }
+
+    private boolean isInAllowedCategory(Product product, Customer customer) {
+        return customer.getBusinessUnit().getAllowedCategories()
+                .contains(product.getCategory());
+    }
+}
