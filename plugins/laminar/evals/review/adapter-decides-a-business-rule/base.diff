@@ -0,0 +1,13 @@
+import { PlacePreorder } from "../api/place-preorder";
+import { PreorderStore } from "../spi/preorder-store";
+import { Preorder } from "./model/preorder";
+
+export class PreorderService implements PlacePreorder {
+  constructor(private readonly store: PreorderStore) {}
+
+  async place(customerId: string, items: string[], pickupSlot: string): Promise<Preorder> {
+    const preorder = new Preorder(`${customerId}-${pickupSlot}`, customerId, items, pickupSlot, 0);
+    await this.store.save(preorder);
+    return preorder;
+  }
+}
