@@ -0,0 +1,11 @@
+import { Request, Response } from "express";
+import { PlacePreorder } from "../../app/api/place-preorder";
+
+export class PreorderController {
+  constructor(private readonly placePreorder: PlacePreorder) {}
+
+  async placeOrder(request: Request, response: Response): Promise<void> {
+    const preorder = await this.placePreorder.place(request.body.customerId, request.body.items, request.body.pickupSlot);
+    response.status(201).json({ preorderId: preorder.preorderId });
+  }
+}
