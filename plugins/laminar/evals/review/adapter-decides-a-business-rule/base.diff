new file mode 100644
index 0000000..a0beef7
--- /dev/null
+++ b/bakery/src/preorder/out/db/preorder-store-using-sql.ts
@@ -0,0 +1,14 @@
+import { Preorder } from "../../app/domain/model/preorder";
+import { PreorderStore } from "../../app/spi/preorder-store";
+
+export interface SqlClient {
+  query(sql: string, values: unknown[]): Promise<void>;
+}
+
+export class PreorderStoreUsingSql implements PreorderStore {
+  constructor(private readonly sql: SqlClient) {}
+
+  async save(preorder: Preorder): Promise<void> {
+    await this.sql.query("insert into preorder values ($1, $2, $3, $4)", [preorder.preorderId, preorder.customerId, preorder.pickupSlot, preorder.depositCents]);
+  }
+}
