+++ b/bikeshare/rebalancer.py
@@ -0,0 +1,11 @@
+from bikeshare.capacity_cache import CapacityCache
+from bikeshare.dock_availability import DockAvailability
+
+
+class Rebalancer:
+    def __init__(self, database_path, minimum_free_docks):
+        self.availability = DockAvailability(database_path, minimum_free_docks)
+        self.capacity_cache = CapacityCache()
+
+    def remember_capacity(self, station):
+        self.capacity_cache.put(station.station_id, station.capacity)
