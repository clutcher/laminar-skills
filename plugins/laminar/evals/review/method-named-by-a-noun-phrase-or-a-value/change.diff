+package com.example.bikeshop.repair;
+
+import java.math.BigDecimal;
+import java.util.List;
+
+public class RepairQuoteService {
+
+    private static final BigDecimal LABOUR_RATE_PER_MINUTE = new BigDecimal("0.90");
+
+    private static final BigDecimal CARBON_FRAME_SURCHARGE = new BigDecimal("15.00");
+
+    private final List<RepairStep> plannedSteps;
+
+    public RepairQuoteService(List<RepairStep> plannedSteps) {
+        this.plannedSteps = plannedSteps;
+    }
+
+    public BigDecimal repairCostEstimate(Bicycle bike, List<Part> wornParts) {
+        BigDecimal partsCost = estimatePartsCost(wornParts);
+        BigDecimal labourCost = LABOUR_RATE_PER_MINUTE.multiply(BigDecimal.valueOf(labourMinutes()));
+        BigDecimal frameSurcharge = bike.hasCarbonFrame() ? CARBON_FRAME_SURCHARGE : BigDecimal.ZERO;
+        return partsCost.add(labourCost).add(frameSurcharge);
+    }
+
+    public int labourMinutes() {
+        int minutes = 0;
+        for (RepairStep step : plannedSteps) {
+            minutes += step.minutes();
+        }
+        return minutes;
+    }
+
+    public BigDecimal estimatePartsCost(List<Part> wornParts) {
+        BigDecimal cost = BigDecimal.ZERO;
+        for (Part part : wornParts) {
+            cost = cost.add(part.price());
+        }
+        return cost;
+    }
+}
