+package com.example.freight.shipping;
+
+import java.time.LocalDate;
+
+public class Shipment {
+
+    private final CarrierClient carrierClient;
+    private final PickupCalendar pickupCalendar;
+
+    public Shipment(CarrierClient carrierClient, PickupCalendar pickupCalendar) {
+        this.carrierClient = carrierClient;
+        this.pickupCalendar = pickupCalendar;
+    }
+
+    public CarrierBooking bookCarrier(String shipmentId, String carrierCode) {
+        return carrierClient.book(shipmentId, carrierCode);
+    }
+
+    public PickupSlot reservePickup(String shipmentId, LocalDate pickupDay) {
+        return pickupCalendar.reserve(shipmentId, pickupDay);
+    }
+
+    public void cancelCarrierBooking(String bookingReference) {
+        carrierClient.cancel(bookingReference);
+    }
+}
