+package com.example.allotment.waitinglist.config;
+
+import com.example.allotment.waitinglist.app.api.ApiForWaitingList;
+import com.example.allotment.waitinglist.app.domain.services.WaitingListService;
+import com.example.allotment.waitinglist.app.spi.WaitingListRepository;
+import com.example.allotment.waitinglist.out.db.WaitingListRepositoryUsingJdbc;
+import java.time.Clock;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.jdbc.core.simple.JdbcClient;
+
+@Configuration
+public class WaitingListModuleConfiguration {
+
+    @Bean("waitingListRepository")
+    public WaitingListRepository createWaitingListRepository(JdbcClient jdbcClient) {
+        return new WaitingListRepositoryUsingJdbc(jdbcClient);
+    }
+
+    @Bean("apiForWaitingList")
+    public ApiForWaitingList createApiForWaitingList(WaitingListRepository waitingListRepository, Clock clock) {
+        return new WaitingListService(waitingListRepository, clock);
+    }
+}
