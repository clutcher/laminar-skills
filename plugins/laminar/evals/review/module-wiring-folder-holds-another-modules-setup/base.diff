--- /dev/null
+++ b/allotment-office/src/main/java/com/example/allotment/waitinglist/out/db/WaitingListRepositoryUsingJdbc.java
@@ -0,0 +1,27 @@
+package com.example.allotment.waitinglist.out.db;
+
+import com.example.allotment.waitinglist.app.domain.model.WaitingListPlace;
+import com.example.allotment.waitinglist.app.spi.WaitingListRepository;
+import org.springframework.jdbc.core.simple.JdbcClient;
+
+public class WaitingListRepositoryUsingJdbc implements WaitingListRepository {
+
+    private final JdbcClient jdbcClient;
+
+    public WaitingListRepositoryUsingJdbc(JdbcClient jdbcClient) {
+        this.jdbcClient = jdbcClient;
+    }
+
+    @Override
+    public int countWaitingGardeners() {
+        return jdbcClient.sql("select count(*) from waiting_list_place").query(Integer.class).single();
+    }
+
+    @Override
+    public WaitingListPlace savePlace(WaitingListPlace place) {
+        jdbcClient.sql("insert into waiting_list_place (gardener_id, position, joined_on) values (?, ?, ?)")
+                .params(place.gardenerId(), place.position(), place.joinedOn())
+                .update();
+        return place;
+    }
+}
