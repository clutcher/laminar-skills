+package com.example.allotment.waitinglist.app.domain.services;
+
+import com.example.allotment.waitinglist.app.api.ApiForWaitingList;
+import com.example.allotment.waitinglist.app.domain.model.WaitingListPlace;
+import com.example.allotment.waitinglist.app.spi.WaitingListRepository;
+import java.time.Clock;
+import java.time.LocalDate;
+
+public class WaitingListService implements ApiForWaitingList {
+
+    private final WaitingListRepository waitingListRepository;
+    private final Clock clock;
+
+    public WaitingListService(WaitingListRepository waitingListRepository, Clock clock) {
+        this.waitingListRepository = waitingListRepository;
+        this.clock = clock;
+    }
+
+    @Override
+    public WaitingListPlace joinWaitingList(String gardenerId) {
+        int position = waitingListRepository.countWaitingGardeners() + 1;
+        WaitingListPlace place = new WaitingListPlace(gardenerId, position, LocalDate.now(clock));
+        return waitingListRepository.savePlace(place);
+    }
+}
