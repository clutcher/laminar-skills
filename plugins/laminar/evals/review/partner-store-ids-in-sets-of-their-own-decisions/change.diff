--- /dev/null
+++ b/delivery/src/main/java/com/example/freshlane/van/ChilledVanRule.java
@@ -0,0 +1,13 @@
+package com.example.freshlane.van;
+
+import com.example.freshlane.order.GroceryOrder;
+import java.util.Set;
+
+public class ChilledVanRule {
+
+    private static final Set<String> STORES_WITHOUT_A_COLD_ROOM = Set.of("ST-0977");
+
+    public boolean needsChilledVan(GroceryOrder order) {
+        return order.holdsChilledLines() && STORES_WITHOUT_A_COLD_ROOM.contains(order.storeId());
+    }
+}
