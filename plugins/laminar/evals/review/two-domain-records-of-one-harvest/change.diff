@@ -0,0 +1,29 @@
+package com.example.apiary.hives.app.domain;
+
+import com.example.apiary.hives.app.api.HarvestRecording;
+import com.example.apiary.hives.app.domain.model.HarvestEntry;
+import com.example.apiary.hives.app.domain.model.HoneyHarvest;
+import com.example.apiary.hives.app.spi.HarvestStore;
+
+import java.time.LocalDate;
+
+public class HarvestService implements HarvestRecording {
+
+    private final HarvestStore harvestStore;
+
+    public HarvestService(HarvestStore harvestStore) {
+        this.harvestStore = harvestStore;
+    }
+
+    @Override
+    public void recordHarvest(String hiveCode, LocalDate harvestedOn, int jarCount, String flowerSource) {
+        harvestStore.save(new HoneyHarvest(hiveCode, harvestedOn, jarCount, flowerSource));
+    }
+
+    @Override
+    public int jarsOfSeason(int year) {
+        return harvestStore.entriesOfSeason(year).stream()
+                .mapToInt(HarvestEntry::jarCount)
+                .sum();
+    }
+}
