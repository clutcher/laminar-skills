+package com.example.nursery.planting.app.domain;
+
+import com.example.nursery.planting.app.api.SeedlingPlanting;
+import com.example.nursery.planting.app.domain.model.Seedling;
+import com.example.nursery.planting.app.spi.TrayStore;
+
+import java.time.Clock;
+import java.time.LocalDate;
+
+public class SeedlingPlantingService implements SeedlingPlanting {
+
+    private final TrayStore trayStore;
+    private final Clock clock;
+
+    public SeedlingPlantingService(TrayStore trayStore, Clock clock) {
+        this.trayStore = trayStore;
+        this.clock = clock;
+    }
+
+    @Override
+    public Seedling sow(String variety, int trayNumber) {
+        Seedling seedling = new Seedling(variety, trayNumber, LocalDate.now(clock));
+        trayStore.save(seedling);
+        return seedling;
+    }
+}
