diff --git a/nursery/src/main/java/com/example/nursery/planting/out/db/TrayStoreUsingJdbc.java b/nursery/src/main/java/com/example/nursery/planting/out/db/TrayStoreUsingJdbc.java
new file mode 100644
index 0000000..97188e5
--- /dev/null
+++ b/nursery/src/main/java/com/example/nursery/planting/out/db/TrayStoreUsingJdbc.java
@@ -0,0 +1,31 @@
+package com.example.nursery.planting.out.db;
+
+import com.example.nursery.planting.app.domain.model.Seedling;
+import com.example.nursery.planting.app.spi.TrayStore;
+import org.springframework.jdbc.core.simple.JdbcClient;
+
+import java.util.List;
+
+public class TrayStoreUsingJdbc implements TrayStore {
+
+    private final JdbcClient jdbcClient;
+
+    public TrayStoreUsingJdbc(JdbcClient jdbcClient) {
+        this.jdbcClient = jdbcClient;
+    }
+
+    @Override
+    public void save(Seedling seedling) {
+        jdbcClient.sql("insert into seedling (variety, tray_number, sown_on) values (?, ?, ?)")
+                .params(seedling.variety(), seedling.trayNumber(), seedling.sownOn())
+                .update();
+    }
+
+    @Override
+    public List<Seedling> seedlingsOfVariety(String variety) {
+        return jdbcClient.sql("select variety, tray_number, sown_on from seedling where variety = ?")
+                .param(variety)
+                .query(Seedling.class)
+                .list();
+    }
+}
