@@ -0,0 +1,25 @@
+package com.example.nursery.delivery.out.modules;
+
+import com.example.nursery.delivery.app.domain.model.TrayToShip;
+import com.example.nursery.delivery.app.spi.TraysReadyToShip;
+import com.example.nursery.planting.in.modules.PublicSeedlingReadiness;
+import com.example.nursery.planting.in.modules.SeedlingLookup;
+
+import java.util.List;
+
+public class TraysReadyToShipUsingPlantingModule implements TraysReadyToShip {
+
+    private final SeedlingLookup seedlingLookup;
+
+    public TraysReadyToShipUsingPlantingModule(SeedlingLookup seedlingLookup) {
+        this.seedlingLookup = seedlingLookup;
+    }
+
+    @Override
+    public List<TrayToShip> readyTraysOfVariety(String variety) {
+        return seedlingLookup.readinessOfVariety(variety).stream()
+                .filter(PublicSeedlingReadiness::readyToShip)
+                .map(readiness -> new TrayToShip(readiness.variety(), readiness.trayNumber()))
+                .toList();
+    }
+}
