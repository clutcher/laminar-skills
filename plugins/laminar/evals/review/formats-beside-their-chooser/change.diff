diff --git a/courier-desk/src/label-formats/LabelFormatChooser.ts b/courier-desk/src/label-formats/LabelFormatChooser.ts
new file mode 100644
--- /dev/null
+++ b/courier-desk/src/label-formats/LabelFormatChooser.ts
@@ -0,0 +1,11 @@
+import { LabelFormat } from "./LabelFormat";
+
+export class LabelFormatChooser {
+  constructor(private readonly labelFormats: LabelFormat[]) {}
+
+  chooseLabelFormat(carrierCode: string): LabelFormat {
+    const chosen = this.labelFormats.find(labelFormat => labelFormat.carrierCode === carrierCode);
+    if (!chosen) throw new Error(`No label format for carrier ${carrierCode}`);
+    return chosen;
+  }
+}
