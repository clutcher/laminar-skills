--- /dev/null
+++ b/courier-desk/src/label-formats/DhlLabelFormat.ts
@@ -0,0 +1,9 @@
+import { LabelFormat } from "./LabelFormat";
+
+export class DhlLabelFormat implements LabelFormat {
+  readonly carrierCode = "DHL";
+
+  formatLabel(parcelId: string, postalCode: string): string {
+    return `DHL|${postalCode}|${parcelId}`;
+  }
+}
