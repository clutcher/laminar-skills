diff --git a/bakery-shop/src/util/OvenScheduleService.ts b/bakery-shop/src/util/OvenScheduleService.ts
new file mode 100644
--- /dev/null
+++ b/bakery-shop/src/util/OvenScheduleService.ts
@@ -0,0 +1,17 @@
+export interface OvenSlot {
+  ovenId: string;
+  startsAt: Date;
+  batchName: string;
+}
+
+export class OvenScheduleService {
+  private readonly slots: OvenSlot[] = [];
+
+  bookOvenSlot(slot: OvenSlot): void {
+    this.slots.push(slot);
+  }
+
+  findSlotsOfOven(ovenId: string): OvenSlot[] {
+    return this.slots.filter((slot) => slot.ovenId === ovenId);
+  }
+}
