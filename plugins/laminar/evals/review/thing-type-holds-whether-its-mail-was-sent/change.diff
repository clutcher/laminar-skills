+++ b/vegbox/src/main/java/com/example/vegbox/delivery/app/domain/BoxDispatchService.java
@@ -0,0 +1,33 @@
+package com.example.vegbox.delivery.app.domain;
+
+import com.example.vegbox.delivery.app.domain.model.VegBox;
+import com.example.vegbox.delivery.app.spi.BoxStore;
+import com.example.vegbox.delivery.app.spi.Courier;
+import com.example.vegbox.delivery.app.spi.SubscriberMailer;
+
+public class BoxDispatchService {
+
+    private final BoxStore boxStore;
+    private final Courier courier;
+    private final SubscriberMailer subscriberMailer;
+
+    public BoxDispatchService(BoxStore boxStore, Courier courier, SubscriberMailer subscriberMailer) {
+        this.boxStore = boxStore;
+        this.courier = courier;
+        this.subscriberMailer = subscriberMailer;
+    }
+
+    public VegBox dispatchBox(String boxCode) {
+        VegBox box = boxStore.findBox(boxCode);
+        courier.handOver(box.code(), box.deliveryDay());
+        box.markDispatched();
+
+        boolean noticeSent = subscriberMailer.sendDispatchNotice(box.subscriberCode(), box.deliveryDay());
+        if (noticeSent) {
+            box.markSubscriberNotified();
+        }
+
+        boxStore.saveBox(box);
+        return box;
+    }
+}
