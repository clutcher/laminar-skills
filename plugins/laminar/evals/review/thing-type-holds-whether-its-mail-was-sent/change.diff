diff --git a/vegbox/src/main/java/com/example/vegbox/delivery/app/domain/model/VegBox.java b/vegbox/src/main/java/com/example/vegbox/delivery/app/domain/model/VegBox.java
new file mode 100644
--- /dev/null
+++ b/vegbox/src/main/java/com/example/vegbox/delivery/app/domain/model/VegBox.java
@@ -0,0 +1,48 @@
+package com.example.vegbox.delivery.app.domain.model;
+
+import java.time.LocalDate;
+
+public class VegBox {
+
+    private final String code;
+    private final String subscriberCode;
+    private final LocalDate deliveryDay;
+    private BoxStatus status;
+    private boolean subscriberNotified;
+
+    public VegBox(String code, String subscriberCode, LocalDate deliveryDay, BoxStatus status, boolean subscriberNotified) {
+        this.code = code;
+        this.subscriberCode = subscriberCode;
+        this.deliveryDay = deliveryDay;
+        this.status = status;
+        this.subscriberNotified = subscriberNotified;
+    }
+
+    public String code() {
+        return code;
+    }
+
+    public String subscriberCode() {
+        return subscriberCode;
+    }
+
+    public LocalDate deliveryDay() {
+        return deliveryDay;
+    }
+
+    public BoxStatus status() {
+        return status;
+    }
+
+    public boolean isSubscriberNotified() {
+        return subscriberNotified;
+    }
+
+    public void markDispatched() {
+        status = BoxStatus.DISPATCHED;
+    }
+
+    public void markSubscriberNotified() {
+        subscriberNotified = true;
+    }
+}
