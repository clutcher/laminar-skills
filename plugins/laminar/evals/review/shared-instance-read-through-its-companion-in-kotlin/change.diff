+package com.example.marina.berths
+
+import com.example.marina.tides.HighWaterEstimator
+import java.time.LocalTime
+
+class BerthDepartureWindow(private val lowWaterTime: LocalTime) {
+
+    fun latestDeparture(): LocalTime =
+        HighWaterEstimator.INSTANCE.highWaterAfter(lowWaterTime)
+}
