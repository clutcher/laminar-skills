+package com.example.marina.tides
+
+import java.time.Duration
+import java.time.LocalTime
+
+class HighWaterEstimator private constructor(private val lowToHighWater: Duration) {
+
+    fun highWaterAfter(lowWaterTime: LocalTime): LocalTime = lowWaterTime.plus(lowToHighWater)
+
+    companion object {
+        val INSTANCE = HighWaterEstimator(Duration.ofHours(6).plusMinutes(12))
+    }
+}
