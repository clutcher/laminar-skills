+package com.example.bikerental.hire;
+
+public record Bike(String frameNumber, int ridesSinceService) {
+
+    private static final int SERVICE_INTERVAL_RIDES = 200;
+
+    public boolean isDueForService() {
+        return ridesSinceService >= SERVICE_INTERVAL_RIDES;
+    }
+}
