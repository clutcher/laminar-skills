+package com.example.bikerental.hire;
+
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.List;
+
+public class RentalBikes {
+
+    private final List<Bike> bikes = new ArrayList<>();
+    private final RentalLogStore rentalLogStore;
+
+    public RentalBikes(RentalLogStore rentalLogStore) {
+        this.rentalLogStore = rentalLogStore;
+    }
+
+    public void add(Bike bike) {
+        if (bike.isDueForService()) {
+            throw new BikeDueForServiceException(bike.frameNumber());
+        }
+
+        bikes.add(bike);
+        rentalLogStore.saveEntry(new RentalLogEntry(bike.frameNumber(), Instant.now()));
+    }
+
+    public void remove(Bike bike) {
+        bikes.remove(bike);
+    }
+
+    public List<Bike> getBikes() {
+        return List.copyOf(bikes);
+    }
+
+    public int size() {
+        return bikes.size();
+    }
+}
