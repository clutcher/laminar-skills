+package com.example.shop.order;
+
+import com.example.shop.mail.ConfirmationMailer;
+import com.example.shop.payment.PaymentGateway;
+import com.example.shop.stock.StockReservation;
+import lombok.RequiredArgsConstructor;
+
+@RequiredArgsConstructor
+public class OrderProcessingService {
+
+    private final StockReservation stockReservation;
+    private final PaymentGateway paymentGateway;
+    private final ConfirmationMailer confirmationMailer;
+
+    public void processOrder(Order order) {
+        if (!isValidOrder(order)) {
+            return;
+        }
+
+        reserveInventory(order);
+        chargePayment(order);
+        sendConfirmation(order);
+    }
+
+    private boolean isValidOrder(Order order) {
+        return order != null
+                && order.hasLineItems()
+                && order.getCustomer() != null
+                && order.getPayment().isValid();
+    }
+
+    private void reserveInventory(Order order) {
+        stockReservation.reserve(order.getLineItems());
+    }
+
+    private void chargePayment(Order order) {
+        paymentGateway.charge(order.getPayment());
+    }
+
+    private void sendConfirmation(Order order) {
+        confirmationMailer.send(order);
+    }
+}
