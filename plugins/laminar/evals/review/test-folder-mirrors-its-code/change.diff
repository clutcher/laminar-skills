@@ -0,0 +1,39 @@
+package com.example.greenhouse.watering;
+
+import static com.example.greenhouse.watering.support.GreenhouseBedBuilder.aTomatoBed;
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.example.greenhouse.watering.support.FakeMoistureSensor;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+class WateringSchedulerTest {
+
+    @Test
+    void shouldOrderTwoLitresPerMissingPercentWhenTheBedIsDrierThanItsTarget() {
+        // given
+        GreenhouseBed tomatoBed = aTomatoBed().withBedId("bed-tomatoes-1").withTargetMoisturePercent(60).build();
+        FakeMoistureSensor moistureSensor = new FakeMoistureSensor().withMoisture("bed-tomatoes-1", 45);
+        WateringScheduler wateringScheduler = new WateringScheduler(moistureSensor);
+
+        // when
+        List<WateringOrder> wateringOrders = wateringScheduler.planWatering(List.of(tomatoBed));
+
+        // then
+        assertThat(wateringOrders).containsExactly(new WateringOrder("bed-tomatoes-1", 30));
+    }
+
+    @Test
+    void shouldOrderNoWaterWhenTheBedHoldsItsTargetMoisture() {
+        // given
+        GreenhouseBed tomatoBed = aTomatoBed().withBedId("bed-tomatoes-2").withTargetMoisturePercent(60).build();
+        FakeMoistureSensor moistureSensor = new FakeMoistureSensor().withMoisture("bed-tomatoes-2", 60);
+        WateringScheduler wateringScheduler = new WateringScheduler(moistureSensor);
+
+        // when
+        List<WateringOrder> wateringOrders = wateringScheduler.planWatering(List.of(tomatoBed));
+
+        // then
+        assertThat(wateringOrders).isEmpty();
+    }
+}
