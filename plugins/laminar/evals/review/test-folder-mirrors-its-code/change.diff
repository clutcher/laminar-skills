+package com.example.greenhouse.watering;
+
+import java.util.List;
+
+public class WateringScheduler {
+
+    private static final int LITRES_PER_MISSING_MOISTURE_PERCENT = 2;
+
+    private final MoistureSensor moistureSensor;
+
+    public WateringScheduler(MoistureSensor moistureSensor) {
+        this.moistureSensor = moistureSensor;
+    }
+
+    public List<WateringOrder> planWatering(List<GreenhouseBed> beds) {
+        return beds.stream()
+                .filter(this::isDrierThanItsTarget)
+                .map(this::orderWaterForTheMissingMoisture)
+                .toList();
+    }
+
+    private boolean isDrierThanItsTarget(GreenhouseBed bed) {
+        return moistureSensor.readMoisturePercent(bed.bedId()) < bed.targetMoisturePercent();
+    }
+
+    private WateringOrder orderWaterForTheMissingMoisture(GreenhouseBed bed) {
+        int missingMoisturePercent = bed.targetMoisturePercent() - moistureSensor.readMoisturePercent(bed.bedId());
+        return new WateringOrder(bed.bedId(), missingMoisturePercent * LITRES_PER_MISSING_MOISTURE_PERCENT);
+    }
+}
