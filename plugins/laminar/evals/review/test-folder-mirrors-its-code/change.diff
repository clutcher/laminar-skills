+package com.example.greenhouse.watering;
+
+import static com.example.greenhouse.watering.support.GreenhouseBedBuilder.aTomatoBed;
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.example.greenhouse.watering.support.FakeMoistureSensor;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+class WateringSchedulerMixedBedsTest {
+
+    @Test
+    void shouldOrderWaterOnlyForTheDryBedWhenOneOfTwoBedsIsDry() {
+        // given
+        GreenhouseBed dryBed = aTomatoBed().withBedId("bed-tomatoes-1").withTargetMoisturePercent(60).build();
+        GreenhouseBed wetBed = aTomatoBed().withBedId("bed-tomatoes-2").withTargetMoisturePercent(60).build();
+        FakeMoistureSensor moistureSensor = new FakeMoistureSensor()
+                .withMoisture("bed-tomatoes-1", 50)
+                .withMoisture("bed-tomatoes-2", 70);
+        WateringScheduler wateringScheduler = new WateringScheduler(moistureSensor);
+
+        // when
+        List<WateringOrder> wateringOrders = wateringScheduler.planWatering(List.of(dryBed, wetBed));
+
+        // then
+        assertThat(wateringOrders).containsExactly(new WateringOrder("bed-tomatoes-1", 20));
+    }
+}
