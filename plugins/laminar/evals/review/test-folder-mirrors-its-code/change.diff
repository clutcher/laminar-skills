+++ b/greenhouse-control/src/test/java/com/example/greenhouse/watering/support/FakeMoistureSensor.java
@@ -0,0 +1,20 @@
+package com.example.greenhouse.watering.support;
+
+import com.example.greenhouse.watering.MoistureSensor;
+import java.util.HashMap;
+import java.util.Map;
+
+public class FakeMoistureSensor implements MoistureSensor {
+
+    private final Map<String, Integer> moisturePercentByBedId = new HashMap<>();
+
+    public FakeMoistureSensor withMoisture(String bedId, int moisturePercent) {
+        moisturePercentByBedId.put(bedId, moisturePercent);
+        return this;
+    }
+
+    @Override
+    public int readMoisturePercent(String bedId) {
+        return moisturePercentByBedId.get(bedId);
+    }
+}
