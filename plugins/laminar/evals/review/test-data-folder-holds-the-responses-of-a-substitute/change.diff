@@ -0,0 +1,19 @@
+package com.example.observatory.telescope;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+final class SlewResultJson {
+
+    private static final ObjectMapper OBJECT_MAPPER = new ObjectMapper();
+
+    private SlewResultJson() {
+    }
+
+    static SlewResult read(String json) {
+        try {
+            return OBJECT_MAPPER.readValue(json, SlewResult.class);
+        } catch (Exception exception) {
+            throw new IllegalArgumentException("Slew response is not valid JSON", exception);
+        }
+    }
+}
