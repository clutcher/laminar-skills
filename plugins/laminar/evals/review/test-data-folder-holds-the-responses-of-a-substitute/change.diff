@@ -0,0 +1,26 @@
+package com.example.observatory.telescope;
+
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class TelescopePointingTest {
+
+    private static final double ORION_NEBULA_RIGHT_ASCENSION = 83.82;
+    private static final double ORION_NEBULA_DECLINATION = -5.39;
+    private static final Path SLEW_RESPONSE = Path.of("src/test/java/com/example/observatory/telescope/testdata/mount-api-slew-response.json");
+
+    @Test
+    void shouldReachTargetWhenMountAcceptsSlew() throws IOException {
+        String slewResponse = Files.readString(SLEW_RESPONSE);
+        TelescopePointing pointing = new TelescopePointing((rightAscension, declination) -> SlewResultJson.read(slewResponse));
+
+        SlewResult result = pointing.aim(ORION_NEBULA_RIGHT_ASCENSION, ORION_NEBULA_DECLINATION);
+
+        assertThat(result.reached()).isTrue();
+    }
+}
