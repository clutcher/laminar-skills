+<?php
+
+declare(strict_types=1);
+
+namespace Kennel\Boarding\Out\Db;
+
+use Kennel\Boarding\App\Spi\VaccinationRecords;
+use PDO;
+
+final class VaccinationRecordsUsingPdo implements VaccinationRecords
+{
+    public function __construct(private readonly PDO $pdo)
+    {
+    }
+
+    public function isVaccinatedOn(string $dogId, string $day): bool
+    {
+        $query = $this->pdo->prepare('select count(*) from vaccination where dog_id = ? and valid_until >= ?');
+        $query->execute([$dogId, $day]);
+        return (int) $query->fetchColumn() > 0;
+    }
+}
