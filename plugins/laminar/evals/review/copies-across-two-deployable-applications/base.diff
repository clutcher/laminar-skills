+++ b/tracking/src/main/java/com/example/shipping/tracking/status/ParcelStatusController.java
@@ -0,0 +1,23 @@
+package com.example.shipping.tracking.status;
+
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+public class ParcelStatusController {
+
+    private final ShipmentStore shipments;
+    private final CustomsHoldPolicy customsHoldPolicy;
+
+    public ParcelStatusController(ShipmentStore shipments, CustomsHoldPolicy customsHoldPolicy) {
+        this.shipments = shipments;
+        this.customsHoldPolicy = customsHoldPolicy;
+    }
+
+    @GetMapping("/parcels/{parcelId}/status")
+    public String statusCodeOf(@PathVariable String parcelId) {
+        Shipment shipment = shipments.byParcelId(parcelId);
+        return customsHoldPolicy.isHeldAtCustoms(shipment) ? "HELD_AT_CUSTOMS" : "IN_TRANSIT";
+    }
+}
