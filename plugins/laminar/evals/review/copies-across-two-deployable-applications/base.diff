@@ -0,0 +1,19 @@
+package com.example.shipping.dispatch.release;
+
+import org.springframework.web.client.RestClient;
+
+public class TrackingClient {
+
+    private final RestClient trackingApi;
+
+    public TrackingClient(RestClient trackingApi) {
+        this.trackingApi = trackingApi;
+    }
+
+    public String statusCodeOf(String parcelId) {
+        return trackingApi.get()
+            .uri("/parcels/{parcelId}/status", parcelId)
+            .retrieve()
+            .body(String.class);
+    }
+}
