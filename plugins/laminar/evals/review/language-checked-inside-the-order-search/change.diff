+++ b/collection/src/main/java/org/example/museum/collection/exhibit/app/domain/services/validators/SupportedLanguageValidator.java
@@ -0,0 +1,21 @@
+package org.example.museum.collection.exhibit.app.domain.services.validators;
+
+import org.example.museum.collection.exhibit.app.domain.model.exceptions.LanguageNotOfferedException;
+import org.example.museum.collection.exhibit.app.spi.LanguageCatalogue;
+
+import java.util.Locale;
+
+public class SupportedLanguageValidator {
+
+    private final LanguageCatalogue languageCatalogue;
+
+    public SupportedLanguageValidator(LanguageCatalogue languageCatalogue) {
+        this.languageCatalogue = languageCatalogue;
+    }
+
+    public void validate(Locale requestedLanguage) {
+        if (requestedLanguage != null && !languageCatalogue.offers(requestedLanguage)) {
+            throw new LanguageNotOfferedException(requestedLanguage);
+        }
+    }
+}
