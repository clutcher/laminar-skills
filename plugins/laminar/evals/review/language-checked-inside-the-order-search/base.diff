+package org.example.museum.collection.exhibit.in.graphql;
+
+import org.example.museum.generated.graphql.types.ExhibitFilterInput;
+import org.example.museum.generated.graphql.types.PageInput;
+import org.example.museum.collection.exhibit.app.api.ApiForExhibitSearch;
+import org.example.museum.collection.exhibit.app.domain.model.exhibit.ExhibitSummary;
+import org.example.museum.collection.exhibit.app.domain.model.exhibit.search.ExhibitSearchCriteria;
+import org.example.museum.collection.exhibit.app.domain.model.exhibit.search.ExhibitSearchOptions;
+import org.example.museum.collection.exhibit.app.domain.model.exhibit.search.PageRequest;
+import org.example.museum.collection.exhibit.in.graphql.mappers.ExhibitFilterMapper;
+import org.example.museum.collection.exhibit.in.graphql.mappers.ExhibitResponseMapper;
+import org.example.museum.collection.exhibit.in.graphql.mappers.ExhibitSearchOptionsMapper;
+import graphql.schema.DataFetchingFieldSelectionSet;
+import org.springframework.graphql.data.method.annotation.Argument;
+import org.springframework.graphql.data.method.annotation.QueryMapping;
+import org.springframework.stereotype.Controller;
+
+import java.util.List;
+
+@Controller
+public class ExhibitGraphQLController {
+
+    private final ApiForExhibitSearch apiForExhibitSearch;
+
+    public ExhibitGraphQLController(ApiForExhibitSearch apiForExhibitSearch) {
+        this.apiForExhibitSearch = apiForExhibitSearch;
+    }
+
+    @QueryMapping(name = "exhibits")
+    public List<org.example.museum.generated.graphql.types.Exhibit> getExhibits(
+            @Argument("filter") ExhibitFilterInput filter,
+            @Argument("page") PageInput page,
+            DataFetchingFieldSelectionSet selectionSet
+    ) {
+        ExhibitSearchCriteria criteria = ExhibitFilterMapper.INSTANCE.toCriteria(filter);
+        PageRequest pageRequest = ExhibitFilterMapper.INSTANCE.toPageRequest(page);
+        ExhibitSearchOptions options = ExhibitSearchOptionsMapper.INSTANCE.toOptions(selectionSet);
+
+        List<? extends ExhibitSummary> exhibits = apiForExhibitSearch.search(criteria, pageRequest, options);
+        return ExhibitResponseMapper.INSTANCE.toExhibitList(exhibits);
+    }
+
+}
