+package org.example.museum.collection.exhibit.app.domain.services;
+
+import org.example.museum.collection.exhibit.app.api.ApiForExhibitSearch;
+import org.example.museum.collection.exhibit.app.domain.model.exhibit.ExhibitSummary;
+import org.example.museum.collection.exhibit.app.domain.model.exhibit.search.ExhibitSearchCriteria;
+import org.example.museum.collection.exhibit.app.domain.model.exhibit.search.ExhibitSearchOptions;
+import org.example.museum.collection.exhibit.app.domain.model.exhibit.search.PageRequest;
+import org.example.museum.collection.exhibit.app.spi.ExhibitCatalogue;
+import org.springframework.stereotype.Service;
+
+import java.util.List;
+
+@Service
+public class ExhibitSearchService implements ApiForExhibitSearch {
+
+    private final ExhibitCatalogue exhibitCatalogue;
+
+    public ExhibitSearchService(ExhibitCatalogue exhibitCatalogue) {
+        this.exhibitCatalogue = exhibitCatalogue;
+    }
+
+    @Override
+    public List<? extends ExhibitSummary> search(ExhibitSearchCriteria criteria, PageRequest page, ExhibitSearchOptions options) {
+        return switch (options.projection()) {
+            case SUMMARY -> exhibitCatalogue.findSummaries(criteria, page);
+            case DETAILED -> exhibitCatalogue.findWithDescriptions(criteria, page);
+        };
+    }
+}
