@@ -0,0 +1,24 @@
+package org.example.museum.collection.exhibit.in.graphql.mappers;
+
+import org.example.museum.collection.exhibit.app.domain.model.exhibit.ExhibitSummary;
+import org.example.museum.collection.exhibit.app.domain.model.exhibit.search.ExhibitSearchOptions;
+import org.example.museum.collection.exhibit.app.domain.model.exhibit.search.ExhibitSearchOptions.Projection;
+import graphql.schema.DataFetchingFieldSelectionSet;
+import graphql.schema.SelectedField;
+import org.mapstruct.Mapper;
+import org.mapstruct.factory.Mappers;
+
+@Mapper
+public interface ExhibitSearchOptionsMapper {
+    ExhibitSearchOptionsMapper INSTANCE = Mappers.getMapper(ExhibitSearchOptionsMapper.class);
+
+    default ExhibitSearchOptions toOptions(DataFetchingFieldSelectionSet selectionSet) {
+        boolean summaryIsEnough = selectionSet.getImmediateFields().stream()
+                .map(SelectedField::getName)
+                .allMatch(ExhibitSummary.FIELDS::contains);
+        return ExhibitSearchOptions.builder()
+                .projection(summaryIsEnough ? Projection.SUMMARY : Projection.DETAILED)
+                .build();
+    }
+
+}
