@@ -0,0 +1,22 @@
+package com.example.lending.counter;
+
+import com.example.lending.desk.LoanDesk;
+import com.example.lending.loans.Loan;
+import com.example.lending.money.Money;
+
+import java.time.LocalDate;
+
+public class ReturnCounter {
+
+    private final LoanDesk loanDesk;
+
+    public ReturnCounter(LoanDesk loanDesk) {
+        this.loanDesk = loanDesk;
+    }
+
+    public ReturnReceipt acceptReturn(Loan loan, LocalDate returnedOn) {
+        loanDesk.returnCopy(loan);
+        Money lateFee = loanDesk.calculateLateFee(loanDesk.readDueDate(loan), returnedOn);
+        return new ReturnReceipt(loan.copy().barcode(), returnedOn, lateFee);
+    }
+}
