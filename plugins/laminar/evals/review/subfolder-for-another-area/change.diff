+package com.example.apiary.hives.honeysales
+
+class HoneyInvoiceService(
+    private val honeyPriceList: HoneyPriceList,
+    private val honeyInvoiceRepository: HoneyInvoiceRepository,
+) {
+
+    fun createInvoice(customerName: String, jarCount: Int): HoneyInvoice {
+        val pricePerJarCents = getPricePerJarCents(jarCount)
+        val invoice = HoneyInvoice(customerName, jarCount, pricePerJarCents, pricePerJarCents * jarCount)
+        honeyInvoiceRepository.saveInvoice(invoice)
+
+        return invoice
+    }
+
+    private fun getPricePerJarCents(jarCount: Int): Long {
+        if (jarCount >= honeyPriceList.bulkJarCount) {
+            return honeyPriceList.bulkPricePerJarCents
+        }
+
+        return honeyPriceList.pricePerJarCents
+    }
+}
