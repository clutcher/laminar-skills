diff --git a/product-availability-api/build.gradle.kts b/product-availability-api/build.gradle.kts
new file mode 100644
--- /dev/null
+++ b/product-availability-api/build.gradle.kts
@@ -0,0 +1,7 @@
+plugins {
+    java
+}
+
+dependencies {
+    implementation("org.springframework.boot:spring-boot-starter-graphql:3.3.4")
+}
diff --git a/product-availability-api/src/main/resources/graphql/availability.graphqls b/product-availability-api/src/main/resources/graphql/availability.graphqls
new file mode 100644
--- /dev/null
+++ b/product-availability-api/src/main/resources/graphql/availability.graphqls
@@ -0,0 +1,46 @@
+scalar BigDecimal
+scalar SecondsSinceEpoch
+
+type Query {
+    availability(input: ProductAvailabilityInput!): Availability
+}
+
+type Availability {
+    stockLevels: [StockLevel!]
+    replenishments: [Replenishment!]
+    returnTerm: ReturnTerm
+}
+
+input ProductAvailabilityInput {
+    productId: ID!
+    accountId: ID!
+}
+
+type ReturnTerm {
+    returnable: Boolean!
+    restockFee: BigDecimal
+}
+
+type StockLevel {
+    warehouse: Warehouse!
+    available: Int!
+    onHand: Int
+    status: StockLevelStatus!
+}
+
+type Warehouse {
+    name: String!
+    shippingPoint: String
+    primary: Boolean!
+}
+
+enum StockLevelStatus {
+    IN_STOCK
+    LOW_STOCK
+    OUT_OF_STOCK
+}
+
+type Replenishment {
+    quantity: Int!
+    estimatedShipDate: SecondsSinceEpoch
+}
