+++ b/bakery/src/main/java/com/example/bakery/pricing/PriceTable.java
@@ -0,0 +1,17 @@
+package com.example.bakery.pricing;
+
+import org.jspecify.annotations.Nullable;
+
+import java.math.BigDecimal;
+import java.util.Map;
+
+public record PriceTable(Map<String, BigDecimal> unitPricesByProductCode) {
+
+    public static PriceTable createEmpty() {
+        return new PriceTable(Map.of());
+    }
+
+    public @Nullable BigDecimal findUnitPrice(String productCode) {
+        return unitPricesByProductCode.get(productCode);
+    }
+}
