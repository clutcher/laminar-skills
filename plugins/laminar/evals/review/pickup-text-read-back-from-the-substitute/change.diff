+using System.Collections.Generic;
+
+namespace Bakery.Pickup.Tests;
+
+public class KeepingSmsSender : ISmsSender
+{
+    private readonly List<KeptSms> _keptMessages = new();
+
+    public IReadOnlyList<KeptSms> KeptMessages => _keptMessages;
+
+    public bool Send(string phone, string text)
+    {
+        _keptMessages.Add(new KeptSms(phone, text));
+        return true;
+    }
+
+    public record KeptSms(string Phone, string Text);
+}
