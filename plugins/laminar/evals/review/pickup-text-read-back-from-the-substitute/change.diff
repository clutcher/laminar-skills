+using System;
+using Moq;
+using Xunit;
+
+namespace Bakery.Pickup.Tests;
+
+public class PickupNoticeTest
+{
+    private static readonly CakeOrder ReadyLemonCakeOrder = new("lemon cake", "Linden Street 4", new TimeOnly(13, 0), "+44 7700 900123", OrderStatus.Ready);
+
+    [Fact]
+    public void ShouldTextThePickupTimeWhenTheCakeIsReady()
+    {
+        // given
+        var smsSender = new KeepingSmsSender();
+        var pickupNotice = new PickupNotice(smsSender);
+
+        // when
+        pickupNotice.NotifyReady(ReadyLemonCakeOrder);
+
+        // then
+        var expectedSms = new KeepingSmsSender.KeptSms("+44 7700 900123", "Your lemon cake is ready at Linden Street 4 from 15:00.");
+        Assert.Equal(new[] { expectedSms }, smsSender.KeptMessages);
+    }
+
+    [Fact]
+    public void ShouldTextThePickupAddressWhenTheCakeIsReady()
+    {
+        // given
+        string? sentText = null;
+        var smsSender = new Mock<ISmsSender>();
+        smsSender.Setup(sender => sender.Send(ReadyLemonCakeOrder.CustomerPhone, It.IsAny<string>()))
+            .Callback<string, string>((phone, text) => sentText = text)
+            .Returns(true);
+        var pickupNotice = new PickupNotice(smsSender.Object);
+
+        // when
+        pickupNotice.NotifyReady(ReadyLemonCakeOrder);
+
+        // then
+        Assert.Contains("Linden Street 4", sentText);
+    }
+
+    [Fact]
+    public void ShouldSendNoTextWhenTheOrderIsCancelled()
+    {
+        // given
+        var cancelledOrder = ReadyLemonCakeOrder with { Status = OrderStatus.Cancelled };
+        var smsSender = new KeepingSmsSender();
+        var pickupNotice = new PickupNotice(smsSender);
+
+        // when
+        pickupNotice.NotifyReady(cancelledOrder);
+
+        // then
+        Assert.Empty(smsSender.KeptMessages);
+    }
+}
