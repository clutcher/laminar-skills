+package com.example.cloakroom.coats;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class CoatTicketDeskTest {
+
+    @Test
+    void shouldHangTheNextCoatOnTheHookTheLastCoatFreedWhenACoatWasHandedBack() {
+        // given
+        CoatTicketDesk coatTicketDesk = new CoatTicketDesk(20);
+        coatTicketDesk.hangUpCoat();
+        CoatTicket secondTicket = coatTicketDesk.hangUpCoat();
+        coatTicketDesk.handBackCoat(secondTicket.ticketNumber());
+
+        // when
+        CoatTicket thirdTicket = coatTicketDesk.hangUpCoat();
+
+        // then
+        assertThat(thirdTicket.hookNumber()).isEqualTo(2);
+    }
+}
