+package com.example.cloakroom.coats;
+
+import java.util.ArrayDeque;
+import java.util.Deque;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Optional;
+
+public class CoatTicketDesk {
+
+    private final Deque<Integer> freeHookNumbers = new ArrayDeque<>();
+    private final Map<Integer, CoatTicket> ticketsByNumber = new HashMap<>();
+    private int lastTicketNumber;
+
+    public CoatTicketDesk(int hookCount) {
+        for (int hookNumber = 1; hookNumber <= hookCount; hookNumber++) {
+            freeHookNumbers.add(hookNumber);
+        }
+    }
+
+    public CoatTicket hangUpCoat() {
+        lastTicketNumber++;
+        CoatTicket coatTicket = new CoatTicket(lastTicketNumber, freeHookNumbers.removeFirst());
+        ticketsByNumber.put(coatTicket.ticketNumber(), coatTicket);
+        return coatTicket;
+    }
+
+    public Optional<Integer> findHookOfTicket(int ticketNumber) {
+        return Optional.ofNullable(ticketsByNumber.get(ticketNumber)).map(CoatTicket::hookNumber);
+    }
+
+    public void handBackCoat(int ticketNumber) {
+        CoatTicket coatTicket = ticketsByNumber.remove(ticketNumber);
+        freeHookNumbers.addFirst(coatTicket.hookNumber());
+    }
+}
