+package com.example.cloakroom.coats;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class LostTicketCoatTicketDeskTest {
+
+    @Test
+    void shouldFindNoHookWhenTheVisitorShowsATicketTheDeskNeverGaveOut() {
+        // given
+        CoatTicketDesk coatTicketDesk = new CoatTicketDesk(20);
+        coatTicketDesk.hangUpCoat();
+
+        // when
+        var hookNumber = coatTicketDesk.findHookOfTicket(57);
+
+        // then
+        assertThat(hookNumber).isEmpty();
+    }
+
+    @Test
+    void shouldFindNoHookWhenTheCoatOfTheTicketWasAlreadyHandedBack() {
+        // given
+        CoatTicketDesk coatTicketDesk = new CoatTicketDesk(20);
+        CoatTicket coatTicket = coatTicketDesk.hangUpCoat();
+        coatTicketDesk.handBackCoat(coatTicket.ticketNumber());
+
+        // when
+        var hookNumber = coatTicketDesk.findHookOfTicket(coatTicket.ticketNumber());
+
+        // then
+        assertThat(hookNumber).isEmpty();
+    }
+}
