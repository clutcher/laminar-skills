@@ -0,0 +1,9 @@
+package com.example.marina.berths
+
+class BerthScheduleService(private val harbourMaster: HarbourMaster) {
+
+    fun schedule(request: BerthRequest): BerthSchedule =
+        BerthScheduleBuilder.from(harbourMaster.scheduleFor(request.harbour))
+            .withOverflowSlotsFor(request)
+            .build()
+}
