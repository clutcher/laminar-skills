+package com.example.marina.berths
+
+class BerthScheduleBuilder private constructor(private val harbour: String, private val slots: MutableList<String>) {
+
+    fun withOverflowSlotsFor(request: BerthRequest): BerthScheduleBuilder {
+        val unplacedVessels = request.vessels.filter { vessel -> vessel !in slots }
+        slots += unplacedVessels.map { vessel -> "overflow-$vessel" }
+        return this
+    }
+
+    fun build(): BerthSchedule = BerthSchedule(harbour, slots.toList())
+
+    companion object {
+
+        fun from(schedule: BerthSchedule): BerthScheduleBuilder = BerthScheduleBuilder(schedule.harbour, schedule.slots.toMutableList())
+    }
+}
