+package com.example.allotment.harvests;
+
+import java.util.List;
+
+public class HarvestLedger {
+
+    private final List<Harvest> harvests;
+
+    public HarvestLedger(List<Harvest> harvests) {
+        this.harvests = List.copyOf(harvests);
+    }
+
+    public int sumHarvestedGrams(String variety) {
+        int harvestedGrams = 0;
+        for (Harvest harvest : harvests) {
+            if (harvest.variety().equals(variety)) {
+                harvestedGrams += harvest.weightInGrams();
+            }
+        }
+        return harvestedGrams;
+    }
+}
