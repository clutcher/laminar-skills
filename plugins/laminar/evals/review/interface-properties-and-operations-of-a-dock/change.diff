+import { BikeDock } from "./BikeDock";
+
+export class KerbsideBikeDock implements BikeDock {
+  private readonly occupiedSlots = new Set<number>();
+
+  constructor(
+    readonly dockCode: string,
+    readonly slotCount: number,
+  ) {}
+
+  lockBike(slot: number): void {
+    if (this.occupiedSlots.has(slot)) {
+      throw new Error(`Slot ${slot} of dock ${this.dockCode} already holds a bike`);
+    }
+
+    this.occupiedSlots.add(slot);
+  }
+
+  releaseBike(slot: number): void {
+    this.occupiedSlots.delete(slot);
+  }
+
+  listFreeSlots(): number[] {
+    const freeSlots: number[] = [];
+    for (let slot = 1; slot <= this.slotCount; slot++) {
+      if (!this.occupiedSlots.has(slot)) {
+        freeSlots.push(slot);
+      }
+    }
+    return freeSlots;
+  }
+}
