diff --git a/bookshop/catalogue/supplier_feed_import.py b/bookshop/catalogue/supplier_feed_import.py
new file mode 100644
--- /dev/null
+++ b/bookshop/catalogue/supplier_feed_import.py
@@ -0,0 +1,13 @@
+from bookshop.catalogue.book import Book
+from bookshop.catalogue.book_store import BookStore
+
+
+class SupplierFeedImport:
+
+    def __init__(self, store: BookStore):
+        self.store = store
+
+    def import_rows(self, rows: list[dict]) -> int:
+        for row in rows:
+            self.store.save(Book(isbn=row["isbn"], title=row["title"], genre=row["genre"]))
+        return len(rows)
