diff --git a/bookshop/catalogue/book_store.py b/bookshop/catalogue/book_store.py
new file mode 100644
--- /dev/null
+++ b/bookshop/catalogue/book_store.py
@@ -0,0 +1,10 @@
+from bookshop.catalogue.book import Book
+
+
+class BookStore:
+
+    def __init__(self):
+        self.books_by_isbn: dict[str, Book] = {}
+
+    def save(self, book: Book) -> None:
+        self.books_by_isbn[book.isbn] = book
