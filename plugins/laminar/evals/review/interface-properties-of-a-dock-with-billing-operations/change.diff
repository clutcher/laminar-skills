@@ -0,0 +1,20 @@
+import { BikeDock } from "./BikeDock";
+import { OverdueNoticeSender } from "./OverdueNoticeSender";
+import { PaymentGateway } from "./PaymentGateway";
+
+export class KerbsideBikeDock implements BikeDock {
+  constructor(
+    readonly dockCode: string,
+    readonly slotCount: number,
+    private readonly paymentGateway: PaymentGateway,
+    private readonly overdueNoticeSender: OverdueNoticeSender,
+  ) {}
+
+  async chargeMember(memberId: string, amountInCents: number): Promise<void> {
+    await this.paymentGateway.charge(memberId, amountInCents);
+  }
+
+  async sendOverdueNotice(memberId: string): Promise<void> {
+    await this.overdueNoticeSender.send(memberId, this.dockCode);
+  }
+}
