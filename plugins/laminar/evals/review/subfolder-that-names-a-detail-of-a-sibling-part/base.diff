@@ -0,0 +1,10 @@
+package com.example.apiary.hives
+
+class HiveService(private val hiveRepository: HiveRepository) {
+
+    fun registerHive(hiveId: String, apiaryYard: String) {
+        hiveRepository.saveHive(Hive(hiveId, apiaryYard, colonyCount = 1))
+    }
+
+    fun findHive(hiveId: String): Hive? = hiveRepository.findHive(hiveId)
+}
