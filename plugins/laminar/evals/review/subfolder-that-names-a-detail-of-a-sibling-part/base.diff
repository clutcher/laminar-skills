+package com.example.apiary.hives.inspections
+
+import java.time.LocalDate
+
+class InspectionSchedule(private val daysBetweenInspections: Long) {
+
+    fun getNextInspectionDate(lastReport: InspectionReport): LocalDate =
+        lastReport.inspectedOn.plusDays(daysBetweenInspections)
+}
