+package com.example.bakery.delivery;
+
+import java.time.LocalDate;
+
+public record DeliveryEstimate(LocalDate earliestDay) {
+
+    private static final DeliveryEstimate NONE = new DeliveryEstimate(null);
+
+    public static DeliveryEstimate none() {
+        return NONE;
+    }
+
+    public boolean isNone() {
+        return earliestDay == null;
+    }
+}
