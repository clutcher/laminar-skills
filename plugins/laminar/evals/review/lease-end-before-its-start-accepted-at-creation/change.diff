@@ -0,0 +1,28 @@
+package com.example.allotment.lease;
+
+import java.time.LocalDate;
+
+public class ShedLease {
+
+    private final LocalDate startsOn;
+    private LocalDate endsOn;
+
+    public ShedLease(LocalDate startsOn, LocalDate endsOn) {
+        if (!endsOn.isAfter(startsOn)) {
+            throw new IllegalArgumentException("A shed lease ends after it starts");
+        }
+        this.startsOn = startsOn;
+        this.endsOn = endsOn;
+    }
+
+    public void moveEndTo(LocalDate newEnd) {
+        if (!newEnd.isAfter(startsOn)) {
+            throw new IllegalArgumentException("A shed lease ends after it starts");
+        }
+        this.endsOn = newEnd;
+    }
+
+    public LocalDate endsOn() {
+        return endsOn;
+    }
+}
