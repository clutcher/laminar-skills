+using System;
+
+namespace Bakery.Pickup;
+
+public class PickupNotice
+{
+    private static readonly TimeSpan CoolingTime = TimeSpan.FromHours(2);
+
+    private readonly ISmsSender _smsSender;
+
+    public PickupNotice(ISmsSender smsSender)
+    {
+        _smsSender = smsSender;
+    }
+
+    public PickupNoticeResult NotifyReady(CakeOrder order)
+    {
+        if (order.Status == OrderStatus.Cancelled)
+        {
+            return PickupNoticeResult.NothingAnnounced;
+        }
+
+        TimeOnly pickupFrom = order.BakedAt.Add(CoolingTime);
+        string pickupText = $"Your {order.CakeName} is ready at {order.ShopAddress} from {pickupFrom:HH:mm}.";
+        bool sent = _smsSender.Send(order.CustomerPhone, pickupText);
+        return new PickupNoticeResult(sent, pickupFrom);
+    }
+}
