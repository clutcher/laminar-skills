+import { describe, expect, it } from "vitest";
+import { calculateSingleFareInCents } from "./fareCalculator";
+
+describe("calculateSingleFareInCents", () => {
+  it("should charge one zone when the ride stays inside zone A", () => {
+    // given
+    const fromStopName = "Central Station";
+    const toStopName = "Market Square";
+
+    // when
+    const fareInCents = calculateSingleFareInCents(fromStopName, toStopName);
+
+    // then
+    expect(fareInCents).toBe(120);
+  });
+
+  it("should charge three zones when the ride goes from zone A to zone C", () => {
+    // given
+    const fromStopName = "Central Station";
+    const toStopName = "Harbour Gate";
+
+    // when
+    const fareInCents = calculateSingleFareInCents(fromStopName, toStopName);
+
+    // then
+    expect(fareInCents).toBe(360);
+  });
+});
diff --git a/tram-fares/src/fares/fareCalculator.ts b/tram-fares/src/fares/fareCalculator.ts
new file mode 100644
--- /dev/null
+++ b/tram-fares/src/fares/fareCalculator.ts
@@ -0,0 +1,8 @@
+import { countZonesCrossed, findZoneOfStop } from "./zoneMap";
+
+const FARE_PER_ZONE_IN_CENTS = 120;
+
+export const calculateSingleFareInCents = (fromStopName: string, toStopName: string): number => {
+  const zonesCrossed = countZonesCrossed(findZoneOfStop(fromStopName), findZoneOfStop(toStopName));
+  return zonesCrossed * FARE_PER_ZONE_IN_CENTS;
+};
diff --git a/tram-fares/src/fares/zoneMap.ts b/tram-fares/src/fares/zoneMap.ts
