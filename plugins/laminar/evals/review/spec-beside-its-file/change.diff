@@ -0,0 +1,20 @@
+export type Zone = "A" | "B" | "C";
+
+const ZONE_BY_STOP_NAME: Record<string, Zone> = {
+  "Central Station": "A",
+  "Market Square": "A",
+  "Riverside": "B",
+  "University": "B",
+  "Harbour Gate": "C",
+};
+
+export const findZoneOfStop = (stopName: string): Zone => {
+  const zone = ZONE_BY_STOP_NAME[stopName];
+  if (zone === undefined) {
+    throw new Error(`No zone is known for the stop ${stopName}`);
+  }
+  return zone;
+};
+
+export const countZonesCrossed = (fromZone: Zone, toZone: Zone): number =>
+  Math.abs(fromZone.charCodeAt(0) - toZone.charCodeAt(0)) + 1;
