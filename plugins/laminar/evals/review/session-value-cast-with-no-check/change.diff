+package com.example.harbourferry.checkin;
+
+import com.example.harbourferry.voyage.Voyage;
+
+public class CurrentVoyageService {
+
+    private static final String CURRENT_VOYAGE_SESSION_KEY = "currentVoyage";
+
+    private final SessionStore sessionStore;
+
+    public CurrentVoyageService(SessionStore sessionStore) {
+        this.sessionStore = sessionStore;
+    }
+
+    public Voyage getCurrentVoyage() {
+        return (Voyage) sessionStore.getAttribute(CURRENT_VOYAGE_SESSION_KEY);
+    }
+
+    public void setCurrentVoyage(Voyage voyage) {
+        sessionStore.setAttribute(CURRENT_VOYAGE_SESSION_KEY, voyage);
+    }
+}
