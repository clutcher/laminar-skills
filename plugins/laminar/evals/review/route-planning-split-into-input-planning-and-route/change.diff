+import { DeliveryOrder } from "./DeliveryOrder";
+
+export interface OrderSource {
+  findOrdersForDay(deliveryDay: string): Promise<DeliveryOrder[]>;
+}
+
+export class OrderReader {
+  constructor(private readonly orderSource: OrderSource) {}
+
+  async readOrdersForDay(deliveryDay: string): Promise<DeliveryOrder[]> {
+    const orders = await this.orderSource.findOrdersForDay(deliveryDay);
+    return orders.filter(order => order.parcelCount > 0);
+  }
+}
