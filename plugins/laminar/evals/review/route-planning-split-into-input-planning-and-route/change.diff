+import { Depot } from "./Depot";
+
+export class DepotDirectory {
+  constructor(private readonly depots: Depot[]) {}
+
+  findDepot(depotCode: string): Depot {
+    const depot = this.depots.find(candidate => candidate.depotCode === depotCode);
+    if (!depot) throw new Error(`No depot with code ${depotCode}`);
+    return depot;
+  }
+}
