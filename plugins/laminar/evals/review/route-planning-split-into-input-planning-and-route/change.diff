new file mode 100644
--- /dev/null
+++ b/courier-desk/src/route-planning/planning/sequencing/StopSequencer.ts
@@ -0,0 +1,21 @@
+import { DeliveryOrder } from "../../input/orders/DeliveryOrder";
+import { StopCluster } from "../clustering/StopCluster";
+import { TravelTimeTable } from "../../input/road-map/TravelTimeTable";
+import { SequencingLimits } from "./SequencingLimits";
+
+export class StopSequencer {
+  constructor(private readonly limits: SequencingLimits) {}
+
+  sequenceNearestFirst(cluster: StopCluster, startPostalCode: string, travelTimes: TravelTimeTable): DeliveryOrder[] {
+    const remaining = [...cluster.orders];
+    const sequence: DeliveryOrder[] = [];
+    let currentPostalCode = startPostalCode;
+    while (remaining.length > 0 && sequence.length < this.limits.maxStopsPerRoute) {
+      remaining.sort((first, second) => travelTimes.travelMinutes(currentPostalCode, first.postalCode) - travelTimes.travelMinutes(currentPostalCode, second.postalCode));
+      const nearest = remaining.shift()!;
+      sequence.push(nearest);
+      currentPostalCode = nearest.postalCode;
+    }
+    return sequence;
+  }
+}
