@@ -0,0 +1,29 @@
+import { OrderReader } from "../input/orders/OrderReader";
+import { DepotDirectory } from "../input/depots/DepotDirectory";
+import { RoadMapLoader } from "../input/road-map/RoadMapLoader";
+import { StopClusterer } from "./clustering/StopClusterer";
+import { StopSequencer } from "./sequencing/StopSequencer";
+import { Route } from "../route/Route";
+import { RouteStop } from "../route/RouteStop";
+
+export class PlanRoutesStep {
+  constructor(
+    private readonly orderReader: OrderReader,
+    private readonly depotDirectory: DepotDirectory,
+    private readonly roadMapLoader: RoadMapLoader,
+    private readonly stopClusterer: StopClusterer,
+    private readonly stopSequencer: StopSequencer,
+  ) {}
+
+  async planRoutes(deliveryDay: string, depotCode: string, region: string): Promise<Route[]> {
+    const depot = this.depotDirectory.findDepot(depotCode);
+    const orders = await this.orderReader.readOrdersForDay(deliveryDay);
+    const travelTimes = await this.roadMapLoader.loadTravelTimes(region);
+    const clusters = this.stopClusterer.clusterByPostalArea(orders, depot.vanCount);
+    return clusters.map(cluster => {
+      const sequence = this.stopSequencer.sequenceNearestFirst(cluster, cluster.orders[0].postalCode, travelTimes);
+      const stops = sequence.map((order, index): RouteStop => ({ stopNumber: index + 1, orderId: order.orderId, postalCode: order.postalCode }));
+      return { routeNumber: cluster.clusterNumber, depotCode: depot.depotCode, deliveryDay, stops, legs: [] };
+    });
+  }
+}
