+export class TravelTimeTable {
+  constructor(private readonly minutesByPostalCodePair: Map<string, number>) {}
+
+  travelMinutes(fromPostalCode: string, toPostalCode: string): number {
+    return this.minutesByPostalCodePair.get(`${fromPostalCode}>${toPostalCode}`) ?? Number.POSITIVE_INFINITY;
+  }
+}
