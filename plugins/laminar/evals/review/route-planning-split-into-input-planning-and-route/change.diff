+import { TravelTimeTable } from "./TravelTimeTable";
+
+export interface RoadMapSource {
+  loadTravelMinutes(region: string): Promise<Array<{ from: string; to: string; minutes: number }>>;
+}
+
+export class RoadMapLoader {
+  constructor(private readonly roadMapSource: RoadMapSource) {}
+
+  async loadTravelTimes(region: string): Promise<TravelTimeTable> {
+    const travelMinutes = await this.roadMapSource.loadTravelMinutes(region);
+    return new TravelTimeTable(new Map(travelMinutes.map(entry => [`${entry.from}>${entry.to}`, entry.minutes])));
+  }
+}
