--- /dev/null
+++ b/courier-desk/src/route-planning/planning/clustering/StopClusterer.ts
@@ -0,0 +1,14 @@
+import { DeliveryOrder } from "../../input/orders/DeliveryOrder";
+import { StopCluster } from "./StopCluster";
+
+export class StopClusterer {
+  clusterByPostalArea(orders: DeliveryOrder[], vanCount: number): StopCluster[] {
+    const sortedOrders = [...orders].sort((first, second) => first.postalCode.localeCompare(second.postalCode));
+    const ordersPerVan = Math.ceil(sortedOrders.length / vanCount);
+    const clusters: StopCluster[] = [];
+    for (let start = 0; start < sortedOrders.length; start += ordersPerVan) {
+      clusters.push({ clusterNumber: clusters.length + 1, orders: sortedOrders.slice(start, start + ordersPerVan) });
+    }
+    return clusters;
+  }
+}
