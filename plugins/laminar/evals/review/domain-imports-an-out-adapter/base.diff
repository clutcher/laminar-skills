diff --git a/greenhouse/src/greenhouse/in/http/watering_routes.py b/greenhouse/src/greenhouse/in/http/watering_routes.py
new file mode 100644
index 0000000..0612b6f
--- /dev/null
+++ b/greenhouse/src/greenhouse/in/http/watering_routes.py
@@ -0,0 +1,13 @@
+from fastapi import APIRouter
+
+from greenhouse.app.api.water_beds import WaterBeds
+
+
+def watering_routes(water_beds: WaterBeds) -> APIRouter:
+    router = APIRouter()
+
+    @router.post("/beds/{bed_id}/watering")
+    def water(bed_id: str) -> dict[str, int]:
+        return {"litres": water_beds.water_bed(bed_id)}
+
+    return router
