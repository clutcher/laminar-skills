@@ -0,0 +1,12 @@
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class Bed:
+    bed_id: str
+    crop: str
+    litres_per_square_metre: int
+    square_metres: int
+
+    def litres_needed(self) -> int:
+        return self.litres_per_square_metre * self.square_metres
diff --git a/greenhouse/src/greenhouse/app/domain/watering_service.py b/greenhouse/src/greenhouse/app/domain/watering_service.py
new file mode 100644
index 0000000..d81f034
--- /dev/null
+++ b/greenhouse/src/greenhouse/app/domain/watering_service.py
@@ -0,0 +1,15 @@
+from greenhouse.app.api.water_beds import WaterBeds
+from greenhouse.app.domain.bed import Bed
+from greenhouse.app.spi.valve_control import ValveControl
+
+
+class WateringService(WaterBeds):
+    def __init__(self, beds: dict[str, Bed], valve_control: ValveControl) -> None:
+        self._beds = beds
+        self._valve_control = valve_control
+
+    def water_bed(self, bed_id: str) -> int:
+        bed = self._beds[bed_id]
+        litres = bed.litres_needed()
+        self._valve_control.open_for_litres(bed_id, litres)
+        return litres
