diff --git a/greenhouse/src/greenhouse/out/valves/valve_control_using_mqtt.py b/greenhouse/src/greenhouse/out/valves/valve_control_using_mqtt.py
new file mode 100644
index 0000000..48ff022
--- /dev/null
+++ b/greenhouse/src/greenhouse/out/valves/valve_control_using_mqtt.py
@@ -0,0 +1,11 @@
+import paho.mqtt.publish as publish
+
+from greenhouse.app.spi.valve_control import ValveControl
+
+
+class ValveControlUsingMqtt(ValveControl):
+    def __init__(self, broker_host: str) -> None:
+        self._broker_host = broker_host
+
+    def open_for_litres(self, bed_id: str, litres: int) -> None:
+        publish.single(f"valves/{bed_id}", str(litres), hostname=self._broker_host)
