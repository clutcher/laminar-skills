+import httpx
+
+
+class SoilProbeClient:
+    def __init__(self, probe_url: str) -> None:
+        self._probe_url = probe_url
+
+    def moisture_percent_of(self, bed_id: str) -> int:
+        response = httpx.get(f"{self._probe_url}/beds/{bed_id}/moisture")
+        return int(response.json()["percent"])
