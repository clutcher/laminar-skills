+package com.example.shop.cart.quantity;
+
+public final class CartLineQuantityNotice {
+
+    private CartLineQuantityNotice() {}
+
+    public static QuantityNotice noticeFor(CartLine line) {
+        if (line.hasErpNotice(ErpNotice.ADJUSTED_TO_CONTRACT)) {
+            return QuantityNotice.ADJUSTED_TO_CONTRACT;
+        }
+        if (!isRaisedAboveRequestedQuantity(line)) {
+            return QuantityNotice.NONE;
+        }
+        if (isRaisedToMinimum(line)) {
+            return QuantityNotice.RAISED_TO_MINIMUM;
+        }
+        return QuantityNotice.ROUNDED_UP_TO_PACK_SIZE;
+    }
+
+    private static boolean isRaisedAboveRequestedQuantity(CartLine line) {
+        Integer requestedQuantity = line.requestedQuantity();
+        Integer erpQuantity = line.erpQuantity();
+        if (requestedQuantity == null || erpQuantity == null) {
+            return false;
+        }
+        return erpQuantity > requestedQuantity;
+    }
+
+    private static boolean isRaisedToMinimum(CartLine line) {
+        return line.hasErpNotice(ErpNotice.RAISED_TO_MINIMUM) || reachesMinimumOrderQuantity(line);
+    }
+
+    private static boolean reachesMinimumOrderQuantity(CartLine line) {
+        Integer minimumOrderQuantity = line.minimumOrderQuantity();
+        Integer requestedQuantity = line.requestedQuantity();
+        Integer erpQuantity = line.erpQuantity();
+        return minimumOrderQuantity != null && requestedQuantity != null && erpQuantity != null
+            && requestedQuantity < minimumOrderQuantity && erpQuantity >= minimumOrderQuantity;
+    }
+}
