+package com.example.shop.order;
+
+import com.example.shop.mail.EmailMessage;
+import com.example.shop.mail.EmailMessageFactory;
+import com.example.shop.mail.EmailService;
+import lombok.RequiredArgsConstructor;
+
+@RequiredArgsConstructor
+public class OrderConfirmationService {
+
+    private final EmailMessageFactory emailMessageFactory;
+    private final EmailService emailService;
+
+    public void sendOrderConfirmation(Order order) {
+        EmailMessage message = emailMessageFactory.createConfirmationMessage(order);
+        emailService.send(message);
+    }
+}
