+package com.example.bikeshare.pricing.internal;
+
+import org.springframework.stereotype.Component;
+
+import java.time.LocalDate;
+
+@Component
+public final class RidePriceCalculator {
+
+    private final SeasonalRateTable seasonalRates;
+
+    RidePriceCalculator(SeasonalRateTable seasonalRates) {
+        this.seasonalRates = seasonalRates;
+    }
+
+    public int priceInCentsFor(RideDuration ridden, LocalDate rideDate) {
+        return ridden.minutes() * seasonalRates.centsPerMinuteOn(rideDate);
+    }
+
+    public int longRideDiscountInCentsFor(RideDuration ridden) {
+        return ridden.minutes() >= 60 ? seasonalRates.longRideDiscountInCents() : 0;
+    }
+}
