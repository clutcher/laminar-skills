+package com.example.bikeshare.pricing.internal;
+
+import org.springframework.stereotype.Component;
+
+import java.time.LocalDate;
+import java.time.Month;
+
+@Component
+class SeasonalRateTable {
+
+    private static final int SUMMER_CENTS_PER_MINUTE = 18;
+
+    private static final int WINTER_CENTS_PER_MINUTE = 11;
+
+    private static final int LONG_RIDE_DISCOUNT_IN_CENTS = 250;
+
+    int centsPerMinuteOn(LocalDate rideDate) {
+        Month month = rideDate.getMonth();
+        boolean summer = month.getValue() >= Month.MAY.getValue() && month.getValue() <= Month.SEPTEMBER.getValue();
+        return summer ? SUMMER_CENTS_PER_MINUTE : WINTER_CENTS_PER_MINUTE;
+    }
+
+    int longRideDiscountInCents() {
+        return LONG_RIDE_DISCOUNT_IN_CENTS;
+    }
+}
