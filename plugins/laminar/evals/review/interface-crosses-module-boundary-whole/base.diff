+package com.example.bikeshare.station.internal;
+
+import org.springframework.stereotype.Component;
+
+import java.util.Map;
+import java.util.Optional;
+
+@Component
+class StationDirectoryUsingMemory implements StationDirectory {
+
+    private static final Map<String, String> STATION_NAMES_BY_ID = Map.of(
+        "ST-0114", "Harbour Gate",
+        "ST-0231", "Old Mill Bridge",
+        "ST-0347", "Linden Park North");
+
+    @Override
+    public Optional<String> stationNameFor(String stationId) {
+        return Optional.ofNullable(STATION_NAMES_BY_ID.get(stationId));
+    }
+}
