+package com.example.bikeshare.ride.internal;
+
+import com.example.bikeshare.pricing.RideDuration;
+import org.springframework.format.annotation.DateTimeFormat;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+import java.time.LocalDate;
+
+@RestController
+class RideChargeController {
+
+    private final RideChargeCalculator rideCharges;
+
+    RideChargeController(RideChargeCalculator rideCharges) {
+        this.rideCharges = rideCharges;
+    }
+
+    @GetMapping("/rides/charge")
+    int amountToChargeInCents(@RequestParam int minutes, @RequestParam @DateTimeFormat(iso = DateTimeFormat.ISO.DATE) LocalDate rideDate) {
+        return rideCharges.amountToChargeInCentsFor(new RideDuration(minutes), rideDate);
+    }
+}
