+package com.example.bikeshare.ride.internal;
+
+import com.example.bikeshare.pricing.RideDuration;
+import com.example.bikeshare.pricing.RidePriceCalculator;
+import org.springframework.stereotype.Service;
+
+import java.time.LocalDate;
+
+@Service
+class RideChargeCalculator {
+
+    private final RidePriceCalculator ridePrices;
+
+    RideChargeCalculator(RidePriceCalculator ridePrices) {
+        this.ridePrices = ridePrices;
+    }
+
+    int amountToChargeInCentsFor(RideDuration ridden, LocalDate rideDate) {
+        return ridePrices.priceInCentsFor(ridden, rideDate) - ridePrices.longRideDiscountInCentsFor(ridden);
+    }
+}
