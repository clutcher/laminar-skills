diff --git a/courier-desk/src/handover/HandoverStep.ts b/courier-desk/src/handover/HandoverStep.ts
new file mode 100644
--- /dev/null
+++ b/courier-desk/src/handover/HandoverStep.ts
@@ -0,0 +1,29 @@
+import { RecipientSignature } from "./RecipientSignature";
+import { SafePlaceChoice } from "./SafePlaceChoice";
+import { NeighbourHandover } from "./NeighbourHandover";
+import { CardForNeighbourHandover } from "./CardForNeighbourHandover";
+import { CardPaymentOnHandover } from "./CardPaymentOnHandover";
+import { CardIdentityCheck } from "./CardIdentityCheck";
+
+export class HandoverStep {
+  constructor(
+    private readonly recipientSignature: RecipientSignature,
+    private readonly safePlaceChoice: SafePlaceChoice,
+    private readonly neighbourHandover: NeighbourHandover,
+    private readonly cardForNeighbourHandover: CardForNeighbourHandover,
+    private readonly cardPaymentOnHandover: CardPaymentOnHandover,
+    private readonly cardIdentityCheck: CardIdentityCheck,
+  ) {}
+
+  handOverParcel(parcelId: string, recipientIsHome: boolean, amountDueInCents: number, recipientBirthYear: number, neighbourAddress: string): string {
+    if (recipientIsHome) {
+      if (!this.cardIdentityCheck.isOldEnough(parcelId, recipientBirthYear)) return `refused:${parcelId}`;
+      if (amountDueInCents > 0) this.cardPaymentOnHandover.takePayment(parcelId, amountDueInCents);
+      return this.recipientSignature.collectSignature(parcelId);
+    }
+    const safePlace = this.safePlaceChoice.findSafePlace(parcelId);
+    if (safePlace) return safePlace;
+    this.neighbourHandover.recordNeighbour(parcelId, neighbourAddress);
+    return this.cardForNeighbourHandover.leaveCard(parcelId, neighbourAddress);
+  }
+}
