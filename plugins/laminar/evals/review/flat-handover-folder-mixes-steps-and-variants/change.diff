@@ -0,0 +1,8 @@
+export class CardForNeighbourHandover {
+  private readonly cardsLeft: string[] = [];
+
+  leaveCard(parcelId: string, neighbourAddress: string): string {
+    this.cardsLeft.push(parcelId);
+    return `card-left:${parcelId}:with ${neighbourAddress}`;
+  }
+}
diff --git a/courier-desk/src/handover/CardIdentityCheck.ts b/courier-desk/src/handover/CardIdentityCheck.ts
new file mode 100644
--- /dev/null
+++ b/courier-desk/src/handover/CardIdentityCheck.ts
@@ -0,0 +1,8 @@
+export class CardIdentityCheck {
+  private readonly minimumAgeByParcel = new Map<string, number>();
+
+  isOldEnough(parcelId: string, recipientBirthYear: number): boolean {
+    const minimumAge = this.minimumAgeByParcel.get(parcelId) ?? 0;
+    return new Date().getFullYear() - recipientBirthYear >= minimumAge;
+  }
+}
