+    this.neighbourByParcel.set(parcelId, neighbourAddress);
+  }
+}
diff --git a/courier-desk/src/handover/RecipientSignature.ts b/courier-desk/src/handover/RecipientSignature.ts
new file mode 100644
--- /dev/null
+++ b/courier-desk/src/handover/RecipientSignature.ts
@@ -0,0 +1,8 @@
+export class RecipientSignature {
+  private readonly signedParcels = new Set<string>();
+
+  collectSignature(parcelId: string): string {
+    this.signedParcels.add(parcelId);
+    return `signed:${parcelId}`;
+  }
+}
diff --git a/courier-desk/src/handover/SafePlaceChoice.ts b/courier-desk/src/handover/SafePlaceChoice.ts
