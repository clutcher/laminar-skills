+package com.example.quote.out;
+
+import com.example.quote.app.spi.CoverRates;
+import java.math.BigDecimal;
+import java.util.Map;
+import java.util.Set;
+import org.springframework.stereotype.Component;
+import org.springframework.web.client.RestClient;
+
+@Component
+public class CoverRatesClient implements CoverRates {
+
+    private final RestClient ratingRestClient;
+
+    public CoverRatesClient(RestClient ratingRestClient) {
+        this.ratingRestClient = ratingRestClient;
+    }
+
+    @Override
+    public Map<String, BigDecimal> annualRatesFor(Set<String> coverCodes) {
+        CoverRateResponse response = ratingRestClient.get()
+                .uri(uri -> uri.path("/cover-rates").queryParam("codes", coverCodes).build())
+                .retrieve()
+                .body(CoverRateResponse.class);
+        return response.annualRates();
+    }
+
+    record CoverRateResponse(Map<String, BigDecimal> annualRates) {
+    }
+}
