+package com.example.quote.app.services;
+
+import com.example.quote.app.api.QuoteCalculation;
+import com.example.quote.app.domain.CoverLine;
+import com.example.quote.app.domain.LinePremium;
+import com.example.quote.app.domain.QuoteResult;
+import com.example.quote.app.spi.CoverRates;
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.stream.Collectors;
+import org.springframework.stereotype.Service;
+
+@Service
+public class QuoteCalculationService implements QuoteCalculation {
+
+    private final CoverRates coverRates;
+    private final UnderwritingNoticeRules underwritingNoticeRules;
+
+    public QuoteCalculationService(CoverRates coverRates, UnderwritingNoticeRules underwritingNoticeRules) {
+        this.coverRates = coverRates;
+        this.underwritingNoticeRules = underwritingNoticeRules;
+    }
+
+    @Override
+    public QuoteResult calculate(List<CoverLine> coverLines) {
+        Set<String> coverCodes = coverLines.stream().map(CoverLine::coverCode).collect(Collectors.toSet());
+        Map<String, BigDecimal> annualRates = coverRates.annualRatesFor(coverCodes);
+        List<LinePremium> linePremiums = coverLines.stream()
+                .map(coverLine -> premiumOf(coverLine, annualRates.getOrDefault(coverLine.coverCode(), BigDecimal.ZERO)))
+                .toList();
+        BigDecimal totalPremium = linePremiums.stream().map(LinePremium::premium).reduce(BigDecimal.ZERO, BigDecimal::add);
+        return new QuoteResult(linePremiums, totalPremium, underwritingNoticeRules.noticesFor(linePremiums, totalPremium));
+    }
+
+    private LinePremium premiumOf(CoverLine coverLine, BigDecimal annualRate) {
+        BigDecimal premium = coverLine.insuredValue().multiply(annualRate).setScale(2, RoundingMode.HALF_UP);
+        return new LinePremium(coverLine.coverCode(), premium);
+    }
+}
