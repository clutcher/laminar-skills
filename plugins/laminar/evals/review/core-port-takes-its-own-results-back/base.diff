+package com.example.quote.app.domain;
+
+import java.math.BigDecimal;
+import java.util.List;
+
+public record QuoteResult(List<LinePremium> linePremiums, BigDecimal totalPremium, List<UnderwritingNotice> notices) {
+
+    public LinePremium premiumFor(String coverCode) {
+        return linePremiums.stream()
+                .filter(linePremium -> linePremium.coverCode().equals(coverCode))
+                .findFirst()
+                .orElseThrow();
+    }
+}
