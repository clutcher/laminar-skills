@@ -0,0 +1,26 @@
+package com.example.quote.app.services;
+
+import com.example.quote.app.domain.LinePremium;
+import com.example.quote.app.domain.UnderwritingNotice;
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.List;
+import org.springframework.stereotype.Service;
+
+@Service
+public class UnderwritingNoticeRules {
+
+    private static final BigDecimal REFERRAL_PREMIUM = new BigDecimal("25000.00");
+
+    public List<UnderwritingNotice> noticesFor(List<LinePremium> linePremiums, BigDecimal totalPremium) {
+        List<UnderwritingNotice> notices = new ArrayList<>();
+        linePremiums.stream()
+                .filter(linePremium -> linePremium.premium().signum() == 0)
+                .map(linePremium -> new UnderwritingNotice(linePremium.coverCode(), "Cover has no rate and goes to an underwriter"))
+                .forEach(notices::add);
+        if (totalPremium.compareTo(REFERRAL_PREMIUM) > 0) {
+            notices.add(new UnderwritingNotice("quote", "Quote is above the referral premium"));
+        }
+        return notices;
+    }
+}
