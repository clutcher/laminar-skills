index 0000000..08deb8d
--- /dev/null
+++ b/ferry/src/main/java/com/example/harbourferry/booking/adapter/JdbcTicketStore.java
@@ -0,0 +1,21 @@
+package com.example.harbourferry.booking.adapter;
+
+import com.example.harbourferry.booking.domain.Ticket;
+import com.example.harbourferry.booking.domain.TicketStore;
+import lombok.RequiredArgsConstructor;
+import org.springframework.jdbc.core.simple.JdbcClient;
+import org.springframework.stereotype.Repository;
+
+@Repository
+@RequiredArgsConstructor
+public class JdbcTicketStore implements TicketStore {
+
+    private final JdbcClient jdbcClient;
+
+    @Override
+    public void save(Ticket ticket) {
+        jdbcClient.sql("INSERT INTO ticket (route, departure, seat_number, fare_cents) VALUES (?, ?, ?, ?)")
+            .params(ticket.crossing().route(), ticket.crossing().departure(), ticket.seatNumber(), ticket.fareCents())
+            .update();
+    }
+}
