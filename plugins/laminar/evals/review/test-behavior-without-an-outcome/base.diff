@@ -0,0 +1,21 @@
+package com.example.harbourferry.booking.adapter;
+
+import com.example.harbourferry.booking.domain.RouteFares;
+import lombok.RequiredArgsConstructor;
+import org.springframework.stereotype.Component;
+import org.springframework.web.client.RestClient;
+
+@Component
+@RequiredArgsConstructor
+public class HttpRouteFares implements RouteFares {
+
+    private final RestClient fareServiceClient;
+
+    @Override
+    public int fareFor(String route) {
+        return fareServiceClient.get()
+            .uri("/fares?route={route}", route)
+            .retrieve()
+            .body(Integer.class);
+    }
+}
diff --git a/ferry/src/main/java/com/example/harbourferry/booking/adapter/JdbcTicketStore.java b/ferry/src/main/java/com/example/harbourferry/booking/adapter/JdbcTicketStore.java
