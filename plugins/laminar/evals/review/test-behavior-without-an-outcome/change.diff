+package com.example.harbourferry.booking.web;
+
+import com.example.harbourferry.booking.domain.BookingRequest;
+import com.example.harbourferry.booking.domain.RouteFares;
+import com.example.harbourferry.booking.domain.SeatAllocation;
+import com.example.harbourferry.booking.domain.Ticket;
+import com.example.harbourferry.booking.domain.TicketStore;
+import lombok.RequiredArgsConstructor;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+@RequestMapping("/crossings/bookings")
+@RequiredArgsConstructor
+public class CrossingBookingController {
+
+    private final SeatAllocation seatAllocation;
+    private final RouteFares routeFares;
+    private final TicketStore ticketStore;
+
+    @PostMapping
+    public Ticket book(@RequestBody BookingRequest request) {
+        int seatNumber = seatAllocation.lowestFreeSeatOn(request.crossing());
+        int fareCents = routeFares.fareFor(request.crossing().route());
+        Ticket ticket = new Ticket(request.crossing(), seatNumber, fareCents);
+        ticketStore.save(ticket);
+        return ticket;
+    }
+}
