+package com.example.harbourferry.booking.domain;
+
+import org.springframework.stereotype.Component;
+
+@Component
+public class SeatAllocation {
+
+    public int lowestFreeSeatOn(Crossing crossing) {
+        if (crossing.seatsLeft().isEmpty()) {
+            throw new CrossingFull(crossing);
+        }
+        return crossing.seatsLeft().first();
+    }
+}
