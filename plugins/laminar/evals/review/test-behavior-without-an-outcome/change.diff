+package com.example.harbourferry.booking.web;
+
+import com.example.harbourferry.booking.domain.BookingRequest;
+import com.example.harbourferry.booking.domain.Crossing;
+import com.example.harbourferry.booking.domain.CrossingFull;
+import com.example.harbourferry.booking.domain.RouteFares;
+import com.example.harbourferry.booking.domain.SeatAllocation;
+import com.example.harbourferry.booking.domain.Ticket;
+import com.example.harbourferry.booking.domain.TicketStore;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+
+import java.time.LocalDateTime;
+import java.util.List;
+import java.util.TreeSet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.BDDMockito.given;
+import static org.mockito.Mockito.verify;
+
+@ExtendWith(MockitoExtension.class)
+class CrossingBookingControllerTest {
+
+    private static final String KELMAR_HARBOUR_TO_OSTVIK = "Kelmar Harbour to Ostvik";
+    private static final LocalDateTime EARLY_MORNING_DEPARTURE = LocalDateTime.of(2026, 10, 3, 7, 40);
+    private static final String PASSENGER = "Ingrid Solberg";
+
+    @Mock
+    private TicketStore ticketStore;
+
+    @Mock
+    private RouteFares routeFares;
+
+    private CrossingBookingController crossingBookingController;
+
+    @BeforeEach
+    void setUp() {
+        crossingBookingController = new CrossingBookingController(new SeatAllocation(), routeFares, ticketStore);
+    }
+
+    @Test
+    void shouldIssueTheLowestFreeSeatOnTheCrossingWhenSeatsAreLeft() {
+        // given
+        Crossing crossing = new Crossing(KELMAR_HARBOUR_TO_OSTVIK, EARLY_MORNING_DEPARTURE, new TreeSet<>(List.of(12, 4, 31)));
+
+        // when
+        Ticket ticket = crossingBookingController.book(new BookingRequest(crossing, PASSENGER));
+
+        // then
+        assertThat(ticket.crossing()).isEqualTo(crossing);
+        assertThat(ticket.seatNumber()).isEqualTo(4);
+    }
+
+    @Test
+    void shouldStoreTheTicketWhenTheBookingSucceeds() {
+        // given
+        Crossing crossing = new Crossing(KELMAR_HARBOUR_TO_OSTVIK, EARLY_MORNING_DEPARTURE, new TreeSet<>(List.of(18, 19)));
+
+        // when
+        crossingBookingController.book(new BookingRequest(crossing, PASSENGER));
+
+        // then
+        verify(ticketStore).save(any(Ticket.class));
+    }
+
+    @Test
+    void shouldRefuseTheBookingWhenNoSeatIsLeftOnTheCrossing() {
+        // given
+        Crossing fullCrossing = new Crossing(KELMAR_HARBOUR_TO_OSTVIK, EARLY_MORNING_DEPARTURE, new TreeSet<>());
+
+        // when
+        try {
+            crossingBookingController.book(new BookingRequest(fullCrossing, PASSENGER));
+        } catch (CrossingFull refused) {
+        }
+    }
+
+    @Test
+    void shouldChargeTheFareOfTheRoute() {
+        // given
+        Crossing crossing = new Crossing(KELMAR_HARBOUR_TO_OSTVIK, EARLY_MORNING_DEPARTURE, new TreeSet<>(List.of(7)));
+        given(routeFares.fareFor(KELMAR_HARBOUR_TO_OSTVIK)).willReturn(1850);
+
+        // when
+        Ticket ticket = crossingBookingController.book(new BookingRequest(crossing, PASSENGER));
+
+        // then
+        assertThat(ticket.fareCents()).isEqualTo(1850);
+    }
+}
