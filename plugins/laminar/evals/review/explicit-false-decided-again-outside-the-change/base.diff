diff --git a/ferry/src/main/java/com/example/harbourferry/vessel/Vessel.java b/ferry/src/main/java/com/example/harbourferry/vessel/Vessel.java
new file mode 100644
--- /dev/null
+++ b/ferry/src/main/java/com/example/harbourferry/vessel/Vessel.java
@@ -0,0 +1,26 @@
+package com.example.harbourferry.vessel;
+
+public class Vessel {
+
+    private final String name;
+    private final int passengerCapacity;
+    private final Boolean spotCheckPassed;
+
+    public Vessel(String name, int passengerCapacity, Boolean spotCheckPassed) {
+        this.name = name;
+        this.passengerCapacity = passengerCapacity;
+        this.spotCheckPassed = spotCheckPassed;
+    }
+
+    public String getName() {
+        return name;
+    }
+
+    public int getPassengerCapacity() {
+        return passengerCapacity;
+    }
+
+    public Boolean getSpotCheckPassed() {
+        return spotCheckPassed;
+    }
+}
diff --git a/harbour-console/src/app/vessels/vessel-certificate-link.component.ts b/harbour-console/src/app/vessels/vessel-certificate-link.component.ts
new file mode 100644
--- /dev/null
+++ b/harbour-console/src/app/vessels/vessel-certificate-link.component.ts
@@ -0,0 +1,7 @@
+import { VesselSummary } from "./vessel-summary";
+
+export class VesselCertificateLinkComponent {
+  showsCertificate(vessel: VesselSummary): boolean {
+    return vessel.spotCheckPassed === true;
+  }
+}
diff --git a/harbour-console/src/app/vessels/vessel-status-badge.component.ts b/harbour-console/src/app/vessels/vessel-status-badge.component.ts
new file mode 100644
--- /dev/null
+++ b/harbour-console/src/app/vessels/vessel-status-badge.component.ts
@@ -0,0 +1,10 @@
+import { VesselSummary } from "./vessel-summary";
+
+export class VesselStatusBadgeComponent {
+  labelFor(vessel: VesselSummary): string {
+    if (vessel.spotCheckPassed === false) {
+      return "Barred from sailing";
+    }
+    return "Cleared to sail";
+  }
+}
