+import { ApiForWateringSchedules } from "../../api/ApiForWateringSchedules";
+import { WateringScheduleStore } from "../../spi/WateringScheduleStore";
+import { WateringSchedule } from "../model/WateringSchedule";
+
+export class WateringScheduleService implements ApiForWateringSchedules {
+  constructor(
+    private readonly wateringScheduleStore: WateringScheduleStore,
+    private readonly earliestStartHour: number,
+  ) {}
+
+  async planWatering(bedNumber: string, litresPerDay: number): Promise<WateringSchedule> {
+    if (litresPerDay <= 0) {
+      throw new Error(`Bed ${bedNumber} needs a positive amount of water`);
+    }
+
+    const schedule: WateringSchedule = { bedNumber, litresPerDay, startHour: this.earliestStartHour };
+    return this.wateringScheduleStore.saveSchedule(schedule);
+  }
+}
