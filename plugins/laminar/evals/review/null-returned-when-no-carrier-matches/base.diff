+package com.example.parceldepot.carrier;
+
+import java.util.List;
+import java.util.Map;
+
+public class CarrierDirectory {
+
+    private final Map<String, Carrier> carriersByCode;
+
+    public CarrierDirectory(Map<String, Carrier> carriersByCode) {
+        this.carriersByCode = Map.copyOf(carriersByCode);
+    }
+
+    public List<Carrier> listCarriers() {
+        return List.copyOf(carriersByCode.values());
+    }
+}
