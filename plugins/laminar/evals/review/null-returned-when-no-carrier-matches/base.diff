+package com.example.parceldepot.routing;
+
+import com.example.parceldepot.carrier.Carrier;
+
+public record Route(String trackingNumber, String destinationBay) {
+
+    private static final String MANUAL_DESK_BAY = "manual-desk";
+
+    public static Route toCarrierBay(Parcel parcel, Carrier carrier) {
+        return new Route(parcel.trackingNumber(), carrier.pickupBay());
+    }
+
+    public static Route toManualDesk(Parcel parcel) {
+        return new Route(parcel.trackingNumber(), MANUAL_DESK_BAY);
+    }
+}
