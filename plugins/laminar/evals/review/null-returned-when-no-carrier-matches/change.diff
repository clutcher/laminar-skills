@@ -0,0 +1,22 @@
+package com.example.parceldepot.routing;
+
+import com.example.parceldepot.carrier.Carrier;
+import com.example.parceldepot.carrier.CarrierDirectory;
+
+public class ParcelRouter {
+
+    private final CarrierDirectory carrierDirectory;
+
+    public ParcelRouter(CarrierDirectory carrierDirectory) {
+        this.carrierDirectory = carrierDirectory;
+    }
+
+    public Route routeParcel(Parcel parcel) {
+        Carrier carrier = carrierDirectory.findCarrier(parcel.carrierCode());
+        if (carrier == null) {
+            return Route.toManualDesk(parcel);
+        }
+
+        return Route.toCarrierBay(parcel, carrier);
+    }
+}
