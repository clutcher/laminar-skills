+package com.example.bistro.booking;
+
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import java.time.LocalDateTime;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.MockMvc;
+
+@SpringBootTest
+@AutoConfigureMockMvc
+class CancelledBookingControllerTest {
+
+    @Autowired
+    private MockMvc mockMvc;
+
+    @Autowired
+    private TableBookingService tableBookingService;
+
+    @Test
+    void shouldMarkTheBookingCancelledWhenTheGuestCancelsIt() throws Exception {
+        // given
+        TableBooking tableBooking = tableBookingService.bookTable("Ada Moreno", 4, LocalDateTime.of(2027, 3, 12, 19, 30));
+
+        // when
+        var cancellation = mockMvc.perform(post("/table-bookings/{bookingCode}/cancellation", tableBooking.bookingCode())
+                .contentType(MediaType.APPLICATION_JSON));
+
+        // then
+        cancellation.andExpect(status().isOk())
+                .andExpect(jsonPath("$.cancelled").value(true));
+    }
+}
