+    @PostMapping
+    public TableBooking bookTable(@RequestBody TableBookingRequest tableBookingRequest) {
+        return tableBookingService.bookTable(tableBookingRequest.guestName(), tableBookingRequest.guestCount(), tableBookingRequest.arrivesAt());
+    }
+
+    @PostMapping("/{bookingCode}/cancellation")
+    public TableBooking cancelBooking(@PathVariable String bookingCode) {
+        return tableBookingService.cancelBooking(bookingCode);
+    }
+}
