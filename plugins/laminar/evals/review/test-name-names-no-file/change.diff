@@ -0,0 +1,25 @@
+package com.example.bistro.booking;
+
+import java.time.LocalDateTime;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+import org.springframework.stereotype.Service;
+
+@Service
+public class TableBookingService {
+
+    private final Map<String, TableBooking> bookingsByCode = new HashMap<>();
+
+    public TableBooking bookTable(String guestName, int guestCount, LocalDateTime arrivesAt) {
+        TableBooking tableBooking = new TableBooking(UUID.randomUUID().toString(), guestName, guestCount, arrivesAt, false);
+        bookingsByCode.put(tableBooking.bookingCode(), tableBooking);
+        return tableBooking;
+    }
+
+    public TableBooking cancelBooking(String bookingCode) {
+        TableBooking cancelledBooking = bookingsByCode.get(bookingCode).cancel();
+        bookingsByCode.put(bookingCode, cancelledBooking);
+        return cancelledBooking;
+    }
+}
