+package com.example.apiary.hives.topbar
+
+import com.example.apiary.hives.Hive
+
+class TopBarHiveFactory {
+
+    fun createTopBarHive(hiveId: String, apiaryYard: String, layout: TopBarHiveLayout): TopBarHive {
+        val hive = Hive(hiveId, apiaryYard, colonyCount = 1)
+
+        return TopBarHive(hive, layout)
+    }
+}
