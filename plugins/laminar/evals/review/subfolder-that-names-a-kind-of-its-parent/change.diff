+package com.example.apiary.hives.topbar
+
+import com.example.apiary.hives.HiveRepository
+
+class TopBarHiveRegistration(
+    private val hiveRepository: HiveRepository,
+    private val topBarHiveFactory: TopBarHiveFactory,
+) {
+
+    fun registerTopBarHive(hiveId: String, apiaryYard: String, layout: TopBarHiveLayout): TopBarHive {
+        val topBarHive = topBarHiveFactory.createTopBarHive(hiveId, apiaryYard, layout)
+        hiveRepository.saveHive(topBarHive.hive)
+
+        return topBarHive
+    }
+}
