+package com.example.seedshop.payments
+
+import com.example.seedshop.orders.SeedOrder
+
+class PaymentReminders {
+
+    fun remindersFor(orders: List<SeedOrder>): List<String> {
+        val reminders = mutableListOf<String>()
+        for (order in orders) {
+            if (!order.isPaid) {
+                reminders.add("Order ${order.number} is waiting for payment")
+            }
+        }
+        return reminders
+    }
+}
