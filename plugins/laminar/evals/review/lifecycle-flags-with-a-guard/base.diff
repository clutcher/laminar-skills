@@ -0,0 +1,16 @@
+package com.example.seedshop.packing
+
+import com.example.seedshop.orders.SeedOrder
+
+class ParcelDesk {
+
+    fun parcelsToPack(orders: List<SeedOrder>): List<SeedOrder> {
+        val ready = mutableListOf<SeedOrder>()
+        for (order in orders) {
+            if (order.isPaid && !order.isShipped) {
+                ready.add(order)
+            }
+        }
+        return ready
+    }
+}
