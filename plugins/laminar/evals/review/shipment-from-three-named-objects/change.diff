+package com.example.shop.shipping;
+
+import lombok.RequiredArgsConstructor;
+
+@RequiredArgsConstructor
+public class ShipmentService {
+
+    private final RateCalculator rateCalculator;
+
+    public Shipment createShipment(Address destination, Parcel parcel, Carrier carrier) {
+        ShippingRate rate = rateCalculator.calculate(destination, parcel, carrier);
+        return new Shipment(destination, rate, parcel.isFragile());
+    }
+}
