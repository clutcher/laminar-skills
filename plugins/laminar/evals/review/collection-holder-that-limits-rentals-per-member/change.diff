+package com.example.bikerental.membership;
+
+public class RentalLimitReachedException extends RuntimeException {
+
+    public RentalLimitReachedException(String memberId, int openRentalsLimit) {
+        super("Member " + memberId + " already holds " + openRentalsLimit + " open rentals");
+    }
+}
