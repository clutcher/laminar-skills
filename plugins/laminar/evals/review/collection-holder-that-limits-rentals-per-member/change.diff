@@ -0,0 +1,30 @@
+package com.example.bikerental.membership;
+
+import java.util.ArrayList;
+import java.util.List;
+
+public class MemberRentals {
+
+    private static final int OPEN_RENTALS_PER_MEMBER_LIMIT = 2;
+
+    private final List<Rental> rentals = new ArrayList<>();
+
+    public void add(Rental rental) {
+        List<Rental> openRentalsOfMember = getOpenRentalsOfMember(rental.memberId());
+        if (openRentalsOfMember.size() >= OPEN_RENTALS_PER_MEMBER_LIMIT) {
+            throw new RentalLimitReachedException(rental.memberId(), OPEN_RENTALS_PER_MEMBER_LIMIT);
+        }
+
+        rentals.add(rental);
+    }
+
+    public List<Rental> getOpenRentalsOfMember(String memberId) {
+        List<Rental> openRentalsOfMember = new ArrayList<>();
+        for (Rental rental : rentals) {
+            if (rental.isOpen() && rental.memberId().equals(memberId)) {
+                openRentalsOfMember.add(rental);
+            }
+        }
+        return openRentalsOfMember;
+    }
+}
