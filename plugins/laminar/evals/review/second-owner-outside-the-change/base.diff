+            .thenReturn(buildResolvedBookingSystemGuests());
+    }
+
+    @Test
+    void shouldExposeStayWarningsOnPitchQuoteMessages() throws Exception {
+        // given
+        when(bookingSystemClient.quoteStay(buildSoapRequestFor(BOOKED_PITCH)))
+            .thenReturn(buildQuoteResponse("84.00", buildErrors("2041", "2063")));
+
+        GraphQLRequest request = GraphQLRequest.builder()
+            .query(buildEntitiesQuery("... on Pitch { quote(input: $input) {"
+                + " messages { totalCount messages { type content } } } }"))
+            .variables(Map.of(
+                "representations", List.of(Map.of("__typename", "Pitch", "id", BOOKED_PITCH)),
+                "input", buildGuestInput()))
+            .build();
+
+        // when
+        ResultActions result = performGraphQl(request);
+
+        // then
+        result.andExpect(status().isOk())
+            .andExpect(jsonPath("$.errors").doesNotExist())
+            .andExpect(jsonPath("$.data._entities[0].quote.messages.totalCount").value(2))
+            .andExpect(jsonPath("$.data._entities[0].quote.messages.messages[0].type").value("INFO"))
+            .andExpect(jsonPath("$.data._entities[0].quote.messages.messages[0].content")
+                .value("text_quote_member_refund_rate"))
+            .andExpect(jsonPath("$.data._entities[0].quote.messages.messages[1].type").value("INFO"))
+            .andExpect(jsonPath("$.data._entities[0].quote.messages.messages[1].content")
+                .value("text_quote_late_arrival_only"));
+    }
+
+    private ResultActions performGraphQl(GraphQLRequest request) throws Exception {
+        ResultActions initialResult = mockMvc.perform(post("/graphql")
+            .header(AUTHORIZATION, TestTokens.bearerFor(RECEPTION_USER, tokenKey))
+            .contentType(APPLICATION_JSON)
+            .content(JsonText.of(request)));
+        MvcResult mvcResult = initialResult.andReturn();
+        return mvcResult.getRequest().isAsyncStarted() ? mockMvc.perform(asyncDispatch(mvcResult)) : initialResult;
+    }
