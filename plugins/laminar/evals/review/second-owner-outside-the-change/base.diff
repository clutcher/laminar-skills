+package org.example.campsite.stayquote.quote.app.domain.model;
+
+import org.example.campsite.stayquote.quote.app.domain.model.amenity.IncludedAmenity;
+import org.example.campsite.stayquote.quote.app.domain.model.failure.QuoteFailure;
+import org.example.campsite.stayquote.quote.app.domain.model.failure.QuoteFailureType;
+import org.example.campsite.stayquote.quote.app.domain.model.failure.QuoteFailureType.Topic;
+import org.example.campsite.stayquote.quote.app.domain.model.note.WardenNote;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice;
+import org.example.campsite.stayquote.quote.app.domain.model.pitch.PitchSwap;
+import org.example.campsite.stayquote.quote.app.domain.model.pitch.PitchSize;
+import org.example.campsite.stayquote.quote.app.domain.model.pricing.Money;
+import org.example.campsite.stayquote.quote.app.domain.model.pricing.NightlyRate;
+import org.example.campsite.stayquote.quote.app.domain.model.pricing.StayTotal;
+import org.example.campsite.stayquote.quote.app.domain.model.season.Season;
+import org.example.campsite.stayquote.quote.app.domain.model.vacancy.Hold;
+import org.example.campsite.stayquote.quote.app.domain.model.vacancy.Opening;
+import org.example.campsite.stayquote.quote.app.domain.model.vacancy.Vacancy;
+import lombok.Builder;
+
+import java.math.BigDecimal;
+import java.util.Collection;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+@Builder(toBuilder = true)
+public record StayQuote(
+    Map<StayRequest.Line, Line> linesByRequest,
+    List<QuoteNotice> notices
+) {
+
+    public static StayQuote of(Map<StayRequest.Line, Line> linesByRequest) {
+        return new StayQuote(linesByRequest, List.of());
+    }
+
+    public StayTotal totalFor(List<StayRequest.Line> requestedLines) {
+        return StayTotal.sum(requestedLines.stream()
+                                 .map(this::findQuotedLine)
+                                 .filter(Objects::nonNull)
+                                 .map(Line::total)
+                                 .toList());
+    }
+
+    public Line onlyLine() {
+        Collection<Line> lines = quotedLines();
+        return lines.size() == 1 ? lines.iterator().next() : null;
+    }
+
+    private Line findQuotedLine(StayRequest.Line requestedLine) {
+        return linesByRequest == null ? null : linesByRequest.get(requestedLine);
+    }
+
+    private Collection<Line> quotedLines() {
+        return linesByRequest == null ? List.of() : linesByRequest.values();
+    }
+
+    @Builder(toBuilder = true)
+    public record Line(
+        String pitchId,
+        String pitchName,
+        String area,
+        WardenNote wardenNote,
+        Integer minimumNights,
+        PitchSize pitchSize,
+        Boolean electricHookup,
+        String tariffCode,
+        List<String> allowedVehicleTypes,
+        List<IncludedAmenity> amenities,
+        Integer requestedNights,
+        Integer quotedNights,
+        Boolean weeklyRoundingEnabled,
+        NightlyRate rate,
+        StayTotal total,
+        Hold hold,
+        PitchSwap swap,
+        List<QuoteFailure> failures,
+        String campsiteId,
+        List<Vacancy> vacancies,
+        List<Opening> openings,
+        CancellationTerm cancellationTerm,
+        Money touristTax,
+        Season season,
+        List<QuoteNotice> notices
+    ) {
+
+        public Line applySeasonRules() {
+            return toBuilder()
+                .rate(seasonalRate())
+                .vacancies(seasonalVacancies())
+                .build();
+        }
+
+        public Money netNightlyPrice() {
+            if (rate == null || rate.afterVoucher() == null) {
+                return null;
+            }
+            Money net = rate.afterVoucher().net();
+            return net == null || net.amount() == null ? null : net;
+        }
+
+        public Integer nightsPerRate() {
+            if (rate == null || rate.afterVoucher() == null) {
+                return null;
+            }
+            return rate.afterVoucher().nightsPerRate();
+        }
+
+        public Money netNightlyPriceBeforeVoucher() {
+            if (rate == null || rate.beforeVoucher() == null) {
+                return null;
+            }
+            Money net = rate.beforeVoucher().net();
+            return net == null || net.amount() == null ? null : net;
+        }
+
+        public Money lineTouristTax() {
+            return touristTax == null || touristTax.amount() == null ? null : touristTax;
+        }
+
+        public String voucherCode() {
+            if (rate == null || rate.voucher() == null) {
+                return null;
+            }
+            return rate.voucher().code();
+        }
+
+        public List<QuoteFailure> failuresConcerning(Topic topic) {
+            return knownFailures().stream()
+                .filter(failure -> concerns(failure, topic))
+                .toList();
+        }
+
+        public List<QuoteFailure> failuresNotShownOnTheLine() {
+            return knownFailures().stream()
+                .filter(failure -> !isShownOnTheLine(failure))
+                .toList();
+        }
+
+        public boolean hasFailure(QuoteFailureType failureType) {
+            return knownFailures().contains(failureType);
+        }
+
+        public boolean hasFailedPricing() {
+            return !failuresConcerning(Topic.VOUCHER).isEmpty()
+                || !failuresConcerning(Topic.PITCH).isEmpty();
+        }
+
+        private List<QuoteFailure> knownFailures() {
+            return failures == null ? List.of() : failures;
+        }
+
+        private static boolean concerns(QuoteFailure failure, Topic topic) {
+            return failure instanceof QuoteFailureType failureType && failureType.concerns(topic);
+        }
+
+        private static boolean isShownOnTheLine(QuoteFailure failure) {
+            return failure instanceof QuoteFailureType failureType
+                && !failureType.concerns(Topic.ELIGIBILITY);
+        }
+
+        private NightlyRate seasonalRate() {
+            return rate != null && hidesStandardRate() ? rate.withoutStandardRate() : rate;
+        }
+
+        private List<Vacancy> seasonalVacancies() {
+            if (vacancies == null) {
+                return null;
+            }
+            return vacancies.stream()
+                .map(this::withSeasonalFreePlaces)
+                .toList();
+        }
+
+        private Vacancy withSeasonalFreePlaces(Vacancy vacancy) {
+            return vacancy.withFreePlaces(countsBookablePlaces() ? vacancy.freePlaces() : vacancy.totalPlaces());
+        }
+
+        private boolean hidesStandardRate() {
+            return season != null && season.hidesStandardRate();
+        }
+
+        private boolean countsBookablePlaces() {
+            return season != null && season.countsBookablePlaces();
+        }
+
+        @Builder
+        public record CancellationTerm(
+            Boolean freeCancellation,
+            BigDecimal cancellationFee
+        ) {}
+    }
+}
