+@SpringBootTest
+@AutoConfigureMockMvc
+class StayQuoteGraphQLControllerMessagesTest {
+
+    private static final String RECEPTION_USER = "reception@pinecove-camping.example";
+
+    @Value("${spring.security.oauth2.resourceserver.jwt.hmac.key}")
+    private String tokenKey;
+
+    @Autowired
