--- /dev/null
+++ b/ski-lifts/src/test/java/com/example/skilift/features/daypass/BuyDayPassAndRideTheLiftTest.java
@@ -0,0 +1,42 @@
+package com.example.skilift.features.daypass;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.example.skilift.daypass.DayPass;
+import com.example.skilift.daypass.DayPassDesk;
+import com.example.skilift.gate.LiftGate;
+import java.time.LocalDate;
+import org.junit.jupiter.api.Test;
+
+class BuyDayPassAndRideTheLiftTest {
+
+    private static final LocalDate FEBRUARY_TENTH = LocalDate.of(2027, 2, 10);
+
+    @Test
+    void shouldOpenTheLiftGateWhenTheSkierShowsADayPassBoughtForToday() {
+        // given
+        DayPassDesk dayPassDesk = new DayPassDesk();
+        LiftGate liftGate = new LiftGate(dayPassDesk);
+        DayPass dayPass = dayPassDesk.sellDayPass(FEBRUARY_TENTH);
+
+        // when
+        boolean opened = liftGate.opensFor(dayPass.passNumber(), FEBRUARY_TENTH);
+
+        // then
+        assertThat(opened).isTrue();
+    }
+
+    @Test
+    void shouldKeepTheLiftGateClosedWhenTheDayPassWasBoughtForAnotherDay() {
+        // given
+        DayPassDesk dayPassDesk = new DayPassDesk();
+        LiftGate liftGate = new LiftGate(dayPassDesk);
+        DayPass dayPass = dayPassDesk.sellDayPass(FEBRUARY_TENTH.plusDays(1));
+
+        // when
+        boolean opened = liftGate.opensFor(dayPass.passNumber(), FEBRUARY_TENTH);
+
+        // then
+        assertThat(opened).isFalse();
+    }
+}
