+package com.example.skilift.daypass;
+
+import java.time.LocalDate;
+
+public record DayPass(String passNumber, LocalDate validOn, boolean refunded) {
+
+    public DayPass refund() {
+        return new DayPass(passNumber, validOn, true);
+    }
