@@ -0,0 +1,28 @@
+package com.example.skilift.daypass;
+
+import java.time.LocalDate;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Optional;
+import java.util.UUID;
+
+public class DayPassDesk {
+
+    private final Map<String, DayPass> dayPassesByNumber = new HashMap<>();
+
+    public DayPass sellDayPass(LocalDate validOn) {
+        DayPass dayPass = new DayPass(UUID.randomUUID().toString(), validOn, false);
+        dayPassesByNumber.put(dayPass.passNumber(), dayPass);
+        return dayPass;
+    }
+
+    public DayPass refundUnusedDayPass(String passNumber) {
+        DayPass refundedDayPass = dayPassesByNumber.get(passNumber).refund();
+        dayPassesByNumber.put(passNumber, refundedDayPass);
+        return refundedDayPass;
+    }
+
+    public Optional<DayPass> findDayPass(String passNumber) {
+        return Optional.ofNullable(dayPassesByNumber.get(passNumber));
+    }
+}
diff --git a/ski-lifts/src/main/java/com/example/skilift/gate/LiftGate.java b/ski-lifts/src/main/java/com/example/skilift/gate/LiftGate.java
