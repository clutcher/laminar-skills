+++ b/ski-lifts/src/main/java/com/example/skilift/gate/LiftGate.java
@@ -0,0 +1,24 @@
+package com.example.skilift.gate;
+
+import com.example.skilift.daypass.DayPass;
+import com.example.skilift.daypass.DayPassDesk;
+import java.time.LocalDate;
+
+public class LiftGate {
+
+    private final DayPassDesk dayPassDesk;
+
+    public LiftGate(DayPassDesk dayPassDesk) {
+        this.dayPassDesk = dayPassDesk;
+    }
+
+    public boolean opensFor(String passNumber, LocalDate today) {
+        return dayPassDesk.findDayPass(passNumber)
+                .filter(dayPass -> isValidToday(dayPass, today))
+                .isPresent();
+    }
+
+    private boolean isValidToday(DayPass dayPass, LocalDate today) {
+        return !dayPass.refunded() && dayPass.validOn().equals(today);
+    }
+}
diff --git a/ski-lifts/src/test/java/com/example/skilift/features/daypass/BuyDayPassAndRideTheLiftTest.java b/ski-lifts/src/test/java/com/example/skilift/features/daypass/BuyDayPassAndRideTheLiftTest.java
