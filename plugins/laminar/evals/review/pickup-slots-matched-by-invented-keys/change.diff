+package com.example.freightyard.slots.app;
+
+import com.example.freightyard.slots.api.ApiForPickupEstimation;
+import com.example.freightyard.slots.api.PickupEstimate;
+import com.example.freightyard.slots.api.PickupRequest;
+import com.example.freightyard.slots.spi.YardItem;
+import com.example.freightyard.slots.spi.YardPlanner;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+public class PickupEstimationService implements ApiForPickupEstimation {
+
+    private final YardPlanner yardPlanner;
+
+    public PickupEstimationService(YardPlanner yardPlanner) {
+        this.yardPlanner = yardPlanner;
+    }
+
+    @Override
+    public List<PickupEstimate> estimate(List<PickupRequest> requests) {
+        List<YardItem> items = new ArrayList<>();
+        for (PickupRequest request : requests) {
+            items.add(new YardItem(items.size() + 1, request.parcelCode(), request.crateCount()));
+        }
+        Map<Integer, String> slotsByPosition = yardPlanner.planSlots(items);
+        List<PickupEstimate> estimates = new ArrayList<>();
+        for (int index = 0; index < requests.size(); index++) {
+            PickupRequest request = requests.get(index);
+            String slot = slotsByPosition.get(items.get(index).position());
+            estimates.add(new PickupEstimate(request.requestKey(), slot));
+        }
+        return estimates;
+    }
+}
