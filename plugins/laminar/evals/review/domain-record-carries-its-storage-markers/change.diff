+import { DataSource, Repository } from "typeorm";
+import { BerthBooking } from "./berth-booking";
+
+export class BerthBookingStore {
+  private readonly bookings: Repository<BerthBooking>;
+
+  constructor(dataSource: DataSource) {
+    this.bookings = dataSource.getRepository(BerthBooking);
+  }
+
+  async bookingsOfBerth(berthNumber: number): Promise<BerthBooking[]> {
+    return this.bookings.findBy({ berthNumber });
+  }
+}
