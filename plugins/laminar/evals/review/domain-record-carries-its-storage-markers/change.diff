+import { Column, Entity, PrimaryGeneratedColumn } from "typeorm";
+
+@Entity({ name: "berth_booking" })
+export class BerthBooking {
+  @PrimaryGeneratedColumn()
+  id!: number;
+
+  @Column({ name: "vessel_name" })
+  vesselName!: string;
+
+  @Column({ name: "berth_number" })
+  berthNumber!: number;
+
+  @Column({ name: "arrives_on", type: "date" })
+  arrivesOn!: Date;
+
+  @Column({ name: "leaves_on", type: "date" })
+  leavesOn!: Date;
+
+  @Column({ name: "length_metres" })
+  lengthMetres!: number;
+
+  overlaps(other: BerthBooking): boolean {
+    return this.berthNumber === other.berthNumber && this.leavesOn >= other.arrivesOn && other.leavesOn >= this.arrivesOn;
+  }
+}
