+package com.example.apiary.shop.app.domain;
+
+import com.example.apiary.shop.app.api.ShopStock;
+import com.example.apiary.shop.app.domain.model.JarBatch;
+import com.example.apiary.shop.app.spi.HarvestsForSale;
+
+public class ShopStockService implements ShopStock {
+
+    private final HarvestsForSale harvestsForSale;
+
+    public ShopStockService(HarvestsForSale harvestsForSale) {
+        this.harvestsForSale = harvestsForSale;
+    }
+
+    @Override
+    public int jarsOnSale(String hiveCode) {
+        return harvestsForSale.batchesOfHive(hiveCode).stream()
+                .mapToInt(JarBatch::jarCount)
+                .sum();
+    }
+}
