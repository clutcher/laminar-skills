--- /dev/null
+++ b/freight-rating/src/freight_rating/adapters/booking_graph.py
@@ -0,0 +1,25 @@
+from decimal import Decimal
+
+from strawberry.dataloader import DataLoader
+
+from freight_rating.domain.models import Leg, LegCharge, Rating
+from freight_rating.ports.freight_rating import FreightRating
+
+
+class BookingGraph:
+    def __init__(self, freight_rating: FreightRating):
+        self._freight_rating = freight_rating
+
+    def context(self) -> dict[str, DataLoader]:
+        return {"leg_charges": DataLoader(load_fn=self._leg_charges_of)}
+
+    def booking_rating(self, legs: list[Leg]) -> Rating:
+        return self._freight_rating.rate(legs)
+
+    async def leg_charge(self, leg: Leg, context: dict[str, DataLoader]) -> Decimal:
+        leg_charge = await context["leg_charges"].load(leg)
+        return leg_charge.charge
+
+    async def _leg_charges_of(self, legs: list[Leg]) -> list[LegCharge]:
+        rating = self._freight_rating.rate(legs)
+        return [rating.charge_for(leg) for leg in legs]
diff --git a/freight-rating/src/freight_rating/adapters/http_tariff_source.py b/freight-rating/src/freight_rating/adapters/http_tariff_source.py
new file mode 100644
--- /dev/null
+++ b/freight-rating/src/freight_rating/adapters/http_tariff_source.py
@@ -0,0 +1,16 @@
+from decimal import Decimal
+
+import httpx
+
+from freight_rating.ports.tariff_source import TariffSource
+
+
+class HttpTariffSource(TariffSource):
+    def __init__(self, client: httpx.Client):
+        self._client = client
+
+    def rates_per_kg(self, lanes: set[tuple[str, str]]) -> dict[tuple[str, str], Decimal]:
+        lane_requests = [{"origin": origin, "destination": destination} for origin, destination in lanes]
+        response = self._client.post("/tariffs/per-kg", json=lane_requests)
+        response.raise_for_status()
+        return {(tariff["origin"], tariff["destination"]): Decimal(tariff["ratePerKg"]) for tariff in response.json()}
diff --git a/freight-rating/src/freight_rating/domain/models.py b/freight-rating/src/freight_rating/domain/models.py
