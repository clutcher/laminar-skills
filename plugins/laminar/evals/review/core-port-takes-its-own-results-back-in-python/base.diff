+++ b/freight-rating/src/freight_rating/domain/models.py
@@ -0,0 +1,31 @@
+from dataclasses import dataclass
+from decimal import Decimal
+
+
+@dataclass(frozen=True)
+class Leg:
+    origin: str
+    destination: str
+    weight_kg: Decimal
+
+
+@dataclass(frozen=True)
+class LegCharge:
+    leg: Leg
+    charge: Decimal
+
+
+@dataclass(frozen=True)
+class SurchargeNote:
+    subject: str
+    text: str
+
+
+@dataclass(frozen=True)
+class Rating:
+    leg_charges: list[LegCharge]
+    total_charge: Decimal
+    surcharge_notes: list[SurchargeNote]
+
+    def charge_for(self, leg: Leg) -> LegCharge:
+        return next(leg_charge for leg_charge in self.leg_charges if leg_charge.leg == leg)
diff --git a/freight-rating/src/freight_rating/domain/rating_service.py b/freight-rating/src/freight_rating/domain/rating_service.py
new file mode 100644
--- /dev/null
+++ b/freight-rating/src/freight_rating/domain/rating_service.py
@@ -0,0 +1,18 @@
+from decimal import Decimal
+
+from freight_rating.domain.models import Leg, LegCharge, Rating
+from freight_rating.domain.surcharge_rules import SurchargeRules
+from freight_rating.ports.freight_rating import FreightRating
+from freight_rating.ports.tariff_source import TariffSource
+
+
+class RatingService(FreightRating):
+    def __init__(self, tariff_source: TariffSource, surcharge_rules: SurchargeRules):
+        self._tariff_source = tariff_source
+        self._surcharge_rules = surcharge_rules
+
+    def rate(self, legs: list[Leg]) -> Rating:
+        rates_per_kg = self._tariff_source.rates_per_kg({(leg.origin, leg.destination) for leg in legs})
+        leg_charges = [LegCharge(leg, leg.weight_kg * rates_per_kg[(leg.origin, leg.destination)]) for leg in legs]
+        total_charge = sum((leg_charge.charge for leg_charge in leg_charges), Decimal("0"))
+        return Rating(leg_charges, total_charge, self._surcharge_rules.notes_for(leg_charges, total_charge))
diff --git a/freight-rating/src/freight_rating/domain/surcharge_rules.py b/freight-rating/src/freight_rating/domain/surcharge_rules.py
new file mode 100644
--- /dev/null
+++ b/freight-rating/src/freight_rating/domain/surcharge_rules.py
@@ -0,0 +1,18 @@
+from decimal import Decimal
+
+from freight_rating.domain.models import LegCharge, SurchargeNote
+
+HEAVY_LIFT_WEIGHT_KG = Decimal("20000")
+CREDIT_APPROVAL_CHARGE = Decimal("50000")
+
+
+class SurchargeRules:
+    def notes_for(self, leg_charges: list[LegCharge], total_charge: Decimal) -> list[SurchargeNote]:
+        notes = [
+            SurchargeNote(f"{leg_charge.leg.origin}-{leg_charge.leg.destination}", "Heavy lift surcharge applies")
+            for leg_charge in leg_charges
+            if leg_charge.leg.weight_kg > HEAVY_LIFT_WEIGHT_KG
+        ]
+        if total_charge > CREDIT_APPROVAL_CHARGE:
+            notes.append(SurchargeNote("booking", "Booking needs credit approval"))
+        return notes
