@@ -0,0 +1,14 @@
+import { StayBooking } from "../api/stay-booking";
+import { StayStore } from "../spi/stay-store";
+import { Stay } from "./model/stay";
+
+const PRICE_PER_NIGHT_IN_CENTS = 3200;
+
+export class StayService implements StayBooking {
+  constructor(private readonly stayStore: StayStore) {}
+
+  async bookStay(stay: Stay): Promise<number> {
+    await this.stayStore.saveStay(stay);
+    return stay.nights() * PRICE_PER_NIGHT_IN_CENTS;
+  }
+}
