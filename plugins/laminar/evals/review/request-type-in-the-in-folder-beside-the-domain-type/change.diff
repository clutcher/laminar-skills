new file mode 100644
--- /dev/null
+++ b/kennel/src/boarding/app/domain/model/stay.ts
@@ -0,0 +1,17 @@
+export class Stay {
+  readonly petName: string;
+  readonly ownerPhone: string;
+  readonly arrivesOn: Date;
+  readonly leavesOn: Date;
+
+  constructor(petName: string, ownerPhone: string, arrivesOn: Date, leavesOn: Date) {
+    this.petName = petName;
+    this.ownerPhone = ownerPhone;
+    this.arrivesOn = arrivesOn;
+    this.leavesOn = leavesOn;
+  }
+
+  nights(): number {
+    return Math.round((this.leavesOn.getTime() - this.arrivesOn.getTime()) / 86400000);
+  }
+}
diff --git a/kennel/src/boarding/app/domain/stay-service.ts b/kennel/src/boarding/app/domain/stay-service.ts
