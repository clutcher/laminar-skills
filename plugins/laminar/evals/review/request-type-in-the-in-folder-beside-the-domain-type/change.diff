+import { Request, Response, Router } from "express";
+import { StayBooking } from "../../app/api/stay-booking";
+import { Stay } from "../../app/domain/model/stay";
+import { StayRequest } from "./stay-request";
+
+export function createStayRouter(stayBooking: StayBooking): Router {
+  const router = Router();
+  router.post("/stays", async (request: Request, response: Response) => {
+    const stayRequest = readStayRequest(request.body);
+    const priceInCents = await stayBooking.bookStay(mapIntoStay(stayRequest));
+    response.status(201).json({ priceInCents });
+  });
+  return router;
+}
+
+function readStayRequest(body: Record<string, string>): StayRequest {
+  return new StayRequest(body.petName, body.ownerPhone, new Date(body.arrivesOn), new Date(body.leavesOn));
+}
+
+function mapIntoStay(stayRequest: StayRequest): Stay {
+  return new Stay(stayRequest.petName, stayRequest.ownerPhone, stayRequest.arrivesOn, stayRequest.leavesOn);
+}
