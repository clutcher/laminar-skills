+package org.example.dental.records.export.app.domain.services.validators;
+
+import org.example.dental.records.export.app.domain.model.export.ExportFormat;
+import org.example.dental.records.export.app.domain.model.export.RecordKind;
+
+import static org.example.dental.records.export.app.domain.model.export.RecordKind.INVOICE;
+import static org.example.dental.records.export.app.domain.model.export.RecordKind.XRAY_REPORT;
+
+public class ArchiveKindValidator {
+
+    public static void validate(
+        ExportFormat format,
+        RecordKind recordKind
+    ) {
+        if (format.fileType() == null) {
+            return;
+        }
+        if (format.fileType() != ExportFormat.FileType.ARCHIVE) {
+            return;
+        }
+        if (recordKind != XRAY_REPORT && recordKind != INVOICE) {
+            throw new IllegalArgumentException("An archive cannot be exported for record kind: " + recordKind);
+        }
+    }
+}
