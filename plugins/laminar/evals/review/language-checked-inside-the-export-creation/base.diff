@@ -0,0 +1,32 @@
+package org.example.dental.records.export.app.spi;
+
+import org.example.dental.records.export.app.domain.model.export.ArchivePart;
+import org.example.dental.records.export.app.domain.model.export.ExportFormat;
+import org.example.dental.records.export.app.domain.model.export.RecordKind;
+import org.example.dental.records.export.app.domain.model.export.RecordSelection;
+
+import java.io.InputStream;
+import java.util.List;
+
+public interface RecordExporter {
+    RecordKind supportedKind();
+
+    InputStream export(ExportFormat format, RecordSelection selection);
+
+    default boolean shouldBeArchive(ExportFormat format, RecordSelection selection) {
+        if (format == null) {
+            return false;
+        }
+        return format.fileType() == ExportFormat.FileType.ARCHIVE;
+    }
+
+    default List<ArchivePart> splitForArchive(ExportFormat format, RecordSelection selection) {
+        throw new UnsupportedOperationException(
+            "Record kind " + supportedKind() + " cannot be split into an archive"
+        );
+    }
+
+    default ExportFormat.FileType defaultFileType(ExportFormat.Layout layout) {
+        return ExportFormat.FileType.PDF;
+    }
+}
