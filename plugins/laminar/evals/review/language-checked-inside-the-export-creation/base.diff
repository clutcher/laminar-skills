+package org.example.dental.records.export.app.domain.services;
+
+import org.example.dental.records.export.app.api.ApiForRecordExport;
+import org.example.dental.records.export.app.domain.model.exceptions.ExportCreationException;
+import org.example.dental.records.export.app.domain.model.export.ArchivePart;
+import org.example.dental.records.export.app.domain.model.export.ExportFormat;
+import org.example.dental.records.export.app.domain.model.export.ExportedFile;
+import org.example.dental.records.export.app.domain.model.export.RecordKind;
+import org.example.dental.records.export.app.domain.model.export.RecordSelection;
+import org.example.dental.records.export.app.domain.services.validators.ArchiveKindValidator;
+import org.example.dental.records.export.app.domain.services.zip.ZipBundler;
+import org.example.dental.records.export.app.spi.RecordExporter;
+import org.springframework.stereotype.Service;
+
+import java.io.InputStream;
+import java.util.EnumMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+@Service
+public class RecordExportService implements ApiForRecordExport {
+
+    private final Map<RecordKind, RecordExporter> exportersByKind;
+    private final ExportFileNaming fileNaming;
+
+    public RecordExportService(
+        List<RecordExporter> exporters,
+        ExportFileNaming fileNaming
+    ) {
+        this.exportersByKind = new EnumMap<>(RecordKind.class);
+        exporters.forEach(exporter -> exportersByKind.put(exporter.supportedKind(), exporter));
+        this.fileNaming = fileNaming;
+    }
+
+    @Override
+    public ExportedFile createExport(
+        ExportFormat format,
+        RecordKind recordKind,
+        RecordSelection selection
+    ) {
+        ArchiveKindValidator.validate(format, recordKind);
+
+        RecordExporter exporter = findExporter(recordKind);
+        if (exporter.shouldBeArchive(format, selection)) {
+            return createArchive(exporter, format, recordKind, selection);
+        }
+
+        ExportFormat completeFormat = withDefaultFileType(format, exporter);
+        InputStream content = exporter.export(completeFormat, selection);
+        String filename = fileNaming.nameFor(recordKind, completeFormat, selection);
+        return new ExportedFile(filename, content);
+    }
+
+    private ExportedFile createArchive(
+        RecordExporter exporter,
+        ExportFormat format,
+        RecordKind recordKind,
+        RecordSelection selection
+    ) {
+        Map<String, InputStream> contentByFileName = new LinkedHashMap<>();
+        for (ArchivePart part : exporter.splitForArchive(format, selection)) {
+            contentByFileName.put(part.fileName(), exporter.export(part.partFormat(), part.selection()));
+        }
+        ExportFormat archiveFormat = format.withFileType(ExportFormat.FileType.ARCHIVE);
+        String filename = fileNaming.nameFor(recordKind, archiveFormat, selection);
+        return new ExportedFile(filename, ZipBundler.bundle(contentByFileName));
+    }
+
+    private RecordExporter findExporter(RecordKind recordKind) {
+        RecordExporter exporter = exportersByKind.get(recordKind);
+        if (exporter == null) {
+            throw new ExportCreationException("No exporter is registered for record kind: " + recordKind);
+        }
+        return exporter;
+    }
+
+    private ExportFormat withDefaultFileType(ExportFormat format, RecordExporter exporter) {
+        if (format.fileType() != null) {
+            return format;
+        }
+        return format.withFileType(exporter.defaultFileType(format.layout()));
+    }
+
+}
