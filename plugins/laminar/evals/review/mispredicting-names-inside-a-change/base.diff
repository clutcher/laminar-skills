+import static org.example.campsite.stayquote.quote.in.graphql.StayQuoteRequestFactory.buildGuestSearchForBookingSystemGuest;
+import static org.example.campsite.stayquote.quote.in.graphql.StayQuoteRequestFactory.buildResolvedBookingSystemGuests;
+import static org.mockito.Mockito.when;
+import static org.springframework.http.HttpHeaders.AUTHORIZATION;
