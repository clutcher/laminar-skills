+
+    @Test
+    void shouldExposeStayWarningsOnPitchQuoteMessages() throws Exception {
+        // given
+        when(bookingSystemClient.quoteStay(buildSoapRequestFor(BOOKED_PITCH)))
+            .thenReturn(buildQuoteResponse("84.00", buildErrors("2041", "2063")));
+
+        GraphQLRequest request = GraphQLRequest.builder()
+            .query(buildEntitiesQuery("... on Pitch { quote(input: $input) {"
+                + " messages { totalCount messages { type content } } } }"))
+            .variables(Map.of(
+                "representations", List.of(Map.of("__typename", "Pitch", "id", BOOKED_PITCH)),
+                "input", buildGuestInput()))
