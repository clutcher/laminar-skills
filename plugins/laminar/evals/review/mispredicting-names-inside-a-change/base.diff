+package org.example.campsite.stayquote.quote.app.domain.services.notice;
+
+import org.example.campsite.stayquote.quote.app.domain.model.StayQuote;
+import org.example.campsite.stayquote.quote.app.domain.model.StayQuote.Line;
+import org.example.campsite.stayquote.quote.app.domain.model.StayRequest;
+import org.example.campsite.stayquote.quote.app.domain.model.failure.QuoteFailureType;
+import org.example.campsite.stayquote.quote.app.domain.model.failure.UnrecognisedFailure;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice.HighValueStayThresholdExceeded;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice.LateArrivalRequired;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice.NightsAdjustedToWeeklyTariff;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice.NightsRaisedToMinimumStay;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice.NightsRoundedToFullWeek;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice.PitchPricingFailed;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice.PitchRenumbered;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice.PitchesNotQuoted;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice.SeasonDiscountApplied;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice.VoucherPricingFailed;
+import org.example.campsite.stayquote.quote.app.domain.model.pitch.PitchSwap;
+import org.example.campsite.stayquote.quote.app.domain.model.pricing.HighValueStayThresholds;
+import org.example.campsite.stayquote.quote.app.domain.model.pricing.Money;
+import org.example.campsite.stayquote.quote.app.domain.services.notice.rules.impl.LateArrivalRule;
+import org.example.campsite.stayquote.quote.app.domain.services.notice.rules.impl.OccupancyLimitRule;
+import org.example.campsite.stayquote.quote.app.domain.services.notice.rules.impl.PitchPricingRule;
+import org.example.campsite.stayquote.quote.app.domain.services.notice.rules.impl.PitchSwapRule;
+import org.example.campsite.stayquote.quote.app.domain.services.notice.rules.impl.RateComparisonRule;
+import org.example.campsite.stayquote.quote.app.domain.services.notice.rules.impl.SeasonDiscountRule;
+import org.example.campsite.stayquote.quote.app.domain.services.notice.rules.impl.VoucherPricingRule;
+import org.junit.jupiter.api.Test;
+
+import java.math.BigDecimal;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import static org.example.campsite.stayquote.quote.app.domain.services.notice.QuoteLineFactory.FORMER_PITCH;
+import static org.example.campsite.stayquote.quote.app.domain.services.notice.QuoteLineFactory.LINE_PITCH;
+import static org.example.campsite.stayquote.quote.app.domain.services.notice.QuoteLineFactory.OFFERED_PITCH;
+import static org.example.campsite.stayquote.quote.app.domain.services.notice.QuoteLineFactory.SEASON_VOUCHER;
+import static org.example.campsite.stayquote.quote.app.domain.services.notice.QuoteLineFactory.buildLineTotal;
+import static org.example.campsite.stayquote.quote.app.domain.services.notice.QuoteLineFactory.buildQuoteLine;
+import static org.example.campsite.stayquote.quote.app.domain.services.notice.QuoteLineFactory.buildQuoteLineWithVoucher;
+import static org.assertj.core.api.Assertions.assertThat;
+
+class QuoteNoticeServiceTest {
+
+    private static final String LAKESIDE_PITCH = "LAKESIDE-21";
+    private static final String HILLTOP_PITCH = "HILLTOP-09";
+    private static final String EURO = "EUR";
+    private static final String SWISS_FRANC = "CHF";
+
+    private final QuoteNoticeService service = new QuoteNoticeService(
+        List.of(
+            new SeasonDiscountRule(),
+            new VoucherPricingRule(),
+            new LateArrivalRule(),
+            new RateComparisonRule(),
+            new PitchPricingRule(),
+            new OccupancyLimitRule(),
+            new PitchSwapRule()),
+        new HighValueStayThresholds(Map.of(
+            EURO, new BigDecimal("5000"),
+            SWISS_FRANC, new BigDecimal("4000"))));
+
+    @Test
+    void shouldReportOnlyTheLastVoucherFailureWhenTheBookingSystemReturnsSeveralForOneLine() {
+        // given
+        Line line = buildQuoteLine()
+            .failures(List.of(
+                QuoteFailureType.VOUCHER_NOT_VALID_FOR_GUEST,
+                QuoteFailureType.VOUCHER_EXPIRED))
+            .build();
+
+        // when
+        List<QuoteNotice> notices = service.resolveLineNotices(line);
+
+        // then
+        assertThat(notices).containsExactly(
+            new VoucherPricingFailed(QuoteFailureType.VOUCHER_EXPIRED, LINE_PITCH));
+    }
+
+    @Test
+    void shouldReportOnlyTheLastPitchFailureWhenTheBookingSystemReturnsSeveralForOneLine() {
+        // given
+        Line line = buildQuoteLine()
+            .failures(List.of(
+                QuoteFailureType.PITCH_NOT_BOOKABLE,
+                QuoteFailureType.PITCH_NOT_FOUND))
+            .build();
+
+        // when
+        List<QuoteNotice> notices = service.resolveLineNotices(line);
+
+        // then
+        assertThat(notices).containsExactly(
+            new PitchPricingFailed(QuoteFailureType.PITCH_NOT_FOUND, LINE_PITCH));
+    }
+
+    @Test
+    void shouldSuppressSeasonDiscountWhenTheLineAlsoCarriesARateFailure() {
+        // given
+        Line line = buildQuoteLineWithVoucher(SEASON_VOUCHER)
+            .failures(List.of(QuoteFailureType.VOUCHER_NOT_VALID_FOR_GUEST))
+            .build();
+
+        // when
+        List<QuoteNotice> notices = service.resolveLineNotices(line);
+
+        // then
+        assertThat(notices).containsExactly(
+            new VoucherPricingFailed(QuoteFailureType.VOUCHER_NOT_VALID_FOR_GUEST, LINE_PITCH));
+    }
+
+    @Test
+    void shouldReportSeasonDiscountBeforeLateArrivalWhenBothApplyToTheSameLine() {
+        // given
+        Line line = buildQuoteLineWithVoucher(SEASON_VOUCHER)
+            .failures(List.of(QuoteFailureType.LATE_ARRIVAL_ONLY))
+            .build();
+
+        // when
+        List<QuoteNotice> notices = service.resolveLineNotices(line);
+
+        // then
+        assertThat(notices).containsExactly(new SeasonDiscountApplied(), new LateArrivalRequired());
+    }
+
+    @Test
+    void shouldReportPitchPricingFailureBeforeThePitchRenumberingWhenBothApplyToTheSameLine() {
+        // given
+        Line line = buildQuoteLine()
+            .failures(List.of(QuoteFailureType.PITCH_NOT_FOUND))
+            .swap(new PitchSwap(PitchSwap.Reason.RENUMBERED, FORMER_PITCH, OFFERED_PITCH))
+            .build();
+
+        // when
+        List<QuoteNotice> notices = service.resolveLineNotices(line);
+
+        // then
+        assertThat(notices).containsExactly(
+            new PitchPricingFailed(QuoteFailureType.PITCH_NOT_FOUND, LINE_PITCH),
+            new PitchRenumbered(FORMER_PITCH));
+    }
+
+    @Test
+    void shouldKeepNightsAdjustmentsOffTheLineSoTheyAreShownOnceForTheWholeQuote() {
+        // given
+        Line line = buildQuoteLine().requestedNights(5).quotedNights(7).build();
+
+        // when
+        List<QuoteNotice> notices = service.resolveLineNotices(line);
+
+        // then
+        assertThat(notices).isEmpty();
+    }
+
+    @Test
+    void shouldReportWeekRoundingOnceForTheWholeQuoteNamingEveryAffectedPitch() {
+        // given
+        StayQuote quote = quoteOf(
+            Map.of(
+                LAKESIDE_PITCH, buildQuoteLine().requestedNights(5).quotedNights(7).build(),
+                HILLTOP_PITCH, buildQuoteLine().requestedNights(6).quotedNights(7).build()));
+
+        // when
+        List<QuoteNotice> notices = service.resolveQuoteNotices(quote);
+
+        // then
+        assertThat(notices).containsExactly(
+            new NightsRoundedToFullWeek(List.of(HILLTOP_PITCH, LAKESIDE_PITCH)));
+    }
+
+    @Test
+    void shouldReportWeeklyTariffAndMinimumStayAsSeparateQuoteWarnings() {
+        // given
+        StayQuote quote = quoteOf(
+            Map.of(
+                LAKESIDE_PITCH, buildQuoteLine()
+                    .requestedNights(5)
+                    .quotedNights(7)
+                    .failures(List.of(QuoteFailureType.NIGHTS_ADJUSTED_TO_WEEKLY_TARIFF))
+                    .build(),
+                HILLTOP_PITCH, buildQuoteLine()
+                    .requestedNights(1)
+                    .quotedNights(3)
+                    .failures(List.of(QuoteFailureType.NIGHTS_RAISED_TO_MINIMUM_STAY))
+                    .build()));
+
+        // when
+        List<QuoteNotice> notices = service.resolveQuoteNotices(quote);
+
+        // then
+        assertThat(notices).containsExactly(
+            new NightsAdjustedToWeeklyTariff(List.of(LAKESIDE_PITCH)),
+            new NightsRaisedToMinimumStay(List.of(HILLTOP_PITCH)));
+    }
+
+    @Test
+    void shouldReportOneQuoteFailureWhenSeveralPitchesAreRefusedForTheSameReason() {
+        // given
+        StayQuote quote = quoteOf(
+            Map.of(
+                LAKESIDE_PITCH, buildQuoteLine()
+                    .failures(List.of(QuoteFailureType.PITCH_CLOSED_FOR_SEASON))
+                    .build(),
+                HILLTOP_PITCH, buildQuoteLine()
+                    .failures(List.of(QuoteFailureType.PITCH_CLOSED_FOR_SEASON))
+                    .build()));
+
+        // when
+        List<QuoteNotice> notices = service.resolveQuoteNotices(quote);
+
+        // then
+        assertThat(notices).containsExactly(new PitchesNotQuoted(
+            QuoteFailureType.PITCH_CLOSED_FOR_SEASON,
+            List.of(HILLTOP_PITCH, LAKESIDE_PITCH)));
+    }
+
+    @Test
+    void shouldKeepTheBookingSystemWordingWhenItReportsAFailureWeDoNotRecognise() {
+        // given
+        StayQuote quote = quoteOf(
+            Map.of(LAKESIDE_PITCH, buildQuoteLine()
+                .failures(List.of(new UnrecognisedFailure("Pitch flooded after storm")))
+                .build()));
+
+        // when
+        List<QuoteNotice> notices = service.resolveQuoteNotices(quote);
+
+        // then
+        assertThat(notices).containsExactly(new PitchesNotQuoted(
+            new UnrecognisedFailure("Pitch flooded after storm"),
+            List.of(LAKESIDE_PITCH)));
+    }
+
+    @Test
+    void shouldKeepFailuresAlreadyShownOnTheLineOffTheQuoteSummary() {
+        // given
+        StayQuote quote = quoteOf(
+            Map.of(LAKESIDE_PITCH, buildQuoteLine()
+                .failures(List.of(QuoteFailureType.VOUCHER_EXPIRED))
+                .build()));
+
+        // when
+        List<QuoteNotice> notices = service.resolveQuoteNotices(quote);
+
+        // then
+        assertThat(notices).isEmpty();
+    }
+
+    @Test
+    void shouldWarnAboutAHighValueStayWhenALineSubtotalExceedsItsCurrencyThreshold() {
+        // given
+        StayQuote quote = quoteOf(
+            Map.of(LAKESIDE_PITCH, buildQuoteLine().total(buildLineTotal("6200", EURO)).build()));
+
+        // when
+        List<QuoteNotice> notices = service.resolveQuoteNotices(quote);
+
+        // then
+        assertThat(notices).containsExactly(new HighValueStayThresholdExceeded(Money.of(new BigDecimal("5000"), EURO)));
+    }
+
+    @Test
+    void shouldWarnAboutAHighValueStayWhenACheaperLineExceedsItsOwnCurrencyThreshold() {
+        // given
+        StayQuote quote = quoteOf(
+            Map.of(
+                LAKESIDE_PITCH, buildQuoteLine().total(buildLineTotal("4500", EURO)).build(),
+                HILLTOP_PITCH, buildQuoteLine().total(buildLineTotal("4300", SWISS_FRANC)).build()));
+
+        // when
+        List<QuoteNotice> notices = service.resolveQuoteNotices(quote);
+
+        // then
+        assertThat(notices).containsExactly(new HighValueStayThresholdExceeded(Money.of(new BigDecimal("4000"), SWISS_FRANC)));
+    }
+
+    @Test
+    void shouldNotWarnAboutAHighValueStayWhenOnlyTheSumOfLinesExceedsTheThreshold() {
+        // given
+        StayQuote quote = quoteOf(
+            Map.of(
+                LAKESIDE_PITCH, buildQuoteLine().total(buildLineTotal("3000", EURO)).build(),
+                HILLTOP_PITCH, buildQuoteLine().total(buildLineTotal("3000", EURO)).build()));
+
+        // when
+        List<QuoteNotice> notices = service.resolveQuoteNotices(quote);
+
+        // then
+        assertThat(notices).isEmpty();
+    }
+
+    @Test
+    void shouldNotWarnAboutAHighValueStayWhenNoThresholdIsSetForTheCurrency() {
+        // given
+        StayQuote quote = quoteOf(
+            Map.of(LAKESIDE_PITCH, buildQuoteLine().total(buildLineTotal("9000", "NOK")).build()));
+
+        // when
+        List<QuoteNotice> notices = service.resolveQuoteNotices(quote);
+
+        // then
+        assertThat(notices).isEmpty();
+    }
+
+    @Test
+    void shouldReportNoQuoteNoticesWhenNoPitchWasQuoted() {
+        // when
+        List<QuoteNotice> notices = service.resolveQuoteNotices(quoteOf(Map.of()));
+
+        // then
+        assertThat(notices).isEmpty();
+    }
+
+    private static StayQuote quoteOf(Map<String, Line> linesByPitchId) {
+        Map<StayRequest.Line, Line> linesByRequest = new LinkedHashMap<>();
+        linesByPitchId.forEach((pitchId, line) -> linesByRequest.put(
+            StayRequest.Line.builder().pitchId(pitchId).guests(2).build(),
+            line));
+        return StayQuote.of(linesByRequest);
+    }
+}
