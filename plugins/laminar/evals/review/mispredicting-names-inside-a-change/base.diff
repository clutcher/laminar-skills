+package org.example.campsite.stayquote.quote.app.domain.services.notice;
+
+import org.example.campsite.stayquote.quote.app.domain.model.StayQuote.Line;
+import org.example.campsite.stayquote.quote.app.domain.model.StayQuote.Line.LineBuilder;
+import org.example.campsite.stayquote.quote.app.domain.model.pricing.Money;
+import org.example.campsite.stayquote.quote.app.domain.model.pricing.NightlyRate;
+import org.example.campsite.stayquote.quote.app.domain.model.pricing.StayTotal;
+
+import java.math.BigDecimal;
+import java.util.List;
+
+public final class QuoteLineFactory {
+
+    public static final String LINE_PITCH = "MEADOW-14";
+    public static final String FORMER_PITCH = "MEADOW-07";
+    public static final String OFFERED_PITCH = "BROOKSIDE-03";
+    public static final String SEASON_VOUCHER = "AUTUMN-2291";
+    public static final String MEMBER_VOUCHER = "MEMBER-REFUND-3307";
+
+    private QuoteLineFactory() {}
+
+    public static LineBuilder buildQuoteLine() {
+        return Line.builder()
+            .pitchId(LINE_PITCH)
+            .failures(List.of());
+    }
+
+    public static LineBuilder buildQuoteLineWithVoucher(String voucherCode) {
+        return buildQuoteLine().rate(NightlyRate.builder()
+            .voucher(NightlyRate.RedeemedVoucher.builder().code(voucherCode).build())
+            .build());
+    }
+
+    public static StayTotal buildLineTotal(String amount, String currency) {
+        Money subtotal = Money.of(new BigDecimal(amount), currency);
+        return StayTotal.builder()
+            .subtotal(subtotal)
+            .total(subtotal)
+            .build();
+    }
+}
