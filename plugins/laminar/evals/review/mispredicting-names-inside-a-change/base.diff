@@ -0,0 +1,172 @@
+package org.example.campsite.stayquote.quote.app.domain.services.notice;
+
+import org.example.campsite.stayquote.quote.app.domain.model.StayQuote;
+import org.example.campsite.stayquote.quote.app.domain.model.StayQuote.Line;
+import org.example.campsite.stayquote.quote.app.domain.model.StayRequest;
+import org.example.campsite.stayquote.quote.app.domain.model.failure.QuoteFailure;
+import org.example.campsite.stayquote.quote.app.domain.model.failure.QuoteFailureType;
+import org.example.campsite.stayquote.quote.app.domain.model.failure.UnrecognisedFailure;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.NightsAdjustment;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice.HighValueStayThresholdExceeded;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice.NightsAdjustedToWeeklyTariff;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice.NightsRaisedToMinimumStay;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice.NightsRoundedToFullWeek;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice.PitchPricingFailed;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice.PitchesNotQuoted;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice.SeasonDiscountApplied;
+import org.example.campsite.stayquote.quote.app.domain.model.notice.QuoteNotice.VoucherPricingFailed;
+import org.example.campsite.stayquote.quote.app.domain.model.pricing.HighValueStayThresholds;
+import org.example.campsite.stayquote.quote.app.domain.model.pricing.Money;
+import org.example.campsite.stayquote.quote.app.domain.model.pricing.StayTotal;
+import org.example.campsite.stayquote.quote.app.domain.services.notice.rules.LineNoticeRule;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.EnumMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.SortedSet;
+import java.util.TreeSet;
+
+public class QuoteNoticeService {
+
+    private final List<LineNoticeRule> lineNoticeRules;
+    private final HighValueStayThresholds highValueStayThresholds;
+
+    public QuoteNoticeService(List<LineNoticeRule> lineNoticeRules, HighValueStayThresholds highValueStayThresholds) {
+        this.lineNoticeRules = List.copyOf(lineNoticeRules);
+        this.highValueStayThresholds = highValueStayThresholds;
+    }
+
+    public List<QuoteNotice> resolveLineNotices(Line line) {
+        List<QuoteNotice> detectedNotices = detectNotices(line);
+        List<QuoteNotice> noticesWithoutDiscountOnFailedRate =
+            suppressSeasonDiscountWhenRateFailed(detectedNotices, line);
+
+        return collapseRepeatedRateFailures(noticesWithoutDiscountOnFailedRate);
+    }
+
+    public List<QuoteNotice> resolveQuoteNotices(StayQuote quote) {
+        List<QuoteNotice> notices = new ArrayList<>(groupFailuresNotShownOnLines(quote.linesByRequest()));
+
+        notices.addAll(groupNightsAdjustments(quote.linesByRequest()));
+        notices.addAll(findExceededHighValueThresholds(quote.linesByRequest().values()));
+
+        return List.copyOf(notices);
+    }
+
+    private List<QuoteNotice> detectNotices(Line line) {
+        return lineNoticeRules.stream()
+            .flatMap(rule -> rule.apply(line).stream())
+            .toList();
+    }
+
+    private static List<QuoteNotice> suppressSeasonDiscountWhenRateFailed(
+        List<QuoteNotice> notices, Line line
+    ) {
+        if (!line.hasFailedPricing()) {
+            return notices;
+        }
+        return notices.stream()
+            .filter(notice -> !(notice instanceof SeasonDiscountApplied))
+            .toList();
+    }
+
+    private static List<QuoteNotice> collapseRepeatedRateFailures(
+        List<QuoteNotice> notices
+    ) {
+        List<QuoteNotice> withOneVoucherFailure =
+            keepOnlyTheLastOf(notices, VoucherPricingFailed.class);
+
+        return keepOnlyTheLastOf(withOneVoucherFailure, PitchPricingFailed.class);
+    }
+
+    private static List<QuoteNotice> keepOnlyTheLastOf(
+        List<QuoteNotice> notices, Class<? extends QuoteNotice> noticeType
+    ) {
+        List<QuoteNotice> kept = new ArrayList<>();
+        boolean lastOfTypeSeen = false;
+        for (int index = notices.size() - 1; index >= 0; index--) {
+            QuoteNotice notice = notices.get(index);
+            if (!noticeType.isInstance(notice) || !lastOfTypeSeen) {
+                kept.add(0, notice);
+            }
+            lastOfTypeSeen = lastOfTypeSeen || noticeType.isInstance(notice);
+        }
+        return List.copyOf(kept);
+    }
+
+    private static List<QuoteNotice> groupNightsAdjustments(
+        Map<StayRequest.Line, Line> linesByRequest
+    ) {
+        Map<NightsAdjustment, SortedSet<String>> affectedPitchIdsByAdjustment =
+            new EnumMap<>(NightsAdjustment.class);
+
+        for (Map.Entry<StayRequest.Line, Line> quotedLine : linesByRequest.entrySet()) {
+            NightsAdjustment adjustment = NightsAdjustmentService.classify(quotedLine.getValue());
+            affectedPitchIdsByAdjustment
+                .computeIfAbsent(adjustment, unused -> new TreeSet<>())
+                .add(quotedLine.getKey().pitchId());
+        }
+
+        return affectedPitchIdsByAdjustment.entrySet().stream()
+            .map(adjustment -> toNightsNotices(adjustment.getKey(), List.copyOf(adjustment.getValue())))
+            .flatMap(List::stream)
+            .toList();
+    }
+
+    private static List<QuoteNotice> toNightsNotices(
+        NightsAdjustment adjustment, List<String> affectedPitchIds
+    ) {
+        return switch (adjustment) {
+            case NONE -> List.of();
+            case ADJUSTED_TO_WEEKLY_TARIFF -> List.of(new NightsAdjustedToWeeklyTariff(affectedPitchIds));
+            case RAISED_TO_MINIMUM_STAY -> List.of(new NightsRaisedToMinimumStay(affectedPitchIds));
+            case ROUNDED_TO_FULL_WEEK -> List.of(new NightsRoundedToFullWeek(affectedPitchIds));
+        };
+    }
+
+    private static List<QuoteNotice> groupFailuresNotShownOnLines(
+        Map<StayRequest.Line, Line> linesByRequest
+    ) {
+        Map<QuoteFailure, SortedSet<String>> affectedPitchIdsByFailure = new LinkedHashMap<>();
+
+        for (Map.Entry<StayRequest.Line, Line> quotedLine : linesByRequest.entrySet()) {
+            for (QuoteFailure failure : quotedLine.getValue().failuresNotShownOnTheLine()) {
+                affectedPitchIdsByFailure
+                    .computeIfAbsent(failure, unused -> new TreeSet<>())
+                    .add(quotedLine.getKey().pitchId());
+            }
+        }
+
+        return affectedPitchIdsByFailure.entrySet().stream()
+            .sorted(Comparator.comparing(failure -> describe(failure.getKey())))
+            .<QuoteNotice>map(failure -> new PitchesNotQuoted(
+                failure.getKey(),
+                List.copyOf(failure.getValue())))
+            .toList();
+    }
+
+    private static String describe(QuoteFailure failure) {
+        return switch (failure) {
+            case QuoteFailureType failureType -> failureType.name();
+            case UnrecognisedFailure unrecognisedFailure -> String.valueOf(unrecognisedFailure.bookingSystemText());
+        };
+    }
+
+    private List<QuoteNotice> findExceededHighValueThresholds(Collection<Line> lines) {
+        List<Money> lineSubtotals = lines.stream()
+            .map(Line::total)
+            .filter(Objects::nonNull)
+            .map(StayTotal::subtotal)
+            .toList();
+
+        return highValueStayThresholds.findExceededThresholds(lineSubtotals).stream()
+            .<QuoteNotice>map(HighValueStayThresholdExceeded::new)
+            .toList();
+    }
+}
