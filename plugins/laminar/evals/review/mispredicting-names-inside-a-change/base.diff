+package org.example.campsite.stayquote.quote.app.domain.model.notice;
+
+import org.example.campsite.stayquote.quote.app.domain.model.failure.QuoteFailure;
+import org.example.campsite.stayquote.quote.app.domain.model.pricing.Money;
+
+import java.util.List;
+
+public sealed interface QuoteNotice {
+
+    record NightsRoundedToFullWeek(List<String> affectedPitchIds)
+        implements QuoteNotice {}
+
+    record NightsRaisedToMinimumStay(List<String> affectedPitchIds)
+        implements QuoteNotice {}
+
+    record NightsAdjustedToWeeklyTariff(List<String> affectedPitchIds)
+        implements QuoteNotice {}
+
+    record PitchSwapped(String requestedPitchId, String offeredPitchId)
+        implements QuoteNotice {}
+
+    record PitchRenumbered(String formerPitchId)
+        implements QuoteNotice {}
+
+    record OccupancyLimited(Integer freePlaces)
+        implements QuoteNotice {}
+
+    record LateArrivalRequired()
+        implements QuoteNotice {}
+
+    record SeasonDiscountApplied()
+        implements QuoteNotice {}
+
+    record MemberRefundApplied()
+        implements QuoteNotice {}
+
+    record VoucherPricingFailed(QuoteFailure failure, String pitchId)
+        implements QuoteNotice {}
+
+    record PitchPricingFailed(QuoteFailure failure, String pitchId)
+        implements QuoteNotice {}
+
+    record RateAboveStandard()
+        implements QuoteNotice {}
+
+    record PitchesNotQuoted(QuoteFailure failure, List<String> affectedPitchIds)
+        implements QuoteNotice {}
+
+    record HighValueStayThresholdExceeded(Money threshold)
+        implements QuoteNotice {}
+}
