+import static org.example.campsite.stayquote.quote.in.graphql.BookingSystemQuoteFactory.buildSoapRequestFor;
+import static org.example.campsite.stayquote.quote.in.graphql.StayQuoteRequestFactory.buildEntitiesQuery;
