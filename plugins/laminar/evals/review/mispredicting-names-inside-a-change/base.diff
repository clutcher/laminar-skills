+package org.example.campsite.stayquote.quote.app.domain.model.failure;
+
+public enum QuoteFailureType implements QuoteFailure {
+
+    PITCH_NOT_FOUND(Topic.PITCH),
+    PITCH_NOT_BOOKABLE(Topic.PITCH),
+    NIGHTLY_RATE_UNAVAILABLE(Topic.PITCH),
+    VOUCHER_NOT_VALID_FOR_GUEST(Topic.VOUCHER),
+    VOUCHER_EXPIRED(Topic.VOUCHER),
+    VOUCHER_FOR_MEMBERS_ONLY(Topic.VOUCHER),
+    MEMBER_REFUND_RATE(Topic.VOUCHER),
+    PRICED_ON_GROUP_TARIFF(Topic.VOUCHER),
+    NIGHTS_RAISED_TO_MINIMUM_STAY(Topic.NIGHTS),
+    NIGHTS_ADJUSTED_TO_WEEKLY_TARIFF(Topic.NIGHTS),
+    LATE_ARRIVAL_ONLY(Topic.ARRIVAL),
+    GUEST_NOT_REGISTERED_FOR_PITCH(Topic.ELIGIBILITY),
+    GUEST_NOT_CLEARED_FOR_PITCH(Topic.ELIGIBILITY),
+    TOUR_OPERATOR_NOT_CLEARED_FOR_PITCH(Topic.ELIGIBILITY),
+    PITCH_RETIRED(Topic.ELIGIBILITY),
+    PITCH_NOT_BOOKABLE_ONLINE(Topic.ELIGIBILITY),
+    REQUESTED_PITCH_NOT_FOUND(Topic.ELIGIBILITY),
+    REQUESTED_PITCH_NOT_BOOKABLE(Topic.ELIGIBILITY),
+    PITCH_FOR_GROUPS_ONLY(Topic.ELIGIBILITY),
+    PITCH_NOT_FOR_TOUR_OPERATORS(Topic.ELIGIBILITY),
+    PITCH_CLOSED_FOR_SEASON(Topic.ELIGIBILITY);
+
+    public enum Topic { VOUCHER, PITCH, NIGHTS, ARRIVAL, ELIGIBILITY }
+
+    private final Topic topic;
+
+    QuoteFailureType(Topic topic) {
+        this.topic = topic;
+    }
+
+    public boolean concerns(Topic expectedTopic) {
+        return topic == expectedTopic;
+    }
+}
