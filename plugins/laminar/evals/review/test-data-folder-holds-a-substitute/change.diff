--- /dev/null
+++ b/observatory/src/test/java/com/example/observatory/telescope/TelescopePointingTest.java
@@ -0,0 +1,21 @@
+package com.example.observatory.telescope;
+
+import com.example.observatory.telescope.testdata.StubMountControllerApi;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class TelescopePointingTest {
+
+    private static final double ORION_NEBULA_RIGHT_ASCENSION = 83.82;
+    private static final double ORION_NEBULA_DECLINATION = -5.39;
+
+    @Test
+    void shouldReachTargetWhenMountAcceptsSlew() {
+        TelescopePointing pointing = new TelescopePointing(new StubMountControllerApi());
+
+        SlewResult result = pointing.aim(ORION_NEBULA_RIGHT_ASCENSION, ORION_NEBULA_DECLINATION);
+
+        assertThat(result.reached()).isTrue();
+    }
+}
