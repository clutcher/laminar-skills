+package com.example.observatory.telescope;
+
+public class TelescopePointing {
+
+    private final MountControllerApi mountControllerApi;
+
+    public TelescopePointing(MountControllerApi mountControllerApi) {
+        this.mountControllerApi = mountControllerApi;
+    }
+
+    public SlewResult aim(double rightAscension, double declination) {
+        return mountControllerApi.target(rightAscension, declination);
+    }
+}
diff --git a/observatory/src/test/java/com/example/observatory/telescope/TelescopePointingTest.java b/observatory/src/test/java/com/example/observatory/telescope/TelescopePointingTest.java
