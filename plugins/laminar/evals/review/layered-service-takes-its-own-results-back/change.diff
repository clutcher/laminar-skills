@@ -0,0 +1,31 @@
+package com.example.tours.service;
+
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.Objects;
+import org.springframework.stereotype.Service;
+
+@Service
+public class TourPriceMergingService {
+
+    private final PriceNoticeRules priceNoticeRules;
+
+    public TourPriceMergingService(PriceNoticeRules priceNoticeRules) {
+        this.priceNoticeRules = priceNoticeRules;
+    }
+
+    public BigDecimal totalOf(List<TourPrice> stopTourPrices) {
+        return stopTourPrices.stream()
+                .filter(Objects::nonNull)
+                .map(TourPrice::total)
+                .reduce(BigDecimal.ZERO, BigDecimal::add);
+    }
+
+    public List<PriceNotice> noticesOf(List<TourPrice> stopTourPrices) {
+        List<StopPrice> stopPrices = stopTourPrices.stream()
+                .filter(Objects::nonNull)
+                .map(stopTourPrice -> stopTourPrice.stopPrices().get(0))
+                .toList();
+        return priceNoticeRules.noticesFor(stopPrices, totalOf(stopTourPrices));
+    }
+}
