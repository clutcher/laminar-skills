+package com.example.tours.repository;
+
+import java.math.BigDecimal;
+import java.util.Map;
+import java.util.Set;
+import java.util.stream.Collectors;
+import org.springframework.jdbc.core.simple.JdbcClient;
+import org.springframework.stereotype.Repository;
+
+@Repository
+public class SeasonRateRepository {
+
+    private final JdbcClient jdbcClient;
+
+    public SeasonRateRepository(JdbcClient jdbcClient) {
+        this.jdbcClient = jdbcClient;
+    }
+
+    public Map<String, BigDecimal> pricesPerGuestFor(Set<String> stopCodes) {
+        return jdbcClient.sql("""
+                        select stop_code, price_per_guest
+                        from season_rate
+                        where stop_code in (:stopCodes) and current_date between valid_from and valid_until
+                        """)
+                .param("stopCodes", stopCodes)
+                .query((row, rowNumber) -> Map.entry(row.getString("stop_code"), row.getBigDecimal("price_per_guest")))
+                .stream()
+                .collect(Collectors.toMap(Map.Entry::getKey, Map.Entry::getValue));
+    }
+}
