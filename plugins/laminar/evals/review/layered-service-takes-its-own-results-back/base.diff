+import java.math.BigDecimal;
+import java.util.List;
+
+public record TourPrice(List<StopPrice> stopPrices, BigDecimal total, List<PriceNotice> notices) {
+
+    public StopPrice priceFor(String stopCode) {
+        return stopPrices.stream()
+                .filter(stopPrice -> stopPrice.stopCode().equals(stopCode))
+                .findFirst()
+                .orElseThrow();
+    }
+}
