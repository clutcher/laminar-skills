@@ -0,0 +1,58 @@
+package com.example.tours.controller;
+
+import static java.util.function.Function.identity;
+import static java.util.stream.Collectors.toMap;
+
+import com.example.tours.service.StopPrice;
+import com.example.tours.service.TourPrice;
+import com.example.tours.service.TourPriceService;
+import com.example.tours.service.TourStop;
+import java.math.BigDecimal;
+import java.util.Collection;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.CompletableFuture;
+import org.dataloader.DataLoader;
+import org.springframework.graphql.data.method.annotation.Argument;
+import org.springframework.graphql.data.method.annotation.QueryMapping;
+import org.springframework.graphql.data.method.annotation.SchemaMapping;
+import org.springframework.graphql.execution.BatchLoaderRegistry;
+import org.springframework.stereotype.Controller;
+import reactor.core.publisher.Mono;
+
+@Controller
+public class ItineraryPriceController {
+
+    private final TourPriceService tourPriceService;
+
+    public ItineraryPriceController(TourPriceService tourPriceService, BatchLoaderRegistry batchLoaderRegistry) {
+        this.tourPriceService = tourPriceService;
+        batchLoaderRegistry.forTypePair(ItineraryStop.class, StopPrice.class)
+                .registerMappedBatchLoader((itineraryStops, environment) -> Mono.just(stopPricesOf(itineraryStops)));
+    }
+
+    @QueryMapping
+    public Itinerary priceItinerary(@Argument List<ItineraryStop> stops) {
+        return new Itinerary(stops);
+    }
+
+    @SchemaMapping(typeName = "Itinerary", field = "price")
+    public TourPrice price(Itinerary itinerary) {
+        return tourPriceService.priceOf(tourStopsOf(itinerary.stops()));
+    }
+
+    @SchemaMapping(typeName = "ItineraryStop", field = "price")
+    public CompletableFuture<BigDecimal> stopPrice(ItineraryStop itineraryStop, DataLoader<ItineraryStop, StopPrice> stopPrices) {
+        return stopPrices.load(itineraryStop).thenApply(StopPrice::price);
+    }
+
+    private Map<ItineraryStop, StopPrice> stopPricesOf(Set<ItineraryStop> itineraryStops) {
+        TourPrice tourPrice = tourPriceService.priceOf(tourStopsOf(itineraryStops));
+        return itineraryStops.stream().collect(toMap(identity(), itineraryStop -> tourPrice.priceFor(itineraryStop.stopCode())));
+    }
+
+    private static List<TourStop> tourStopsOf(Collection<ItineraryStop> itineraryStops) {
+        return itineraryStops.stream().map(ItineraryStop::tourStop).toList();
+    }
+}
