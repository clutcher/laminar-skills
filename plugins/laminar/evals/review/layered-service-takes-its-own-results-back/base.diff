+package com.example.tours.service;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.List;
+import org.springframework.stereotype.Service;
+
+@Service
+public class PriceNoticeRules {
+
+    private static final BigDecimal TOUR_DESK_APPROVAL_TOTAL = new BigDecimal("5000.00");
+
+    public List<PriceNotice> noticesFor(List<StopPrice> stopPrices, BigDecimal total) {
+        List<PriceNotice> notices = new ArrayList<>();
+        stopPrices.stream()
+                .filter(stopPrice -> stopPrice.price().signum() == 0)
+                .map(stopPrice -> new PriceNotice(stopPrice.stopCode(), "Stop has no season rate"))
+                .forEach(notices::add);
+        if (total.compareTo(TOUR_DESK_APPROVAL_TOTAL) > 0) {
+            notices.add(new PriceNotice("tour", "Group price needs approval by the tour desk"));
+        }
+        return notices;
+    }
+}
