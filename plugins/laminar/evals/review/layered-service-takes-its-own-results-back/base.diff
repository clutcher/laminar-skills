@@ -0,0 +1,34 @@
+package com.example.tours.service;
+
+import com.example.tours.repository.SeasonRateRepository;
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
+import org.springframework.stereotype.Service;
+
+@Service
+public class TourPriceService {
+
+    private final SeasonRateRepository seasonRateRepository;
+    private final PriceNoticeRules priceNoticeRules;
+
+    public TourPriceService(SeasonRateRepository seasonRateRepository, PriceNoticeRules priceNoticeRules) {
+        this.seasonRateRepository = seasonRateRepository;
+        this.priceNoticeRules = priceNoticeRules;
+    }
+
+    public TourPrice priceOf(List<TourStop> stops) {
+        Map<String, BigDecimal> pricesPerGuest = seasonRateRepository.pricesPerGuestFor(
+                stops.stream().map(TourStop::stopCode).collect(Collectors.toSet()));
+        List<StopPrice> stopPrices = stops.stream()
+                .map(stop -> stopPriceOf(stop, pricesPerGuest.getOrDefault(stop.stopCode(), BigDecimal.ZERO)))
+                .toList();
+        BigDecimal total = stopPrices.stream().map(StopPrice::price).reduce(BigDecimal.ZERO, BigDecimal::add);
+        return new TourPrice(stopPrices, total, priceNoticeRules.noticesFor(stopPrices, total));
+    }
+
+    private StopPrice stopPriceOf(TourStop stop, BigDecimal pricePerGuest) {
+        return new StopPrice(stop.stopCode(), pricePerGuest.multiply(BigDecimal.valueOf(stop.guests())));
+    }
+}
