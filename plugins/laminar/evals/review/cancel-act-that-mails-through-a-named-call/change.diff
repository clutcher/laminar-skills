+package com.example.canoe.rental;
+
+import lombok.RequiredArgsConstructor;
+
+@RequiredArgsConstructor
+public class CanoeRentalService {
+
+    private final CanoeRentalRepository rentalRepository;
+    private final CancellationMailer cancellationMailer;
+
+    public CanoeRental cancelRental(String rentalCode) {
+        CanoeRental rental = rentalRepository.findByCode(rentalCode);
+        rental.cancel();
+        rentalRepository.save(rental);
+        cancellationMailer.sendCancellationMail(rental);
+        return rental;
+    }
+}
