+package com.example.marina.hire
+
+import org.springframework.graphql.data.method.annotation.Argument
+import org.springframework.graphql.data.method.annotation.QueryMapping
+import org.springframework.stereotype.Controller
+
+@Controller
+class HireQuoteController(private val rateCard: RateCard) {
+
+    @QueryMapping
+    fun kayakHireQuote(@Argument request: KayakHireRequest): KayakHireQuote {
+        val hourlyRate = rateCard.kayakHourlyRate()
+        return KayakHireQuote(request.kayakId, request.startsAt, request.hours, hourlyRate.amount * request.hours, hourlyRate.currency)
+    }
+}
