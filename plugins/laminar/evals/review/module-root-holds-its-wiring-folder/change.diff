+package com.example.allotment.plotletting.config;
+
+import com.example.allotment.plotletting.app.api.ApiForPlotLetting;
+import com.example.allotment.plotletting.app.domain.services.PlotLettingService;
+import com.example.allotment.plotletting.app.spi.PlotLeaseRepository;
+import com.example.allotment.plotletting.out.db.PlotLeaseRepositoryUsingJpa;
+import com.example.allotment.plotletting.out.db.PlotLeaseRow;
+import java.time.Clock;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.data.jpa.repository.JpaRepository;
+
+@Configuration
+public class PlotLettingModuleConfiguration {
+
+    @Bean("plotLeaseRepository")
+    public PlotLeaseRepository createPlotLeaseRepository(JpaRepository<PlotLeaseRow, String> plotLeaseRows) {
+        return new PlotLeaseRepositoryUsingJpa(plotLeaseRows);
+    }
+
+    @Bean("apiForPlotLetting")
+    public ApiForPlotLetting createApiForPlotLetting(PlotLeaseRepository plotLeaseRepository, Clock clock) {
+        return new PlotLettingService(plotLeaseRepository, clock);
+    }
+}
