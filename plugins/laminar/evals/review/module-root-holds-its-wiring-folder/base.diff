diff --git a/allotment-office/src/main/java/com/example/allotment/plotletting/out/db/PlotLeaseRepositoryUsingJpa.java b/allotment-office/src/main/java/com/example/allotment/plotletting/out/db/PlotLeaseRepositoryUsingJpa.java
