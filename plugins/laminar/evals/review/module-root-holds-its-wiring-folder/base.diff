--- /dev/null
+++ b/allotment-office/src/main/java/com/example/allotment/plotletting/out/db/PlotLeaseRepositoryUsingJpa.java
@@ -0,0 +1,25 @@
+package com.example.allotment.plotletting.out.db;
+
+import com.example.allotment.plotletting.app.domain.model.PlotLease;
+import com.example.allotment.plotletting.app.spi.PlotLeaseRepository;
+import org.springframework.data.jpa.repository.JpaRepository;
+
+public class PlotLeaseRepositoryUsingJpa implements PlotLeaseRepository {
+
+    private final JpaRepository<PlotLeaseRow, String> plotLeaseRows;
+
+    public PlotLeaseRepositoryUsingJpa(JpaRepository<PlotLeaseRow, String> plotLeaseRows) {
+        this.plotLeaseRows = plotLeaseRows;
+    }
+
+    @Override
+    public boolean isPlotLet(String plotNumber) {
+        return plotLeaseRows.existsById(plotNumber);
+    }
+
+    @Override
+    public PlotLease saveLease(PlotLease lease) {
+        plotLeaseRows.save(new PlotLeaseRow(lease.plotNumber(), lease.gardenerId(), lease.startDate()));
+        return lease;
+    }
+}
