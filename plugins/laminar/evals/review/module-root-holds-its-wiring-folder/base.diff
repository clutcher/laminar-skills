@@ -0,0 +1,28 @@
+package com.example.allotment.plotletting.app.domain.services;
+
+import com.example.allotment.plotletting.app.api.ApiForPlotLetting;
+import com.example.allotment.plotletting.app.domain.model.PlotLease;
+import com.example.allotment.plotletting.app.spi.PlotLeaseRepository;
+import java.time.Clock;
+import java.time.LocalDate;
+
+public class PlotLettingService implements ApiForPlotLetting {
+
+    private final PlotLeaseRepository plotLeaseRepository;
+    private final Clock clock;
+
+    public PlotLettingService(PlotLeaseRepository plotLeaseRepository, Clock clock) {
+        this.plotLeaseRepository = plotLeaseRepository;
+        this.clock = clock;
+    }
+
+    @Override
+    public PlotLease letPlot(String plotNumber, String gardenerId) {
+        if (plotLeaseRepository.isPlotLet(plotNumber)) {
+            throw new IllegalStateException("Plot " + plotNumber + " is already let");
+        }
+
+        PlotLease lease = new PlotLease(plotNumber, gardenerId, LocalDate.now(clock));
+        return plotLeaseRepository.saveLease(lease);
+    }
+}
