@@ -0,0 +1,11 @@
+package com.example.library.loans.out.catalog;
+
+import com.example.library.loans.app.domain.LoanTerms;
+
+public final class CatalogLoanMapper {
+
+    public LoanTerms toLoanTerms(CatalogLoanResponse response) {
+        boolean renewalAllowed = response.renewalCode() != null && !response.renewalCode().isBlank();
+        return new LoanTerms(response.loanId(), renewalAllowed, response.requestedDays(), response.grantedDays());
+    }
+}
