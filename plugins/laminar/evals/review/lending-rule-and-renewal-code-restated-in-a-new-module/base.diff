+package com.example.library.loans.app;
+
+import com.example.library.loans.app.domain.LoanTerms;
+
+public class LoanStatistics {
+
+    public boolean wasShortened(LoanTerms terms) {
+        return terms.grantedDays() < terms.requestedDays();
+    }
+}
