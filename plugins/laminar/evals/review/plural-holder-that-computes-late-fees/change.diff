+package com.example.bikerental.latefees;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.time.temporal.ChronoUnit;
+import java.util.ArrayList;
+import java.util.List;
+
+public class Rentals {
+
+    private static final BigDecimal LATE_FEE_DAILY_RATE = new BigDecimal("4.00");
+
+    private final List<Rental> rentals = new ArrayList<>();
+
+    public void add(Rental rental) {
+        rentals.add(rental);
+    }
+
+    public List<Rental> getRentals() {
+        return List.copyOf(rentals);
+    }
+
+    public BigDecimal calculateLateFeeTotal(LocalDate today) {
+        BigDecimal lateFeeTotal = BigDecimal.ZERO;
+        for (Rental rental : rentals) {
+            long daysLate = Math.max(0, ChronoUnit.DAYS.between(rental.dueOn(), today));
+            BigDecimal lateFee = LATE_FEE_DAILY_RATE.multiply(BigDecimal.valueOf(daysLate));
+            lateFeeTotal = lateFeeTotal.add(lateFee);
+        }
+        return lateFeeTotal;
+    }
+}
