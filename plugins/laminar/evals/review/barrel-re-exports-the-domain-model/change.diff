@@ -0,0 +1,10 @@
+import { RentalLookup, RentalReceipt } from "../../../rental";
+
+export class ChargesUsingRentalModule {
+  constructor(private readonly rentalLookup: RentalLookup) {}
+
+  async chargedCentsOf(riderId: string): Promise<number> {
+    const receipts: RentalReceipt[] = await this.rentalLookup.receiptsOfRider(riderId, new Date());
+    return receipts.filter(receipt => !receipt.isFree()).reduce((sum, receipt) => sum + receipt.priceInCents, 0);
+  }
+}
