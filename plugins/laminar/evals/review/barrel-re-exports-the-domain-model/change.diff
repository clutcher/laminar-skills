@@ -0,0 +1,11 @@
+export class RentalReceipt {
+  constructor(
+    readonly rentalId: string,
+    readonly minutes: number,
+    readonly priceInCents: number,
+  ) {}
+
+  isFree(): boolean {
+    return this.minutes <= 15;
+  }
+}
