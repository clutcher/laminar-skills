diff --git a/courier-desk/src/tracking-providers/AramexTrackingProvider.ts b/courier-desk/src/tracking-providers/AramexTrackingProvider.ts
new file mode 100644
--- /dev/null
+++ b/courier-desk/src/tracking-providers/AramexTrackingProvider.ts
@@ -0,0 +1,10 @@
+import { TrackingProvider } from "./TrackingProvider";
+
+export class AramexTrackingProvider implements TrackingProvider {
+  readonly carrierCode = "ARAMEX";
+  private readonly statusByTrackingNumber = new Map<string, string>();
+
+  readTrackingStatus(trackingNumber: string): string {
+    return this.statusByTrackingNumber.get(trackingNumber) ?? "unknown";
+  }
+}
