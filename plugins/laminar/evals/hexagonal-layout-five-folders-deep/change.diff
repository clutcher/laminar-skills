+package com.example.website.order.in.rest;
+
+import com.example.website.order.app.api.ApiForOrderPlacing;
+import java.util.List;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+public class OrderController {
+
+    private final ApiForOrderPlacing apiForOrderPlacing;
+
+    public OrderController(ApiForOrderPlacing apiForOrderPlacing) {
+        this.apiForOrderPlacing = apiForOrderPlacing;
+    }
+
+    @PostMapping("/orders")
+    public Long placeOrder(@RequestBody PlaceOrderRequest request) {
+        return apiForOrderPlacing.placeOrder(request.customerId(), request.productIds());
+    }
+
+    public record PlaceOrderRequest(Long customerId, List<Long> productIds) {
+    }
+}
