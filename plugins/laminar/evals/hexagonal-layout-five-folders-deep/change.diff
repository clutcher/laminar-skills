+package com.example.website.order.app.domain.services;
+
+import com.example.website.order.app.api.ApiForOrderPlacing;
+import com.example.website.order.app.domain.model.Order;
+import com.example.website.order.app.domain.model.Product;
+import com.example.website.order.app.spi.ConsignmentRepository;
+import com.example.website.order.app.spi.OrderRepository;
+import com.example.website.order.app.spi.ProductRepository;
+import java.util.List;
+
+public class OrderPlacingService implements ApiForOrderPlacing {
+
+    private final OrderRepository orderRepository;
+    private final ProductRepository productRepository;
+    private final ConsignmentRepository consignmentRepository;
+
+    public OrderPlacingService(OrderRepository orderRepository, ProductRepository productRepository, ConsignmentRepository consignmentRepository) {
+        this.orderRepository = orderRepository;
+        this.productRepository = productRepository;
+        this.consignmentRepository = consignmentRepository;
+    }
+
+    @Override
+    public Long placeOrder(Long customerId, List<Long> productIds) {
+        List<Product> products = productRepository.findAllById(productIds);
+        Order order = orderRepository.save(new Order(customerId, products));
+        consignmentRepository.planConsignmentsFor(order);
+        return order.getId();
+    }
+}
