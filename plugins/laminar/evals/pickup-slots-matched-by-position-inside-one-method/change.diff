+package com.example.freightyard.quotes;
+
+import com.example.freightyard.slots.api.ApiForPickupEstimation;
+import com.example.freightyard.slots.api.PickupEstimate;
+import com.example.freightyard.slots.api.PickupRequest;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+public class QuoteDrafting {
+
+    private final ApiForPickupEstimation pickupEstimation;
+
+    public QuoteDrafting(ApiForPickupEstimation pickupEstimation) {
+        this.pickupEstimation = pickupEstimation;
+    }
+
+    public Map<Shipment, String> draftPickupSlots(List<Shipment> shipments) {
+        Map<String, Shipment> shipmentsByLine = new HashMap<>();
+        List<PickupRequest> requests = new ArrayList<>();
+        for (Shipment shipment : shipments) {
+            shipmentsByLine.put(String.valueOf(shipmentsByLine.size()), shipment);
+            requests.add(new PickupRequest(shipment.parcelCode(), shipment.customerCode(), shipment.crateCount()));
+        }
+        List<PickupEstimate> estimates = pickupEstimation.estimate(requests);
+        Map<Shipment, String> slotsByShipment = new HashMap<>();
+        for (int line = 0; line < estimates.size(); line++) {
+            slotsByShipment.put(shipmentsByLine.get(String.valueOf(line)), estimates.get(line).slot());
+        }
+        return slotsByShipment;
+    }
+}
