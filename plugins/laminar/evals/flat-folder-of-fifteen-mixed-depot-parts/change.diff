diff --git a/courier-desk/src/depot/ColdRoomSlots.ts b/courier-desk/src/depot/ColdRoomSlots.ts
new file mode 100644
--- /dev/null
+++ b/courier-desk/src/depot/ColdRoomSlots.ts
@@ -0,0 +1,5 @@
+export class ColdRoomSlots {
+  countFreeSlots(usedSlots: number, totalSlots: number): number {
+    return Math.max(0, totalSlots - usedSlots);
+  }
+}
