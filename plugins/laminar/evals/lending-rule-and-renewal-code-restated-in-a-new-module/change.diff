@@ -0,0 +1,14 @@
+package com.example.library.reminders.app;
+
+import com.example.library.loans.app.domain.LoanTerms;
+import java.time.LocalDate;
+
+public class ReminderPlanner {
+
+    public LocalDate reminderDateFor(LoanTerms terms, LocalDate borrowedOn) {
+        int lendingDays = terms.renewalAllowed()
+            ? terms.requestedDays()
+            : terms.grantedDays();
+        return borrowedOn.plusDays(lendingDays - 2);
+    }
+}
