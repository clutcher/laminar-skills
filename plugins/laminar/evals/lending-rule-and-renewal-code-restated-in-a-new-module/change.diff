+package com.example.library.reminders.out.catalog;
+
+import com.example.library.loans.out.catalog.CatalogLoanResponse;
+import com.example.library.reminders.app.domain.ReminderLoan;
+
+public final class CatalogReminderMapper {
+
+    public ReminderLoan toReminderLoan(CatalogLoanResponse response) {
+        boolean renewable = "Y".equals(response.renewalCode());
+        return new ReminderLoan(response.loanId(), renewable);
+    }
+}
