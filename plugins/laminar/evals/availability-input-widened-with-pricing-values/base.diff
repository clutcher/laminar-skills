@@ -0,0 +1,31 @@
+package com.example.storefront.product;
+
+import java.util.List;
+import org.springframework.stereotype.Service;
+
+@Service
+public class WarehouseStockLookup implements StockLookup {
+
+    private final WarehouseClient warehouseClient;
+
+    public WarehouseStockLookup(WarehouseClient warehouseClient) {
+        this.warehouseClient = warehouseClient;
+    }
+
+    @Override
+    public Availability availabilityFor(String sku, String accountId, String languageId) {
+        return warehouseClient.stockLevel(sku, accountId).toAvailability();
+    }
+
+    @Override
+    public DeliveryEstimate deliveryEstimateFor(String sku, String accountId, String languageId) {
+        return warehouseClient.shippingWindow(sku, accountId).toDeliveryEstimate(languageId);
+    }
+
+    @Override
+    public List<PickupStore> pickupStoresFor(String sku, String accountId, String languageId) {
+        return warehouseClient.storesHolding(sku, accountId).stream()
+                .map(store -> store.toPickupStore(languageId))
+                .toList();
+    }
+}
