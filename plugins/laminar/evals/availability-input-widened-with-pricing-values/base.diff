@@ -0,0 +1,44 @@
+type Query {
+    product(sku: ID!): Product
+}
+
+type Product {
+    sku: ID!
+    name: String!
+    price(input: PriceInput!): Price
+    availability(input: AvailabilityInput!): Availability
+    deliveryEstimate(input: AvailabilityInput!): DeliveryEstimate
+    pickupStores(input: AvailabilityInput!): [PickupStore!]
+}
+
+input PriceInput {
+    accountId: ID!
+    languageId: String!
+    quantity: Int!
+    agreementId: ID
+}
+
+input AvailabilityInput {
+    accountId: ID!
+    languageId: String!
+}
+
+type Price {
+    amount: Float!
+    currency: String!
+}
+
+type Availability {
+    inStock: Boolean!
+    quantityOnHand: Int!
+}
+
+type DeliveryEstimate {
+    earliestDate: String!
+    latestDate: String!
+}
+
+type PickupStore {
+    storeId: ID!
+    name: String!
+}
