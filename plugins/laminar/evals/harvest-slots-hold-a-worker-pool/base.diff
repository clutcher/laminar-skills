+from dataclasses import dataclass
+from datetime import datetime
+
+
+@dataclass(frozen=True)
+class PackhouseLine:
+    line_number: int
+    block_code: str
+    picked_at: datetime
+    crates: int
+
+
+@dataclass(frozen=True)
+class PackhouseAnswer:
+    line_number: int
+    slot_opens: datetime
+    slot_closes: datetime
+    first_grader_capacity: int
+
+
+class PackhouseClient:
+    def plan_lines(self, lines: list[PackhouseLine]) -> list[PackhouseAnswer]:
+        raise NotImplementedError
