+package com.example.marina.berths
+
+class BerthScheduleService(private val harbourMaster: HarbourMaster) {
+
+    fun schedule(request: BerthRequest): BerthSchedule =
+        addOverflowSlotsForUnplacedVessels(request, harbourMaster.scheduleFor(request.harbour))
+
+    private fun addOverflowSlotsForUnplacedVessels(request: BerthRequest, schedule: BerthSchedule): BerthSchedule {
+        val unplacedVessels = request.vessels.filter { vessel -> vessel !in schedule.slots }
+        return schedule.copy(slots = schedule.slots + unplacedVessels.map { vessel -> "overflow-$vessel" })
+    }
+}
