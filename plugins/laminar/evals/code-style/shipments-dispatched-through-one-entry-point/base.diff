+package com.example.warehouse.shipment.in.rest;
+
+import com.example.warehouse.shipment.app.api.ShipmentRegistering;
+import com.example.warehouse.shipment.app.domain.model.Shipment;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+@RequestMapping("/shipments")
+public class ShipmentController {
+
+    private final ShipmentRegistering shipmentRegistering;
+
+    public ShipmentController(ShipmentRegistering shipmentRegistering) {
+        this.shipmentRegistering = shipmentRegistering;
+    }
+
+    @PostMapping
+    public Shipment registerPackedShipment(@RequestParam String orderId, @RequestParam int weightGrams, @RequestParam String destinationPostcode) {
+        return shipmentRegistering.registerPackedShipment(orderId, weightGrams, destinationPostcode);
+    }
+}
