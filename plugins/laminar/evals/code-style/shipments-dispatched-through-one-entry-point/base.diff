+package com.example.warehouse.shipment.out.carrier.dispatch.batching;
+
+import java.time.Duration;
+import java.time.Instant;
+
+public record BatchWindow(Instant opensAt, Duration length) {
+
+    public Instant closesAt() {
+        return opensAt.plus(length);
+    }
+
+    public boolean hasClosedAt(Instant moment) {
+        return !moment.isBefore(closesAt());
+    }
+}
