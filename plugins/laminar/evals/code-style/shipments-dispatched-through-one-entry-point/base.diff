+package com.example.warehouse.shipment.app.domain.services;
+
+import com.example.warehouse.shipment.app.domain.model.Shipment;
+import com.example.warehouse.shipment.app.spi.ShipmentRepository;
+import org.junit.jupiter.api.Test;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Optional;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class ShipmentRegisteringServiceTest {
+
+    private final Map<String, Shipment> savedShipments = new HashMap<>();
+    private final ShipmentRepository shipmentRepository = new ShipmentRepository() {
+        @Override
+        public Optional<Shipment> findById(String shipmentId) {
+            return Optional.ofNullable(savedShipments.get(shipmentId));
+        }
+
+        @Override
+        public void save(Shipment shipment) {
+            savedShipments.put(shipment.shipmentId(), shipment);
+        }
+    };
+    private final ShipmentRegisteringService shipmentRegisteringService = new ShipmentRegisteringService(shipmentRepository);
+
+    @Test
+    void shouldFindThePackedShipmentByItsIdWhenItWasRegistered() {
+        // given
+        String orderId = "ORD-2041";
+
+        // when
+        Shipment registered = shipmentRegisteringService.registerPackedShipment(orderId, 1850, "80331");
+
+        // then
+        assertThat(shipmentRepository.findById(registered.shipmentId()))
+                .contains(new Shipment(registered.shipmentId(), "ORD-2041", 1850, "80331"));
+    }
+}
