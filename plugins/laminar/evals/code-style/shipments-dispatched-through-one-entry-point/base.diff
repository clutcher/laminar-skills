+package com.example.warehouse.shipment.out.carrier.batching;
+
+import com.example.warehouse.shipment.app.domain.model.Shipment;
+import org.springframework.stereotype.Component;
+import org.springframework.web.client.RestClient;
+
+import java.util.List;
+
+@Component
+public class BatchSender {
+
+    private final RestClient carrierRestClient;
+
+    public BatchSender(RestClient carrierRestClient) {
+        this.carrierRestClient = carrierRestClient;
+    }
+
+    public void send(ShipmentBatch batch) {
+        carrierRestClient.post()
+                .uri("/manifests/{manifestId}", batch.batchId())
+                .body(manifestParcelsOf(batch.shipments()))
+                .retrieve()
+                .toBodilessEntity();
+    }
+
+    private static List<ManifestParcel> manifestParcelsOf(List<Shipment> shipments) {
+        return shipments.stream()
+                .map(shipment -> new ManifestParcel(shipment.shipmentId(), shipment.weightGrams(), shipment.destinationPostcode()))
+                .toList();
+    }
+
+    private record ManifestParcel(String reference, int weightGrams, String postcode) {
+    }
+}
