+package com.example.warehouse.shipment.out.carrier.dispatch.batching;
+
+import com.example.warehouse.shipment.app.domain.model.Shipment;
+
+import java.util.ArrayList;
+import java.util.List;
+
+public class ShipmentBatch {
+
+    private final String batchId;
+    private final int capacity;
+    private final List<Shipment> shipments = new ArrayList<>();
+
+    public ShipmentBatch(String batchId, int capacity) {
+        this.batchId = batchId;
+        this.capacity = capacity;
+    }
+
+    public void add(Shipment shipment) {
+        if (isFull()) {
+            throw new IllegalStateException("Batch " + batchId + " is full");
+        }
+        shipments.add(shipment);
+    }
+
+    public boolean isFull() {
+        return shipments.size() >= capacity;
+    }
+
+    public String batchId() {
+        return batchId;
+    }
+
+    public List<Shipment> shipments() {
+        return List.copyOf(shipments);
+    }
+}
