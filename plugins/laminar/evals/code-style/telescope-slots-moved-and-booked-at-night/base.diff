@@ -0,0 +1,22 @@
+package com.example.observatory.schedule;
+
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.util.List;
+
+public class NightSchedule {
+
+    private final LocalDate night;
+    private final LocalDateTime dawn;
+    private final List<ViewingSlot> slots;
+
+    public NightSchedule(LocalDate night, LocalDateTime dawn, List<ViewingSlot> slots) {
+        this.night = night;
+        this.dawn = dawn;
+        this.slots = List.copyOf(slots);
+    }
+
+    public List<ViewingSlot> listSlots() {
+        return slots;
+    }
+}
