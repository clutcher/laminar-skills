diff --git a/src/test/java/com/example/observatory/schedule/NightScheduleTest.java b/src/test/java/com/example/observatory/schedule/NightScheduleTest.java
new file mode 100644
index 0000000..35b759b
--- /dev/null
+++ b/src/test/java/com/example/observatory/schedule/NightScheduleTest.java
@@ -0,0 +1,23 @@
+package com.example.observatory.schedule;
+
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.util.List;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+
+class NightScheduleTest {
+
+    @Test
+    void shouldListEverySlotWhenSlotsAreStored() {
+        LocalDate night = LocalDate.of(2026, 3, 14);
+        LocalDateTime dawn = LocalDateTime.of(2026, 3, 15, 6, 10);
+        ViewingSlot refractorSlot = new ViewingSlot("REF-200", LocalDateTime.of(2026, 3, 14, 22, 0), 90, "Ada Lovelace");
+        ViewingSlot reflectorSlot = new ViewingSlot("REFL-400", LocalDateTime.of(2026, 3, 15, 1, 0), 60, "Caroline Herschel");
+        NightSchedule schedule = new NightSchedule(night, dawn, List.of(refractorSlot, reflectorSlot));
+
+        List<ViewingSlot> listedSlots = schedule.listSlots();
+
+        Assertions.assertEquals(List.of(refractorSlot, reflectorSlot), listedSlots);
+    }
+}
diff --git a/src/test/java/com/example/observatory/schedule/ViewingSlotTest.java b/src/test/java/com/example/observatory/schedule/ViewingSlotTest.java
new file mode 100644
index 0000000..b1a631e
--- /dev/null
+++ b/src/test/java/com/example/observatory/schedule/ViewingSlotTest.java
@@ -0,0 +1,19 @@
+package com.example.observatory.schedule;
+
+import java.time.LocalDateTime;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+
+class ViewingSlotTest {
+
+    @Test
+    void shouldEndAfterItsMinutesWhenSlotStarts() {
+        LocalDateTime start = LocalDateTime.of(2026, 3, 14, 22, 0);
+        int slotMinutes = 90;
+        ViewingSlot slot = new ViewingSlot("REF-200", start, slotMinutes, "Ada Lovelace");
+
+        LocalDateTime end = slot.calculateEnd();
+
+        Assertions.assertEquals(LocalDateTime.of(2026, 3, 14, 23, 30), end);
+    }
+}
