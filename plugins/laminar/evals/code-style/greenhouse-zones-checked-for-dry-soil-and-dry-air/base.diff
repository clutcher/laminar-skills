@@ -0,0 +1,53 @@
+package com.example.greenhouse.grower;
+
+import com.example.greenhouse.model.SoilMoistureReading;
+import com.example.greenhouse.model.Zone;
+import com.example.greenhouse.sensor.FixedSensorNetwork;
+import com.example.greenhouse.sensor.SensorNetwork;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.List;
+
+class DrySoilMorningNotifierTest {
+
+    private static final Instant MORNING = Instant.parse("2026-05-04T06:00:00Z");
+    private static final Zone TOMATO_ZONE = new Zone("zone-1", "tomato", 12);
+    private static final Zone BASIL_ZONE = new Zone("zone-2", "basil", 4);
+
+    private final RecordingGrowerNotifier growerNotifier = new RecordingGrowerNotifier();
+
+    @Test
+    void shouldListOnlyTheZonesWithDrySoil() {
+        int drySoilMoisturePercent = 29;
+        int moistSoilMoisturePercent = 30;
+        SensorNetwork sensorNetwork = new FixedSensorNetwork(List.of(
+                new SoilMoistureReading(TOMATO_ZONE, drySoilMoisturePercent, MORNING),
+                new SoilMoistureReading(BASIL_ZONE, moistSoilMoisturePercent, MORNING)), List.of());
+
+        new DrySoilMorningNotifier(sensorNetwork, growerNotifier).sendDrySoilMessage();
+
+        Assertions.assertEquals(List.of("Dry soil this morning:\nzone-1 tomato: soil moisture 29 percent"), growerNotifier.sentTexts);
+    }
+
+    @Test
+    void shouldSendNoMessageWhenNoSoilIsDry() {
+        int moistSoilMoisturePercent = 30;
+        SensorNetwork sensorNetwork = new FixedSensorNetwork(List.of(new SoilMoistureReading(TOMATO_ZONE, moistSoilMoisturePercent, MORNING)), List.of());
+
+        new DrySoilMorningNotifier(sensorNetwork, growerNotifier).sendDrySoilMessage();
+
+        Assertions.assertEquals(List.of(), growerNotifier.sentTexts);
+    }
+
+    private static final class RecordingGrowerNotifier implements GrowerNotifier {
+
+        private final List<String> sentTexts = new ArrayList<>();
+
+        @Override
+        public void notifyGrower(String text) {
+            sentTexts.add(text);
+        }
+    }
+}
