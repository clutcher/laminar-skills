+package com.example.greenhouse.grower;
+
+import com.example.greenhouse.model.SoilMoistureReading;
+import com.example.greenhouse.model.Zone;
+import com.example.greenhouse.sensor.SensorNetwork;
+import java.util.ArrayList;
+import java.util.List;
+
+public class DrySoilMorningNotifier {
+
+    private final SensorNetwork sensorNetwork;
+    private final GrowerNotifier growerNotifier;
+
+    public DrySoilMorningNotifier(SensorNetwork sensorNetwork, GrowerNotifier growerNotifier) {
+        this.sensorNetwork = sensorNetwork;
+        this.growerNotifier = growerNotifier;
+    }
+
+    public void sendDrySoilMessage() {
+        List<String> dryZoneLines = new ArrayList<>();
+        for (SoilMoistureReading reading : sensorNetwork.readLatestSoilMoisture()) {
+            Zone zone = reading.zone();
+            addLineWhenDry(dryZoneLines, zone.zoneId(), zone.cropName(), reading.moisturePercent());
+        }
+        if (dryZoneLines.isEmpty()) {
+            return;
+        }
+
+        growerNotifier.notifyGrower("Dry soil this morning:\n" + String.join("\n", dryZoneLines));
+    }
+
+    private void addLineWhenDry(List<String> dryZoneLines, String zoneId, String cropName, int moisturePercent) {
+        if (moisturePercent < 30) {
+            dryZoneLines.add(formatDryZoneLine(zoneId, cropName, moisturePercent));
+        }
+    }
+
+    private String formatDryZoneLine(String zoneId, String cropName, int moisturePercent) {
+        return zoneId + " " + cropName + ": soil moisture " + moisturePercent + " percent";
+    }
+}
