+package com.example.greenhouse.climate;
+
+import com.example.greenhouse.model.AirHumidityReading;
+import com.example.greenhouse.model.Zone;
+import com.example.greenhouse.sensor.FixedSensorNetwork;
+import com.example.greenhouse.sensor.SensorNetwork;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.List;
+
+class MistingRoundTest {
+
+    private static final Instant NOON = Instant.parse("2026-05-04T12:00:00Z");
+    private static final Zone TOMATO_ZONE = new Zone("zone-1", "tomato", 12);
+
+    private final RecordingFanController fanController = new RecordingFanController();
+
+    @Test
+    void shouldStartTheMistingFansWhenTheAirIsDry() {
+        int dryAirHumidityPercent = 29;
+        SensorNetwork sensorNetwork = new FixedSensorNetwork(List.of(), List.of(new AirHumidityReading(TOMATO_ZONE, dryAirHumidityPercent, NOON)));
+
+        new MistingRound(sensorNetwork, fanController).startMistingFansInDryAir();
+
+        Assertions.assertEquals(List.of("zone-1"), fanController.startedZoneIds);
+    }
+
+    @Test
+    void shouldKeepTheMistingFansOffWhenTheAirIsHumid() {
+        int humidAirHumidityPercent = 30;
+        SensorNetwork sensorNetwork = new FixedSensorNetwork(List.of(), List.of(new AirHumidityReading(TOMATO_ZONE, humidAirHumidityPercent, NOON)));
+
+        new MistingRound(sensorNetwork, fanController).startMistingFansInDryAir();
+
+        Assertions.assertEquals(List.of(), fanController.startedZoneIds);
+    }
+
+    private static final class RecordingFanController implements FanController {
+
+        private final List<String> startedZoneIds = new ArrayList<>();
+
+        @Override
+        public void startMistingFans(String zoneId) {
+            startedZoneIds.add(zoneId);
+        }
+    }
+}
