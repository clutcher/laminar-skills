+package com.example.greenhouse.irrigation;
+
+import com.example.greenhouse.model.SoilMoistureReading;
+import com.example.greenhouse.model.Zone;
+import com.example.greenhouse.sensor.SensorNetwork;
+
+public class WateringRound {
+
+    private final SensorNetwork sensorNetwork;
+    private final ValveController valveController;
+
+    public WateringRound(SensorNetwork sensorNetwork, ValveController valveController) {
+        this.sensorNetwork = sensorNetwork;
+        this.valveController = valveController;
+    }
+
+    public void waterDryZones() {
+        for (SoilMoistureReading reading : sensorNetwork.readLatestSoilMoisture()) {
+            if (reading.moisturePercent() < 30) {
+                Zone zone = reading.zone();
+                valveController.openValve(zone.zoneId(), zone.wateringLitres());
+            }
+        }
+    }
+}
