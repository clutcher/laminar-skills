+package com.example.greenhouse.climate;
+
+import com.example.greenhouse.model.AirHumidityReading;
+import com.example.greenhouse.sensor.SensorNetwork;
+
+public class MistingRound {
+
+    private final SensorNetwork sensorNetwork;
+    private final FanController fanController;
+
+    public MistingRound(SensorNetwork sensorNetwork, FanController fanController) {
+        this.sensorNetwork = sensorNetwork;
+        this.fanController = fanController;
+    }
+
+    public void startMistingFansInDryAir() {
+        for (AirHumidityReading reading : sensorNetwork.readLatestAirHumidity()) {
+            if (reading.humidityPercent() < 30) {
+                fanController.startMistingFans(reading.zone().zoneId());
+            }
+        }
+    }
+}
