+class WateringRoundTest {
+
+    private static final Instant MORNING = Instant.parse("2026-05-04T06:00:00Z");
+    private static final Zone TOMATO_ZONE = new Zone("zone-1", "tomato", 12);
+
+    private final RecordingValveController valveController = new RecordingValveController();
