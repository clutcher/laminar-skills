+package com.example.workshop.repair;
+
+import com.example.workshop.customer.CustomerMessenger;
+import java.time.Clock;
+import java.time.LocalDate;
+import java.util.UUID;
+
+public class RepairDesk {
+
+    private final RepairJobRepository repairJobRepository;
+    private final CustomerMessenger customerMessenger;
+    private final Clock clock;
+
+    public RepairDesk(RepairJobRepository repairJobRepository, CustomerMessenger customerMessenger, Clock clock) {
+        this.repairJobRepository = repairJobRepository;
+        this.customerMessenger = customerMessenger;
+        this.clock = clock;
+    }
+
+    public RepairJob openJob(String customerId, String bikeDescription) {
+        RepairJob job = new RepairJob(UUID.randomUUID().toString(), customerId, bikeDescription, RepairStatus.OPEN, LocalDate.now(clock), null);
+        repairJobRepository.save(job);
+
+        customerMessenger.send(customerId, "We received your " + bikeDescription + ". Your job number is " + job.jobId() + ".");
+        return job;
+    }
+
+    public RepairJob finishJob(String jobId) {
+        RepairJob job = repairJobRepository.findById(jobId);
+        if (job == null) {
+            throw new IllegalArgumentException("No repair job " + jobId);
+        }
+        if (!job.isOpen()) {
+            throw new IllegalStateException("Repair job " + jobId + " is already finished");
+        }
+
+        RepairJob finishedJob = job.finishOn(LocalDate.now(clock));
+        repairJobRepository.save(finishedJob);
+        return finishedJob;
+    }
+}
