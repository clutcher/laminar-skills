+package com.example.workshop.repair;
+
+import java.time.LocalDate;
+
+public record RepairJob(String jobId, String customerId, String bikeDescription, RepairStatus status, LocalDate openedOn, LocalDate finishedOn) {
+
+    public RepairJob finishOn(LocalDate day) {
+        return new RepairJob(jobId, customerId, bikeDescription, RepairStatus.FINISHED, openedOn, day);
+    }
+
+    public boolean isOpen() {
+        return status == RepairStatus.OPEN;
+    }
+}
