@@ -0,0 +1,13 @@
+package com.example.climbinggym.courses
+
+import com.example.climbinggym.climber.Climber
+
+class LeadCourseBooking(private val course: LeadCourse) {
+
+    fun book(climber: Climber) {
+        if (climber.isBeginner) {
+            throw IllegalStateException("${climber.name} cannot join a lead course yet")
+        }
+        course.add(climber)
+    }
+}
