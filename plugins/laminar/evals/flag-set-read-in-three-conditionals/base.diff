+package com.example.climbinggym.courses
+
+import com.example.climbinggym.climber.Climber
+
+class LeadCourse(val title: String) {
+
+    private val climbers = mutableListOf<Climber>()
+
+    fun add(climber: Climber) {
+        climbers.add(climber)
+    }
+}
