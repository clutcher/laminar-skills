+package com.example.climbinggym.routes
+
+import com.example.climbinggym.climber.Climber
+
+class RouteAdvisor {
+
+    fun highestSuggestedGrade(climber: Climber): Int {
+        if (climber.isAdvanced) {
+            return 7
+        }
+        return 4
+    }
+}
