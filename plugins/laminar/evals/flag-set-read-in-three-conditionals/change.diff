+package com.example.climbinggym.safety
+
+import com.example.climbinggym.climber.Climber
+
+class BelaySupervision {
+
+    fun supervisorsNeeded(climbers: List<Climber>): Int {
+        var needed = 0
+        for (climber in climbers) {
+            if (climber.isBeginner && !climber.isAdvanced) {
+                needed++
+            }
+        }
+        return needed
+    }
+}
